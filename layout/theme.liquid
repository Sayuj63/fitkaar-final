    </style>

    <script>
      (function() {
        var overlay = document.getElementById('fkPopupOverlay');
        var content = document.getElementById('fkPopupContent');
        if (!overlay || !content) return;

        var STATE_KEYS = {
          welcome:    'fk_pop_welcome_seen_v1',
          formLeave:  'fk_pop_formLeave_seen_v1',
          shopLeave:  'fk_pop_shopLeave_seen_v1',
          cartLeave:  'fk_pop_cartLeave_seen_v1'
        };
        function once(key) {
          try {
            if (sessionStorage.getItem(key)) return false;
            sessionStorage.setItem(key, '1');
            return true;
          } catch (e) { return true; }
        }
        function show(html) {
          content.innerHTML = html;
          overlay.hidden = false;
          requestAnimationFrame(function() { overlay.classList.add('is-visible'); });
        }
        function hide() {
          overlay.classList.remove('is-visible');
          setTimeout(function() { overlay.hidden = true; }, 240);
        }
        window.__fkClosePopup = hide;
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) hide();
        });
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !overlay.hidden) hide();
        });

        // Popup #1 — welcome 10% off, fires once per session ~3s after first page view
        function popupWelcome() {
          if (!once(STATE_KEYS.welcome)) return;
          show(
            '<h3>Ever loved something so much that you wanted to wear it?</h3>' +
            '<p>That\'s exactly what we do.</p>' +
            '<div class="fk-popup-discount-box">' +
              '<span class="fk-popup-discount-big">FLAT 10% OFF</span>' +
              '<span class="fk-popup-discount-sub">on your first order</span>' +
            '</div>' +
            '<div class="fk-popup-actions">' +
              '<button class="fk-popup-cta" onclick="window.__fkClosePopup()">Shop Now</button>' +
            '</div>'
          );
        }

        // Popup #2 — fires when user begins customising and tries to leave (exit intent on /pages/process)
        function popupFormLeave() {
          if (!once(STATE_KEYS.formLeave)) return;
          show(
            '<h3>Stuck midway?<br>Happens to the best of us.</h3>' +
            '<p>Take a look at what else we\'ve got.</p>' +
            '<div class="fk-popup-actions">' +
              '<a class="fk-popup-cta" href="/collections/all">Shop Now</a>' +
            '</div>'
          );
        }

        // Popup #3 — fires when leaving shop page (/collections/*)
        function popupShopLeave() {
          if (!once(STATE_KEYS.shopLeave)) return;
          show(
            '<h3>Didn\'t find what you are looking for?</h3>' +
            '<p>We can design something<br>just for you at no extra cost.</p>' +
            '<div class="fk-popup-actions">' +
              '<a class="fk-popup-cta" href="/pages/process">Customise Here</a>' +
            '</div>'
          );
        }

        // Popup #4 — fires when cart has items and user attempts to leave the tab
        function popupCartAbandon() {
          if (!once(STATE_KEYS.cartLeave)) return;
          show(
            '<span class="small-line">pleaseeeee</span>' +
            '<h3>Don\'t abandon me</h3>' +
            '<img class="fk-popup-mascot" src="{{ "cart pop up.png" | asset_url }}" alt="Don\'t abandon me">' +
            '<p>take me home with you :(</p>' +
            '<div class="fk-popup-actions">' +
              '<a class="fk-popup-cta" href="/checkout">Checkout</a>' +
              '<button class="fk-popup-cta-secondary" onclick="window.__fkClosePopup()">Abandon</button>' +
            '</div>'
          );
        }

        // ==== Triggers ====
        var path = window.location.pathname;

        // 1) Welcome popup — 4s after first load on the homepage (only first session)
        if (path === '/' || path === '/index') {
          setTimeout(popupWelcome, 4000);
        }

        // 2) Form-leave on customise page
        if (/\/pages\/process|customise/.test(path)) {
          var formStarted = false;
          document.addEventListener('input', function(e) {
            if (e.target.closest('.process-form-container')) formStarted = true;
          }, { once: false });
          // Exit intent: cursor leaves through the top
          document.addEventListener('mouseout', function(e) {
            if (formStarted && (!e.relatedTarget && e.clientY <= 0)) popupFormLeave();
          });
        }

        // 3) Shop-leave on collection pages
        if (/\/collections\//.test(path)) {
          document.addEventListener('mouseout', function(e) {
            if (!e.relatedTarget && e.clientY <= 0) popupShopLeave();
          });
        }

        // 4) Cart-abandon — fires globally if cart has items
        var cartCount = {{ cart.item_count | default: 0 }};
        if (cartCount > 0) {
          document.addEventListener('mouseout', function(e) {
            if (!e.relatedTarget && e.clientY <= 0) popupCartAbandon();
          });
        }
      })();
    </script>

