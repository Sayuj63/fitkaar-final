    <!-- #33: 4 site-wide popups -->
    <div class="fk-popup-overlay" id="fkPopupOverlay" hidden>
      <div class="fk-popup">
        <button type="button" class="fk-popup-close" aria-label="Close" onclick="window.__fkClosePopup && window.__fkClosePopup()">×</button>
        <div class="fk-popup-content" id="fkPopupContent"></div>
      </div>
    </div>

    <style>
      .fk-popup-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 12, 91, 0.55);
        backdrop-filter: blur(2px);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        opacity: 0;
        transition: opacity 0.25s ease;
      }
      .fk-popup-overlay[hidden] { display: none; }
      .fk-popup-overlay.is-visible { opacity: 1; }
      .fk-popup {
        position: relative;
        background: var(--color-primary, #000c5b);
        color: #fff;
        border-radius: 18px;
        padding: 28px 24px 26px;
        max-width: 380px;
        width: 100%;
        text-align: center;
        font-family: var(--font-heading, 'League Spartan', sans-serif);
        box-shadow: 0 30px 60px rgba(0, 12, 91, 0.45);
        transform: scale(0.92);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .fk-popup-overlay.is-visible .fk-popup { transform: scale(1); }
      .fk-popup-close {
        position: absolute;
        top: 8px;
        right: 12px;
        background: none;
        border: none;
        color: #fff;
        font-size: 28px;
        cursor: pointer;
        line-height: 1;
        opacity: 0.7;
      }
      .fk-popup-close:hover { opacity: 1; }
      .fk-popup h3 {
        font-size: 24px;
        font-weight: 900;
        margin: 0 0 8px;
        letter-spacing: 0.02em;
        line-height: 1.15;
      }
      .fk-popup p {
        font-family: var(--font-body, 'Helvetica Neue', sans-serif);
        font-size: 14px;
        color: #bfdbe3;
        margin: 0 0 18px;
        line-height: 1.55;
      }
      .fk-popup .small-line {
        font-size: 13px;
        font-style: italic;
        color: #bfdbe3;
        margin-bottom: 14px;
      }
      .fk-popup .fk-popup-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .fk-popup .fk-popup-cta,
      .fk-popup .fk-popup-cta-secondary {
        padding: 10px 22px;
        border-radius: 30px;
        font-family: var(--font-heading, 'League Spartan', sans-serif);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        cursor: pointer;
        text-decoration: none;
        transition: transform 0.15s ease, background 0.2s ease;
        border: none;
        display: inline-block;
      }
      .fk-popup .fk-popup-cta {
        background: #fff;
        color: var(--color-primary, #000c5b);
      }
      .fk-popup .fk-popup-cta:hover { transform: translateY(-2px); }
      .fk-popup .fk-popup-cta-secondary {
        background: transparent;
        color: #bfdbe3;
        border: 1px solid #71b6c8;
      }
      .fk-popup .fk-popup-cta-secondary:hover { background: rgba(255,255,255,0.08); }
      .fk-popup .fk-popup-emoji {
        font-size: 56px;
        line-height: 1;
        display: block;
        margin: 4px 0 12px;
      }
      .fk-popup .fk-popup-mascot {
        display: block;
        width: 130px;
        height: auto;
        margin: 0 auto 14px;
        filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.25));
      }
      .fk-popup .fk-popup-discount {
        font-size: 36px;
        font-weight: 900;
        color: #71b6c8;
        margin: 4px 0 6px;
        letter-spacing: 0.02em;
      }
    </style>

    <script>
      (function() {
        var overlay = document.getElementById('fkPopupOverlay');
        var content = document.getElementById('fkPopupContent');
        if (!overlay || !content) return;

        var STATE_KEYS = {
          welcome:    'fk_pop_welcome_seen_v1',
          formLeave:  'fk_pop_formLeave_seen_v1',
          shopLeave:  'fk_pop_shopLeave_seen_v1',
          cartLeave:  'fk_pop_cartLeave_seen_v1'
        };
        function once(key) {
          try {
            if (sessionStorage.getItem(key)) return false;
            sessionStorage.setItem(key, '1');
            return true;
          } catch (e) { return true; }
        }
        function show(html) {
          content.innerHTML = html;
          overlay.hidden = false;
          requestAnimationFrame(function() { overlay.classList.add('is-visible'); });
        }
        function hide() {
          overlay.classList.remove('is-visible');
          setTimeout(function() { overlay.hidden = true; }, 240);
        }
        window.__fkClosePopup = hide;
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) hide();
        });
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !overlay.hidden) hide();
        });

        // Popup #1 — welcome 10% off, fires once per session ~3s after first page view
        function popupWelcome() {
          if (!once(STATE_KEYS.welcome)) return;
          show(
            '<span class="fk-popup-emoji">🎁</span>' +
            '<h3>EVER LOVED SOMETHING SO MUCH YOU WANTED TO WEAR IT?</h3>' +
            '<p>That\'s exactly what we do.</p>' +
            '<div class="fk-popup-discount">FLAT 10% OFF</div>' +
            '<p>on your first order!</p>' +
            '<div class="fk-popup-actions">' +
              '<button class="fk-popup-cta" onclick="window.__fkClosePopup()">Shop now</button>' +
            '</div>'
          );
        }

        // Popup #2 — fires when user begins customising and tries to leave (exit intent on /pages/process)
        function popupFormLeave() {
          if (!once(STATE_KEYS.formLeave)) return;
          show(
            '<h3>STUCK MIDWAY?</h3>' +
            '<p>Happens to the best of us.<br>Take a look at what else we\'ve got.</p>' +
            '<div class="fk-popup-actions">' +
              '<a class="fk-popup-cta" href="/collections/all">Explore other options</a>' +
              '<button class="fk-popup-cta-secondary" onclick="window.__fkClosePopup()">Stay here</button>' +
            '</div>'
          );
        }

        // Popup #3 — fires when leaving shop page (/collections/*)
        function popupShopLeave() {
          if (!once(STATE_KEYS.shopLeave)) return;
          show(
            '<h3>DIDN\'T FIND WHAT YOU\'RE LOOKING FOR?</h3>' +
            '<p>We can design something just for you<br>at no extra cost.</p>' +
            '<div class="fk-popup-actions">' +
              '<a class="fk-popup-cta" href="/pages/process">Customise Now</a>' +
              '<button class="fk-popup-cta-secondary" onclick="window.__fkClosePopup()">Maybe later</button>' +
            '</div>'
          );
        }

        // Popup #4 — fires when cart has items and user attempts to leave the tab
        function popupCartAbandon() {
          if (!once(STATE_KEYS.cartLeave)) return;
          show(
            '<img class="fk-popup-mascot" src="{{ "cart pop up.png" | asset_url }}" alt="Don\'t abandon me">' +
            '<h3>pleaseeeeee<br>DON\'T ABANDON ME</h3>' +
            '<p class="small-line">take me home with you :(</p>' +
            '<div class="fk-popup-actions">' +
              '<a class="fk-popup-cta" href="/checkout">Checkout</a>' +
              '<button class="fk-popup-cta-secondary" onclick="window.__fkClosePopup()">Abandon</button>' +
            '</div>'
          );
        }

        // ==== Triggers ====
        var path = window.location.pathname;

        // 1) Welcome popup — 4s after first load on the homepage (only first session)
        if (path === '/' || path === '/index') {
          setTimeout(popupWelcome, 4000);
        }

        // 2) Form-leave on customise page
        if (/\/pages\/process|customise/.test(path)) {
          var formStarted = false;
          document.addEventListener('input', function(e) {
            if (e.target.closest('.process-form-container')) formStarted = true;
          }, { once: false });
          // Exit intent: cursor leaves through the top
          document.addEventListener('mouseout', function(e) {
            if (formStarted && (!e.relatedTarget && e.clientY <= 0)) popupFormLeave();
          });
        }

        // 3) Shop-leave on collection pages
        if (/\/collections\//.test(path)) {
          document.addEventListener('mouseout', function(e) {
            if (!e.relatedTarget && e.clientY <= 0) popupShopLeave();
          });
        }

        // 4) Cart-abandon — fires globally if cart has items
        var cartCount = {{ cart.item_count | default: 0 }};
        if (cartCount > 0) {
          document.addEventListener('mouseout', function(e) {
            if (!e.relatedTarget && e.clientY <= 0) popupCartAbandon();
          });
        }
      })();
    </script>

    <style>
      .fk-whatsapp-float {
        position: fixed;
        bottom: 22px;
        right: 22px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #25D366;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
      }
      .fk-whatsapp-float:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      }
      @media (max-width: 768px) {
        .fk-whatsapp-float { width: 50px; height: 50px; bottom: 16px; right: 16px; }
        .fk-whatsapp-float svg { width: 26px; height: 26px; }
      }
    </style>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      // Tab title blink when user switches away (#57) — references bonkerscorner pattern
      (function() {
        var originalTitle = document.title;
        var awayMessages = ['left too early!!', "🥺 we're here for you ;)"];
        var idx = 0;
        var blinkTimer = null;

        function startBlink() {
          if (blinkTimer) return;
          blinkTimer = setInterval(function() {
            document.title = awayMessages[idx % awayMessages.length];
            idx++;
          }, 1200);
        }
        function stopBlink() {
          if (blinkTimer) { clearInterval(blinkTimer); blinkTimer = null; }
          document.title = originalTitle;
          idx = 0;
        }
        document.addEventListener('visibilitychange', function() {
          if (document.hidden) startBlink();
          else stopBlink();
        });
      })();
    </script>
  </body>
</html>
