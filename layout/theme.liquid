<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <!-- Google Fonts Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% endif %}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>

    <!-- Alpine.js for interactivity -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>

  <body class="gradient">
    <div style="position: sticky; top: 0; z-index: 100;">
      {% section 'announcement-bar' %}
      {% section 'header' %}
    </div>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <!-- #16: Search overlay — right drawer (mobile + desktop) -->
    <div class="fk-search-overlay" id="fkSearchOverlay">
      <!-- Scrim fades separately so it never makes the panel invisible during the slide -->
      <div class="fk-search-scrim" id="fkSearchScrim"></div>
      <div class="fk-search-panel" role="dialog" aria-modal="true" aria-label="Search">
        <div class="fk-search-panel__scroll">
          <div class="fk-search-top">
            <form action="/search" method="get" class="fk-search-form">
              <svg class="fk-search-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <input
                type="search"
                name="q"
                id="fkSearchInput"
                placeholder="Search for sweatshirts, hoodies, tees…"
                autocomplete="off"
                spellcheck="false"
                aria-autocomplete="list"
                aria-controls="fkSearchSuggestions"
              >
              <input type="hidden" name="type" value="product">
            </form>
            <button type="button" class="fk-search-close" aria-label="Close search" onclick="window.__fkCloseSearch && window.__fkCloseSearch()">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <!-- Google-style suggestion list: shown while typing -->
          <ul class="fk-search-suggestions" id="fkSearchSuggestions" role="listbox" aria-label="Suggestions"></ul>

          <div class="fk-search-section fk-search-section--static">
            <h4 class="fk-search-heading">Popular Searches</h4>
            <div class="fk-search-chips">
              <a href="/search?q=women&type=product" class="fk-search-chip">Women</a>
              <a href="/search?q=men&type=product" class="fk-search-chip">Men</a>
              <a href="/collections/all?sort_by=created-descending" class="fk-search-chip">New Arrivals</a>
              <a href="/collections/all?sort_by=price-descending" class="fk-search-chip">Premium</a>
              <a href="/collections/best-sellers" class="fk-search-chip">Bestsellers</a>
            </div>
          </div>

          <div class="fk-search-section">
            <h4 class="fk-search-heading" id="fkSearchResultsHeading">Top Products</h4>
            <div class="fk-search-results" id="fkSearchResults"></div>
            <div class="fk-search-see-all" id="fkSearchSeeAll" hidden>
              <a href="/search" class="fk-search-see-all__link" id="fkSearchSeeAllLink">See all results</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      /* ── Search overlay ─────────────────────────────────────────── */
      /* The overlay is a transparent full-screen container.
         NO opacity on it — opacity on parent makes children invisible
         during the slide, so the user only sees a fade, not a slide. */
      .fk-search-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9998;
        justify-content: flex-end;
        align-items: stretch;
        pointer-events: none;
      }
      .fk-search-overlay.is-active {
        display: flex;
      }
      .fk-search-overlay.is-visible {
        pointer-events: auto;
      }
      html.fk-search-open,
      html.fk-search-open body {
        overflow: hidden;
        touch-action: none;
      }

      /* Scrim: fades independently, position:absolute so it's out of flex flow */
      .fk-search-scrim {
        position: absolute;
        inset: 0;
        background: rgba(0, 12, 91, 0.45);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        opacity: 0;
        transition: opacity 0.35s ease;
        pointer-events: none;
      }
      .fk-search-overlay.is-visible .fk-search-scrim {
        opacity: 1;
      }

      /* Panel: only transform transition, always opacity:1 — fully visible
         during the entire slide so the user sees it come in from the right */
      .fk-search-panel {
        position: relative;
        z-index: 1;
        /* Mobile: 90vw so the 10% scrim on the left is tappable to close */
        width: min(90vw, 440px);
        height: 100%;
        max-height: 100dvh;
        background: #fff;
        box-shadow: -16px 0 48px rgba(0, 12, 91, 0.22);
        transform: translateX(100%);
        transition: transform 0.44s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        will-change: transform;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .fk-search-overlay.is-visible .fk-search-panel {
        transform: translateX(0);
      }
      @media (min-width: 900px) {
        .fk-search-panel { width: min(520px, 42vw); }
      }
      .fk-search-panel__scroll {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding: 18px 18px 28px;
      }
      .fk-search-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e5e7eb;
      }
      .fk-search-form {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #fafafa;
        min-width: 0;
      }
      .fk-search-icon { color: #6b7280; flex-shrink: 0; }
      #fkSearchInput {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 1rem;
        color: #111;
        padding: 8px 4px;
        font-family: inherit;
        min-width: 0;
      }
      .fk-search-close {
        flex-shrink: 0;
        background: none;
        border: none;
        cursor: pointer;
        color: #4b5563;
        padding: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .fk-search-close:hover { color: #000; }
      .fk-search-section { margin-top: 22px; }
      .fk-search-heading {
        font-family: var(--font-heading, 'League Spartan', sans-serif);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #6b7280;
        margin: 0 0 12px;
      }
      .fk-search-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .fk-search-chip {
        padding: 8px 14px;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 999px;
        text-decoration: none;
        color: #111;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .fk-search-chip:hover {
        background: var(--color-primary, #000c5b);
        border-color: var(--color-primary, #000c5b);
        color: #fff;
      }
      .fk-search-results {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 10px;
      }
      @media (min-width: 900px) {
        .fk-search-results {
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px 12px;
        }
      }
      .fk-search-card {
        display: block;
        text-decoration: none;
        color: inherit;
        border-radius: 8px;
        transition: opacity 0.2s;
      }
      .fk-search-card:hover { opacity: 0.92; }
      .fk-search-card__media {
        position: relative;
        aspect-ratio: 3 / 4;
        background: #f3f4f6;
        border-radius: 8px;
        overflow: hidden;
      }
      .fk-search-card__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .fk-search-card__badge {
        position: absolute;
        top: 8px;
        left: 8px;
        background: #dc2626;
        color: #fff;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        padding: 4px 8px;
        border-radius: 2px;
        line-height: 1;
      }
      .fk-search-card__body {
        padding-top: 10px;
      }
      .fk-search-card__title {
        font-family: var(--font-heading, 'League Spartan', sans-serif);
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        line-height: 1.35;
        margin: 0 0 6px;
        color: #111;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .fk-search-card__prices {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 6px;
        font-size: 0.72rem;
      }
      .fk-search-card__compare {
        color: #9ca3af;
        text-decoration: line-through;
        font-weight: 500;
      }
      .fk-search-card__price {
        font-weight: 800;
        color: #111;
      }
      .fk-search-card__price--sale { color: #dc2626; }
      .fk-search-see-all {
        margin-top: 18px;
        text-align: center;
      }
      .fk-search-see-all__link {
        display: inline-block;
        font-family: var(--font-heading, 'League Spartan', sans-serif);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-primary, #000c5b);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .fk-search-see-all__link:hover { color: var(--color-secondary, #71b6c8); }
      .fk-search-empty {
        padding: 16px 0;
        font-size: 0.85rem;
        color: #6b7280;
        text-align: center;
        grid-column: 1 / -1;
      }

      /* ── Suggestions dropdown ─────────────────────────── */
      .fk-search-suggestions {
        list-style: none;
        margin: 6px 0 0;
        padding: 0;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
        display: none;
        box-shadow: 0 4px 16px rgba(0,12,91,0.08);
      }
      .fk-search-suggestions:not(:empty) { display: block; }
      .fk-sugg-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 14px;
        cursor: pointer;
        font-size: 0.88rem;
        color: #111;
        font-family: inherit;
        transition: background 0.12s;
        border: none;
        border-bottom: 1px solid #f3f4f6;
        background: #fff;
        width: 100%;
        text-align: left;
        text-decoration: none;
      }
      .fk-sugg-item:last-child { border-bottom: none; }
      .fk-sugg-item:hover,
      .fk-sugg-item.is-active { background: #f0f3ff; outline: none; }
      .fk-sugg-item__icon { color: #9ca3af; flex-shrink: 0; }
      .fk-sugg-item__text { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .fk-sugg-item mark {
        background: none;
        color: var(--color-primary, #000c5b);
        font-weight: 700;
      }
      .fk-sugg-item__arrow { color: #d1d5db; flex-shrink: 0; }

      /* Hide popular chips + section headings while typing */
      .fk-search-panel.is-typing .fk-search-section--static { display: none; }

      @media (max-width: 599px) {
        .fk-search-panel__scroll { padding: 14px 14px 24px; }
        #fkSearchInput { font-size: 0.95rem; }
      }
    </style>

    {%- comment -%} Pre-render top products via Liquid so search panel has instant data {%- endcomment -%}
    {%- assign _top_col = collections['best-sellers'] -%}
    {%- if _top_col == blank or _top_col.products_count == 0 -%}
      {%- assign _top_col = collections.all -%}
    {%- endif -%}
    <script type="application/json" id="fkTopProductsData">[
      {%- for _p in _top_col.products limit: 8 -%}
      {"title":{{ _p.title | json }},"url":{{ _p.url | json }},"handle":{{ _p.handle | json }},"featured_image":{{ _p.featured_image | image_url: width: 400 | json }},"price_min":{{ _p.price_min | plus: 0 }},"compare_at_price_min":{{ _p.compare_at_price_min | plus: 0 }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]</script>

    <script>
      (function() {
        var overlay    = document.getElementById('fkSearchOverlay');
        var panel      = overlay && overlay.querySelector('.fk-search-panel');
        var input      = document.getElementById('fkSearchInput');
        var suggestEl  = document.getElementById('fkSearchSuggestions');
        var resultsEl  = document.getElementById('fkSearchResults');
        var headingEl  = document.getElementById('fkSearchResultsHeading');
        var seeAllEl   = document.getElementById('fkSearchSeeAll');
        var seeAllLink = document.getElementById('fkSearchSeeAllLink');
        if (!overlay || !input || !resultsEl) return;

        var debounceTimer;
        var activeIdx = -1;
        var lastQuery = '';
        var TOP_PRODUCTS_FALLBACK = [];
        var topLoaded = false;

        /* Boot from Liquid-pre-rendered data — zero AJAX, always works */
        try {
          var _tpEl = document.getElementById('fkTopProductsData');
          if (_tpEl) {
            var _tp = JSON.parse(_tpEl.textContent);
            if (_tp && _tp.length) { TOP_PRODUCTS_FALLBACK = _tp; topLoaded = true; }
          }
        } catch(e) {}

        /* ── Helpers ──────────────────────────────────────── */
        function esc(s) {
          return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
        function escAttr(s) { return esc(s).replace(/'/g, '&#39;'); }

        /* Highlight the query portion in a title (case-insensitive) */
        function highlight(title, q) {
          if (!q) return esc(title);
          var re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
          return esc(title).replace(re, '<mark>$1</mark>');
        }

        function variant0(p) { return p.variants && p.variants[0] ? p.variants[0] : null; }

        function moneyDisplay(p) {
          var cur = p.price;
          if (cur != null && typeof cur === 'string' && /₹|Rs\.|INR/i.test(cur)) return cur;
          var n = p.price_min != null ? p.price_min : p.price_max;
          if (typeof n === 'number' && n > 0) {
            var r = n >= 1000 ? n / 100 : n;
            return '₹' + (Math.abs(r - Math.round(r)) < 0.01 ? Math.round(r) : r.toFixed(2));
          }
          var v = variant0(p);
          if (v && v.price != null && v.price !== '') {
            var pr = parseFloat(String(v.price).replace(/,/g, ''));
            if (!isNaN(pr)) return '₹' + (Number.isInteger(pr) ? pr : pr.toFixed(2));
          }
          return '';
        }
        function compareDisplay(p) {
          var c = p.compare_at_price_min != null ? p.compare_at_price_min : p.compare_at_price_max;
          if (c == null && p.compare_at_price != null) c = p.compare_at_price;
          if (typeof c === 'string' && c !== '') return c;
          if (typeof c === 'number' && c > 0) {
            var r = c >= 1000 ? c / 100 : c;
            return '₹' + (Math.abs(r - Math.round(r)) < 0.01 ? Math.round(r) : r.toFixed(2));
          }
          var v = variant0(p);
          if (v && v.compare_at_price != null && v.compare_at_price !== '') {
            var cp = parseFloat(String(v.compare_at_price).replace(/,/g, ''));
            if (!isNaN(cp)) return '₹' + (Number.isInteger(cp) ? cp : cp.toFixed(2));
          }
          return '';
        }
        function salePercent(p) {
          var cmp = parseFloat(String(compareDisplay(p)).replace(/[^\d.]/g, ''));
          var pr  = parseFloat(String(moneyDisplay(p)).replace(/[^\d.]/g, ''));
          if (!cmp || !pr || cmp <= pr) return null;
          return Math.round((1 - pr / cmp) * 100);
        }
        function imgUrl(p) {
          var fi = p.featured_image;
          if (fi && typeof fi === 'object' && fi.url) return fi.url;
          if (typeof fi === 'string') return fi;
          if (fi && fi.src) return fi.src;
          return p.image || '';
        }

        /* ── Suggestions ──────────────────────────────────── */
        var SEARCH_SVG = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        var ARROW_SVG  = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"/></svg>';

        function renderSuggestions(products, q) {
          if (!suggestEl) return;
          if (!products || products.length === 0 || !q) {
            suggestEl.innerHTML = '';
            return;
          }
          activeIdx = -1;
          suggestEl.innerHTML = products.slice(0, 6).map(function(p, i) {
            var title = p.title || '';
            var url   = p.url || ('/products/' + (p.handle || ''));
            return '<li role="option" aria-selected="false">' +
              '<a class="fk-sugg-item" href="' + escAttr(url) + '" data-idx="' + i + '">' +
                '<span class="fk-sugg-item__icon">' + SEARCH_SVG + '</span>' +
                '<span class="fk-sugg-item__text">' + highlight(title, q) + '</span>' +
                '<span class="fk-sugg-item__arrow">' + ARROW_SVG + '</span>' +
              '</a>' +
            '</li>';
          }).join('');
        }

        function clearSuggestions() {
          if (suggestEl) suggestEl.innerHTML = '';
          activeIdx = -1;
        }

        /* Keyboard nav through suggestions */
        function moveSuggestion(dir) {
          if (!suggestEl) return;
          var items = suggestEl.querySelectorAll('.fk-sugg-item');
          if (!items.length) return;
          items[activeIdx] && items[activeIdx].classList.remove('is-active');
          activeIdx = (activeIdx + dir + items.length + 1) % (items.length + 1) - 1;
          if (activeIdx < 0) { input.focus(); return; }
          if (activeIdx >= items.length) activeIdx = 0;
          items[activeIdx].classList.add('is-active');
          items[activeIdx].focus();
        }

        /* ── Product cards ────────────────────────────────── */
        function setSeeAll(q) {
          if (!seeAllEl || !seeAllLink) return;
          seeAllEl.hidden = !q;
          if (q) seeAllLink.href = '/search?q=' + encodeURIComponent(q) + '&type=product';
        }

        function renderCards(products, q) {
          setSeeAll(q || '');
          if (!products || products.length === 0) {
            resultsEl.innerHTML = q
              ? '<div class="fk-search-empty">No products found for "' + esc(q) + '". <a href="/search?q=' + encodeURIComponent(q) + '&type=product" style="color:var(--color-primary);text-decoration:underline;">See full results →</a></div>'
              : '<div class="fk-search-empty">No products found.</div>';
            return;
          }
          resultsEl.innerHTML = products.map(function(p) {
            var title = p.title || '';
            var url = p.url || ('/products/' + (p.handle || ''));
            var img = imgUrl(p);
            var priceStr = moneyDisplay(p);
            var compareStr = compareDisplay(p);
            var sale = salePercent(p);
            var showCmp = compareStr && priceStr && compareStr !== priceStr;
            var pct = sale != null && sale > 0 ? sale : null;
            return '<a href="' + escAttr(url) + '" class="fk-search-card">' +
              '<div class="fk-search-card__media">' +
                (pct ? '<span class="fk-search-card__badge">SAVE ' + pct + '%</span>' : '') +
                (img ? '<img src="' + escAttr(img) + '" alt="' + escAttr(title) + '" loading="lazy">' : '') +
              '</div>' +
              '<div class="fk-search-card__body">' +
                '<div class="fk-search-card__title">' + esc(title) + '</div>' +
                '<div class="fk-search-card__prices">' +
                  (showCmp ? '<span class="fk-search-card__compare">' + esc(compareStr) + '</span>' : '') +
                  '<span class="fk-search-card__price' + (showCmp ? ' fk-search-card__price--sale' : '') + '">' + esc(priceStr) + '</span>' +
                '</div>' +
              '</div>' +
            '</a>';
          }).join('');
        }

        /* ── Open / close ─────────────────────────────────── */
        function open() {
          document.documentElement.classList.add('fk-search-open');
          overlay.classList.add('is-active');
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              overlay.classList.add('is-visible');
              input.focus();
            });
          });
          loadTopProducts();
        }
        function close() {
          overlay.classList.remove('is-visible');
          document.documentElement.classList.remove('fk-search-open');
          setTimeout(function() { overlay.classList.remove('is-active'); }, 440);
        }
        window.__fkOpenSearch  = open;
        window.__fkCloseSearch = close;

        overlay.addEventListener('click', function(e) {
          if (!e.target.closest('.fk-search-panel')) close();
        });
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && overlay.classList.contains('is-active')) {
            if (suggestEl && suggestEl.children.length) { clearSuggestions(); input.focus(); }
            else close();
          }
          if (!overlay.classList.contains('is-active')) return;
          if (e.key === 'ArrowDown') { e.preventDefault(); moveSuggestion(1); }
          if (e.key === 'ArrowUp')   { e.preventDefault(); moveSuggestion(-1); }
        });

        /* ── Collection name → handle map ─────────────────── */
        var COLLECTION_MAP = {
          'women': 'women', 'woman': 'women', "women's": 'women',
          'men': 'men', 'man': 'men', "men's": 'men', 'unisex': 'unisex',
          'bestseller': 'best-sellers', 'bestsellers': 'best-sellers', 'best seller': 'best-sellers', 'best sellers': 'best-sellers',
          'new arrivals': 'new-arrivals', 'new arrival': 'new-arrivals', 'new': 'new-arrivals',
          'premium': 'premium',
          'hoodie': 'hoodies', 'hoodies': 'hoodies', 'sweatshirt': 'hoodies', 'sweatshirts': 'hoodies',
          'tee': 'tees', 'tees': 'tees', 't-shirt': 'tees', 't-shirts': 'tees', 'tshirt': 'tees', 'tshirts': 'tees',
          'crop': 'crop-tops', 'cropped': 'crop-tops', 'crop top': 'crop-tops', 'crop tops': 'crop-tops',
          'all': 'all'
        };

        function collectionHandleFor(q) {
          return COLLECTION_MAP[q.toLowerCase().trim()] || null;
        }

        /* ── Top products (default state) ─────────────────── */
        function loadTopProducts() {
          if (topLoaded) {
            if (!input.value.trim()) { headingEl.textContent = 'Top Products'; renderCards(TOP_PRODUCTS_FALLBACK, ''); }
            return;
          }
          /* AJAX fallback — only reached if Liquid pre-render produced no data */
          fetch('/collections/all/products.json?limit=8')
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(d) {
              if (!d) return;
              var prods = d.products || [];
              if (prods.length) {
                TOP_PRODUCTS_FALLBACK = prods;
                topLoaded = true;
                if (!input.value.trim()) { headingEl.textContent = 'Top Products'; renderCards(TOP_PRODUCTS_FALLBACK, ''); }
              }
            }).catch(function() {});
        }

        /* ── Collection search ─────────────────────────────── */
        function searchCollection(handle, q) {
          fetch('/collections/' + handle + '/products.json?limit=12')
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(d) {
              if (!d) return;
              var products = d.products || [];
              clearSuggestions();
              headingEl.textContent = products.length
                ? products.length + ' product' + (products.length > 1 ? 's' : '') + ' in "' + q + '"'
                : 'No products found in "' + q + '"';
              renderCards(products, q);
            }).catch(function() {});
        }

        /* ── Predictive search ────────────────────────────── */
        function predictiveSearch(q) {
          /* If query exactly matches a collection name, fetch that collection */
          var colHandle = collectionHandleFor(q);
          if (colHandle) {
            searchCollection(colHandle, q);
            return;
          }

          var url = '/search/suggest.json'
            + '?q=' + encodeURIComponent(q)
            + '&resources[type]=product,collection'
            + '&resources[limit]=12'
            + '&resources[options][fields]=title,product_type,variants.title,tag,vendor'
            + '&resources[options][unavailable_products]=last';

          fetch(url)
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(d) {
              if (!d) return;
              var results   = (d.resources && d.resources.results) || {};
              var products  = results.products || [];
              var collections = results.collections || [];

              /* If API returns no products but matched a collection, fetch it */
              if (!products.length && collections.length) {
                var col = collections[0];
                var handle = col.handle || (col.url || '').split('/collections/')[1];
                if (handle) { searchCollection(handle, q); return; }
              }

              renderSuggestions(products, q);
              headingEl.textContent = products.length
                ? products.length + ' result' + (products.length > 1 ? 's' : '') + ' for "' + q + '"'
                : 'No results for "' + q + '"';
              renderCards(products, q);
            })
            .catch(function() {});
        }

        /* ── Input handler ────────────────────────────────── */
        input.addEventListener('input', function() {
          var q = input.value.trim();
          clearTimeout(debounceTimer);
          if (panel) panel.classList.toggle('is-typing', q.length > 0);

          if (q.length === 0) {
            clearSuggestions();
            headingEl.textContent = 'Top Products';
            renderCards(TOP_PRODUCTS_FALLBACK, '');
            return;
          }

          lastQuery = q;
          /* 80ms feels instant; collection-name matches fire immediately */
          var delay = collectionHandleFor(q) ? 0 : 80;
          debounceTimer = setTimeout(function() { predictiveSearch(q); }, delay);
        });

        /* Keep input in sync when user clicks a suggestion link */
        suggestEl && suggestEl.addEventListener('click', function() {
          clearSuggestions();
        });
      })();
    </script>

