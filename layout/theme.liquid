<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <!-- Google Fonts Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>

    <!-- Alpine.js for interactivity -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>

  <body class="gradient">
    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <!-- #16: Search overlay -->
    <div class="fk-search-overlay" id="fkSearchOverlay" hidden>
      <div class="fk-search-panel">
        <button type="button" class="fk-search-close" aria-label="Close search" onclick="window.__fkCloseSearch && window.__fkCloseSearch()">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <form action="/search" method="get" class="fk-search-form">
          <svg class="fk-search-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <input
            type="search"
            name="q"
            id="fkSearchInput"
            placeholder="Search for sweatshirts, hoodies, tees…"
            autocomplete="off"
            spellcheck="false"
          >
          <input type="hidden" name="type" value="product">
        </form>

        <div class="fk-search-section">
          <h4 class="fk-search-heading">Popular Searches</h4>
          <div class="fk-search-chips">
            <a href="/search?q=women&type=product" class="fk-search-chip">Women</a>
            <a href="/search?q=men&type=product" class="fk-search-chip">Men</a>
            <a href="/collections/all?sort_by=created-descending" class="fk-search-chip">New Arrivals</a>
            <a href="/collections/all?sort_by=price-descending" class="fk-search-chip">Premium</a>
            <a href="/collections/best-sellers" class="fk-search-chip">Bestsellers</a>
          </div>
        </div>

        <div class="fk-search-section">
          <h4 class="fk-search-heading" id="fkSearchResultsHeading">Top Products</h4>
          <div class="fk-search-results" id="fkSearchResults"></div>
        </div>
      </div>
    </div>

    <style>
      .fk-search-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 12, 91, 0.55);
        backdrop-filter: blur(2px);
        z-index: 9998;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.22s ease;
        padding: 20px;
        overflow-y: auto;
      }
      .fk-search-overlay[hidden] { display: none; }
      .fk-search-overlay.is-visible { opacity: 1; }
      .fk-search-panel {
        position: relative;
        width: 100%;
        max-width: 720px;
        background: #fff;
        border-radius: 18px;
        padding: 22px 22px 26px;
        margin-top: 80px;
        box-shadow: 0 30px 60px rgba(0, 12, 91, 0.35);
        transform: translateY(-12px);
        transition: transform 0.25s ease;
      }
      .fk-search-overlay.is-visible .fk-search-panel { transform: translateY(0); }
      .fk-search-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background: none;
        border: none;
        cursor: pointer;
        color: #4b5563;
        padding: 4px;
      }
      .fk-search-close:hover { color: #000; }
      .fk-search-form {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        margin: 8px 0 22px;
        background: #fafafa;
      }
      .fk-search-icon { color: #6b7280; flex-shrink: 0; }
      #fkSearchInput {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 1rem;
        color: #111;
        padding: 8px 4px;
        font-family: inherit;
      }
      .fk-search-section { margin-top: 20px; }
      .fk-search-heading {
        font-family: var(--font-heading, 'League Spartan', sans-serif);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6b7280;
        margin: 0 0 12px;
      }
      .fk-search-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .fk-search-chip {
        padding: 8px 16px;
        background: #f3f4f6;
        border-radius: 999px;
        text-decoration: none;
        color: #1f2937;
        font-size: 0.82rem;
        font-weight: 600;
        transition: background 0.2s, color 0.2s;
      }
      .fk-search-chip:hover {
        background: var(--color-primary, #000c5b);
        color: #fff;
      }
      .fk-search-results {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }
      @media (min-width: 600px) {
        .fk-search-results { grid-template-columns: repeat(3, 1fr); gap: 14px; }
      }
      .fk-search-result {
        display: flex;
        gap: 10px;
        padding: 8px;
        border-radius: 10px;
        text-decoration: none;
        color: inherit;
        transition: background 0.2s;
        border: 1px solid #f3f4f6;
      }
      .fk-search-result:hover { background: #fafbff; border-color: #e0e7ff; }
      .fk-search-result__img {
        flex: 0 0 64px;
        width: 64px;
        height: 80px;
        background: #f5f5f5;
        border-radius: 6px;
        overflow: hidden;
      }
      .fk-search-result__img img { width: 100%; height: 100%; object-fit: cover; }
      .fk-search-result__info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
      }
      .fk-search-result__title {
        font-family: var(--font-heading, 'League Spartan', sans-serif);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        margin: 0 0 4px;
        color: #000;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .fk-search-result__price {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--color-primary, #000c5b);
      }
      .fk-search-empty {
        padding: 16px 0;
        font-size: 0.85rem;
        color: #6b7280;
        text-align: center;
      }

      @media (max-width: 600px) {
        .fk-search-panel { margin-top: 60px; padding: 18px 16px 20px; }
        #fkSearchInput { font-size: 0.95rem; }
        .fk-search-result__img { flex-basis: 56px; width: 56px; height: 70px; }
      }
    </style>

    <script>
      (function() {
        var overlay = document.getElementById('fkSearchOverlay');
        var input = document.getElementById('fkSearchInput');
        var resultsEl = document.getElementById('fkSearchResults');
        var headingEl = document.getElementById('fkSearchResultsHeading');
        if (!overlay || !input || !resultsEl) return;

        var debounceTimer;
        var TOP_PRODUCTS_FALLBACK = []; // populated by Shopify recommendations on first open

        function open() {
          overlay.hidden = false;
          requestAnimationFrame(function() {
            overlay.classList.add('is-visible');
            input.focus();
          });
          if (resultsEl.childElementCount === 0) loadTopProducts();
        }
        function close() {
          overlay.classList.remove('is-visible');
          setTimeout(function() { overlay.hidden = true; }, 220);
        }
        window.__fkOpenSearch = open;
        window.__fkCloseSearch = close;
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) close();
        });
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !overlay.hidden) close();
        });

        function renderResults(products, isPredictive) {
          if (!products || products.length === 0) {
            resultsEl.innerHTML = '<div class="fk-search-empty">No products found. Try a different search.</div>';
            return;
          }
          resultsEl.innerHTML = products.map(function(p) {
            var title = p.title || '';
            var url = p.url || ('/products/' + (p.handle || ''));
            var img = (p.featured_image && p.featured_image.url) || p.featured_image || p.image || '';
            var price = (typeof p.price === 'number') ? ('₹' + Math.round(p.price / 100) + '/-')
                       : (p.price_min ? '₹' + Math.round(p.price_min / 100) + '/-' : '');
            return '<a href="' + escapeAttr(url) + '" class="fk-search-result">' +
              (img ? '<div class="fk-search-result__img"><img src="' + escapeAttr(img) + '" alt="' + escapeAttr(title) + '"></div>'
                   : '<div class="fk-search-result__img"></div>') +
              '<div class="fk-search-result__info">' +
                '<div class="fk-search-result__title">' + escapeHtml(title) + '</div>' +
                (price ? '<div class="fk-search-result__price">' + price + '</div>' : '') +
              '</div>' +
            '</a>';
          }).join('');
        }

        function loadTopProducts() {
          // Use bestsellers collection as default top products
          fetch('/collections/best-sellers/products.json?limit=6')
            .then(function(r) { return r.ok ? r.json() : { products: [] }; })
            .then(function(d) {
              TOP_PRODUCTS_FALLBACK = d.products || [];
              if (input.value.length === 0) {
                headingEl.textContent = 'Top Products';
                renderResults(TOP_PRODUCTS_FALLBACK);
              }
            })
            .catch(function() {
              fetch('/collections/all/products.json?limit=6')
                .then(function(r) { return r.ok ? r.json() : { products: [] }; })
                .then(function(d) {
                  TOP_PRODUCTS_FALLBACK = d.products || [];
                  if (input.value.length === 0) renderResults(TOP_PRODUCTS_FALLBACK);
                })
                .catch(function() {});
            });
        }

        function predictiveSearch(q) {
          fetch('/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=6')
            .then(function(r) { return r.ok ? r.json() : { resources: { results: { products: [] } } }; })
            .then(function(d) {
              var products = (d && d.resources && d.resources.results && d.resources.results.products) || [];
              headingEl.textContent = 'Search results for "' + q + '"';
              renderResults(products, true);
            })
            .catch(function() {});
        }

        input.addEventListener('input', function() {
          var q = input.value.trim();
          clearTimeout(debounceTimer);
          if (q.length === 0) {
            headingEl.textContent = 'Top Products';
            renderResults(TOP_PRODUCTS_FALLBACK);
            return;
          }
          debounceTimer = setTimeout(function() { predictiveSearch(q); }, 250);
        });
      })();
    </script>

    <!-- WhatsApp floating button (#46) -->
