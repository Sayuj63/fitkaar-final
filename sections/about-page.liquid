<script>
document.addEventListener('DOMContentLoaded', () => {
  document.body.classList.add('about-page-active');

  const scrapbookLayout = document.querySelector('.scrapbook-layout');
  const leftCol = document.querySelector('.story-column-left');
  const rightCol = document.querySelector('.story-column-right');
  const centerImageWrapper = document.querySelector('.center-image-wrapper');
  const scrapbookSection = document.getElementById('scrapbook-section');

  // Mobile reordering: merge left/right story groups into chronological order
  let mobileFlow = null;
  let isMobileActive = false;

  function setupMobileLayout() {
    if (window.innerWidth <= 768 && !isMobileActive) {
      // Create mobile flow container if not exists
      if (!mobileFlow) {
        mobileFlow = document.createElement('div');
        mobileFlow.className = 'story-flow-mobile';
        // Collect all story groups from both columns
        const allGroups = [...document.querySelectorAll('.story-group')];
        // Sort by data-order
        allGroups.sort((a, b) => parseInt(a.dataset.order) - parseInt(b.dataset.order));
        // Move them into the mobile flow container
        allGroups.forEach(group => mobileFlow.appendChild(group));
        // Insert mobile flow as first child of layout (before center column)
        scrapbookLayout.insertBefore(mobileFlow, scrapbookLayout.firstChild);
      }
      scrapbookLayout.classList.add('mobile-active');
      isMobileActive = true;
      // Re-observe new elements
      reobserveElements();
    } else if (window.innerWidth > 768 && isMobileActive) {
      // Move story groups back to their original columns
      if (mobileFlow) {
        const groups = [...mobileFlow.querySelectorAll('.story-group')];
        groups.forEach(group => {
          const order = parseInt(group.dataset.order);
          if (order % 2 === 1) {
            leftCol.appendChild(group);
          } else {
            rightCol.appendChild(group);
          }
        });
      }
      scrapbookLayout.classList.remove('mobile-active');
      isMobileActive = false;
      reobserveElements();
    }
  }

  // Intersection Observer for card and photo animations
  const cardObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.15,
    rootMargin: "0px 0px -30px 0px"
  });

  function reobserveElements() {
    const cards = document.querySelectorAll('.scrapbook-card');
    const photos = document.querySelectorAll('.scrapbook-photo');
    cards.forEach(card => cardObserver.observe(card));
    photos.forEach(photo => cardObserver.observe(photo));
  }

  reobserveElements();

  // Parallax effect for center image
  window.addEventListener('scroll', () => {
    if (!scrapbookSection || !centerImageWrapper) return;

    const rect = scrapbookSection.getBoundingClientRect();
    const sectionTop = rect.top;
    const sectionHeight = rect.height;
    const viewportHeight = window.innerHeight;

    if (sectionTop < viewportHeight && rect.bottom > 0) {
      const scrollProgress = Math.abs(Math.min(sectionTop, 0)) / (sectionHeight - viewportHeight);
      const clampedProgress = Math.min(Math.max(scrollProgress, 0), 1);

      const scale = 1 - (clampedProgress * 0.2);
      const rotate = clampedProgress * 4;

      centerImageWrapper.style.transform = `scale(${scale}) rotate(${rotate}deg)`;
    }
  });

  // Setup on load and resize
  setupMobileLayout();
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(setupMobileLayout, 150);
  });
});
</script>

