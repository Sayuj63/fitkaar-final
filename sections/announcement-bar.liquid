{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "📦 FREE shipping on all orders! These are inclusive of designing & GST."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight Text",
      "default": "FREE shipping"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between repeats",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000c5b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}

<style>
.announcement-bar-gradient {
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
}

.announcement-marquee {
  overflow: hidden;
  position: relative;
  width: 100%;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 30px, #000 calc(100% - 30px), transparent 100%);
          mask-image: linear-gradient(90deg, transparent 0, #000 30px, #000 calc(100% - 30px), transparent 100%);
}

.announcement-track {
  display: flex;
  width: max-content;
  will-change: transform;
}

.announcement-item {
  display: inline-flex;
  align-items: center;
  gap: 2.5rem;
  padding-right: 2.5rem;
  font-size: 0.9rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  white-space: nowrap;
  line-height: 1.2;
}

.announcement-item .sep {
  opacity: 0.5;
  font-size: 0.8rem;
}

.announcement-item .highlight {
  font-weight: 800;
  color: #fff;
}

@media (max-width: 768px) {
  .announcement-item {
    gap: 1.75rem;
    padding-right: 1.75rem;
    font-size: 0.8rem;
  }
}
</style>

{%- assign text = section.settings.text -%}
{%- assign highlight = section.settings.highlight_text -%}
{%- assign separator = section.settings.separator | default: '•' -%}

{%- if text contains highlight and highlight != blank -%}
  {%- capture highlight_span -%}<span class="highlight">{{ highlight }}</span>{%- endcapture -%}
  {%- assign rendered_text = text | replace: highlight, highlight_span -%}
{%- else -%}
  {%- assign rendered_text = text -%}
{%- endif -%}

<div class="announcement-bar announcement-bar-gradient" style="padding: 8px 0;">
  <div class="announcement-marquee" id="announcement-marquee">
    <div class="announcement-track" id="announcement-track">
      {%- for i in (1..8) -%}
        <span class="announcement-item">
          {{ rendered_text }}
          <span class="sep" aria-hidden="true">{{ separator }}</span>
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function() {
  var track = document.getElementById('announcement-track');
  var marquee = document.getElementById('announcement-marquee');
  if (!track || !marquee) return;

  var speed = {{ section.settings.speed }}; // seconds to scroll half the track (4 copies)
  var half = 0;
  var pos = 0;
  var lastTs = null;
  var paused = false;

  function computeHalf() {
    half = track.scrollWidth / 2;
  }
  computeHalf();
  window.addEventListener('resize', computeHalf);

  /* Pause on hover (desktop) */
  marquee.addEventListener('mouseenter', function() { paused = true; });
  marquee.addEventListener('mouseleave', function() { paused = false; });

  /* Pause/resume on tab switch — prevents broken state on return */
  document.addEventListener('visibilitychange', function() {
    paused = document.hidden;
    if (!document.hidden) lastTs = null; /* Reset timestamp so no position jump */
  });

  function step(ts) {
    if (!paused) {
      if (lastTs !== null && half > 0) {
        pos += (half / (speed * 1000)) * (ts - lastTs);
        if (pos >= half) pos -= half;
        track.style.transform = 'translateX(-' + pos.toFixed(3) + 'px)';
      }
      lastTs = ts;
    }
    requestAnimationFrame(step);
  }

  requestAnimationFrame(step);
})();
</script>

