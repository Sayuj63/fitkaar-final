{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "📦 FREE shipping on all orders! These are inclusive of designing & GST."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight Text",
      "default": "FREE shipping"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between repeats",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000c5b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}

<style>
.announcement-bar-gradient {
  background: linear-gradient(90deg, {{ section.settings.bg_color }} 0%, #1a2980 50%, {{ section.settings.bg_color }} 100%);
  background-size: 200% 100%;
  animation: gradientShift 8s ease infinite;
  color: {{ section.settings.text_color }};
}

.announcement-marquee {
  overflow: hidden;
  position: relative;
  width: 100%;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
          mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
}

.announcement-track {
  display: flex;
  width: max-content;
  animation: announcementScroll {{ section.settings.speed }}s linear infinite;
  will-change: transform;
}

.announcement-track:hover {
  animation-play-state: paused;
}

.announcement-item {
  display: inline-flex;
  align-items: center;
  gap: 2.5rem;
  padding-right: 2.5rem;
  font-size: 0.9rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  white-space: nowrap;
  line-height: 1.2;
}

.announcement-item .sep {
  opacity: 0.6;
  font-size: 0.8rem;
}

.announcement-item .highlight {
  font-weight: 800;
  color: #fff;
  text-shadow:
    0 0 6px rgba(255, 255, 255, 0.55),
    0 0 14px rgba(113, 182, 200, 0.45);
  animation: highlightGlow 2.4s ease-in-out infinite;
}

@keyframes announcementScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

@keyframes gradientShift {
  0%, 100% { background-position: 0% 50%; }
  50%      { background-position: 100% 50%; }
}

@keyframes highlightGlow {
  0%, 100% {
    text-shadow:
      0 0 6px rgba(255, 255, 255, 0.45),
      0 0 14px rgba(113, 182, 200, 0.35);
  }
  50% {
    text-shadow:
      0 0 10px rgba(255, 255, 255, 0.85),
      0 0 22px rgba(113, 182, 200, 0.75);
  }
}

@media (max-width: 768px) {
  .announcement-item {
    gap: 1.75rem;
    padding-right: 1.75rem;
    font-size: 0.8rem;
  }
}
</style>

{%- assign text = section.settings.text -%}
{%- assign highlight = section.settings.highlight_text -%}
{%- assign separator = section.settings.separator | default: '•' -%}

{%- if text contains highlight and highlight != blank -%}
  {%- capture highlight_span -%}<span class="highlight">{{ highlight }}</span>{%- endcapture -%}
  {%- assign rendered_text = text | replace: highlight, highlight_span -%}
{%- else -%}
  {%- assign rendered_text = text -%}
{%- endif -%}

<div class="announcement-bar announcement-bar-gradient" style="position: relative; z-index: 50; padding: 8px 0;">
  <div class="announcement-marquee">
    <div class="announcement-track">
      {%- for i in (1..8) -%}
        <span class="announcement-item">
          {{ rendered_text }}
          <span class="sep" aria-hidden="true">{{ separator }}</span>
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>
