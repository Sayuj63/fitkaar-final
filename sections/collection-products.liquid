{% schema %}
{
  "name": "Collection Products",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner (#4)"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show collection hero banner",
      "info": "Upload an image in Shopify Admin: Products → Collections → open this collection → Image (sidebar). Mobile 1:1 fit; desktop wide banner.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hero_fallback_first_product",
      "label": "Hero: use first product image if collection has no image",
