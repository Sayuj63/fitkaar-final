      <a href="/pages/custom-orders" class="cp-help-btn">Custom Orders</a>
      <a href="/policies/shipping-policy" class="cp-help-btn">Shipping Policy</a>
      <a href="/policies/refund-policy" class="cp-help-btn">Returns & Refunds</a>
    </div>
  </div>

