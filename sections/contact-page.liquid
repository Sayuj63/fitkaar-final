{% schema %}
{
  "name": "Contact Page (Simple)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number (e.g. +919876543210)",
      "default": "+91 93544 78146"
    },
     {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "fitkaarclothing@gmail.com"
    },
    {
      "type": "textarea",
      "id": "customer_service_hours",
      "label": "Customer Service Hours",
      "default": "Monday - Friday: 10:00 AM - 6:00 PM\nSaturday: 10:00 AM - 2:00 PM"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "WhatsApp Link"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook Link"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube Link"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn Link"
    },
    {
      "type": "url",
      "id": "social_website",
      "label": "Website URL"
    },
    {
      "type": "url",
      "id": "social_blog",
      "label": "Blog URL"
    }
  ],
  "presets": [
    {
      "name": "Contact Page (Simple)"
    }
  ]
}
{% endschema %}

<style>
/* Clean & Simple Contact Page Styles */
.contact-page-simple {
  padding: 60px 20px;
  max-width: 1000px;
  margin: 0 auto;
  font-family: var(--font-body, "Helvetica Neue", Helvetica, Arial, sans-serif);
  color: #000;
  text-align: center;
}

.cp-header {
  margin-bottom: 50px;
}

.cp-title {
  font-family: var(--font-heading, sans-serif);
  font-size: 3rem;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--color-primary, #000c5b);
  margin-bottom: 10px;
}

.cp-subtitle {
  font-size: 1.1rem;
  color: #666;
  max-width: 600px;
  margin: 0 auto;
}

/* Flex Container for Main Info */
.cp-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 40px;
  text-align: left;
  margin-bottom: 60px;
}

.cp-card {
  background: #f9f9f9;
  padding: 40px;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  transition: transform 0.2s ease;
}

.cp-card:hover {
  transform: translateY(-5px);
}

.cp-icon-large {
  width: 48px;
  height: 48px;
  margin-bottom: 20px;
  color: var(--color-primary, #000c5b);
}

.cp-card-title {
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 5px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cp-link {
  font-size: 1.2rem;
  color: #000;
  text-decoration: none;
  font-weight: 500;
  border-bottom: 2px solid transparent;
  transition: border-color 0.2s;
}

.cp-link:hover {
  border-bottom-color: var(--color-primary, #000c5b);
}

.cp-hours-text {
  font-size: 1rem;
  color: #444;
  line-height: 1.6;
  white-space: pre-line;
}

/* Quick Help Section */
.cp-quick-help {
  margin-bottom: 60px;
}

.cp-section-title {
  font-size: 1.5rem;
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 30px;
  letter-spacing: 0.1em;
}

.cp-help-links {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.cp-help-btn {
  padding: 15px 30px;
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 50px;
  text-decoration: none;
  color: #000;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.9rem;
  transition: all 0.3s ease;
  min-width: 160px;
}

.cp-help-btn:hover {
  background: var(--color-primary, #000c5b);
  color: #fff;
  border-color: var(--color-primary, #000c5b);
}

/* Social Media Section */
.cp-social {
  margin-top: 80px;
  margin-bottom: 80px;
}

.cp-social-links {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin-top: 40px;
  flex-wrap: wrap;
  min-height: 50px;
}

.cp-social-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 50px;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  text-decoration: none;
}

.cp-social-icon:hover {
  transform: translateY(-4px);
}

.cp-social-icon svg {
  width: 24px;
  height: 24px;
  transition: all 0.3s ease;
}

.cp-social-icon svg.icon-stroke {
  fill: none;
  stroke: var(--color-secondary, #71b6c8);
  stroke-width: 1.5;
}

.cp-social-icon svg.icon-fill {
  fill: var(--color-secondary, #71b6c8);
}

.cp-social-icon:hover svg.icon-stroke {
  stroke: var(--color-primary, #000c5b);
  filter: drop-shadow(0 0 6px rgba(113, 182, 200, 0.5));
}

.cp-social-icon:hover svg.icon-fill {
  fill: var(--color-primary, #000c5b);
  filter: drop-shadow(0 0 6px rgba(113, 182, 200, 0.5));
}

/* Responsive */
@media (max-width: 768px) {
  .cp-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .cp-card {
    padding: 28px 18px;
  }

  .cp-hours-text {
    font-size: 0.95rem;
    white-space: pre;
  }

  .cp-help-links {
    flex-direction: column;
    align-items: center;
  }

  .cp-help-btn {
    width: 100%;
    max-width: 300px;
  }
}
</style>

<div class="contact-page-simple">
  
