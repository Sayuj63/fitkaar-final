      </svg>
      <div class="cp-card-title">Email Us</div>
      <a href="mailto:{{ section.settings.email_address }}" class="cp-link">
        {{ section.settings.email_address }}
      </a>
      <p style="font-size: 0.9rem; color: #666; margin-top: 5px;">For help &amp; support</p>
    </div>

    <!-- Customer Service Hours -->
    <div class="cp-card">
      <svg class="cp-icon-large" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <div class="cp-card-title">Service Hours</div>
      <div class="cp-hours-text">
        {{ section.settings.customer_service_hours | newline_to_br }}
      </div>
    </div>
    
    <!-- FAQ Highlight -->
    <div class="cp-card">
       <svg class="cp-icon-large" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
       </svg>
       <div class="cp-card-title">Got Questions?</div>
       <a href="/pages/faqs" class="cp-link">FAQs</a>
       <p style="font-size: 0.9rem; color: #666; margin-top: 5px;">Find answers instantly</p>
    </div>

  </div>

  <!-- Quick Help Links -->
  <div class="cp-quick-help">
    <h2 class="cp-section-title">Quick Help</h2>
    <div class="cp-help-links">
