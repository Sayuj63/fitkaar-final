{% schema %}
{
  "name": "Contact Page (Simple)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number (e.g. +919876543210)",
      "default": "+91 98765 43210"
    },
     {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "fitkaarclothing@gmail.com"
    },
    {
      "type": "textarea",
      "id": "customer_service_hours",
      "label": "Customer Service Hours",
      "default": "Monday - Friday: 10:00 AM - 6:00 PM\nSaturday: 10:00 AM - 2:00 PM"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook Link"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter/X Link"
    },
     {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube Link"
    }
  ],
  "presets": [
    {
      "name": "Contact Page (Simple)"
    }
  ]
}
{% endschema %}

<style>
/* Clean & Simple Contact Page Styles */
.contact-page-simple {
  padding: 60px 20px;
  max-width: 1000px;
  margin: 0 auto;
  font-family: var(--font-body, "Helvetica Neue", Helvetica, Arial, sans-serif);
  color: #000;
  text-align: center;
}

.cp-header {
  margin-bottom: 50px;
}

.cp-title {
  font-family: var(--font-heading, sans-serif);
  font-size: 3rem;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--color-primary, #000c5b);
  margin-bottom: 10px;
}

.cp-subtitle {
  font-size: 1.1rem;
  color: #666;
  max-width: 600px;
  margin: 0 auto;
}

/* Flex Container for Main Info */
.cp-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 40px;
  text-align: left;
  margin-bottom: 60px;
}

.cp-card {
  background: #f9f9f9;
  padding: 40px;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  transition: transform 0.2s ease;
}

.cp-card:hover {
  transform: translateY(-5px);
}

.cp-icon-large {
  width: 48px;
  height: 48px;
  margin-bottom: 20px;
  color: var(--color-primary, #000c5b);
}

.cp-card-title {
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 5px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cp-link {
  font-size: 1.2rem;
  color: #000;
  text-decoration: none;
  font-weight: 500;
  border-bottom: 2px solid transparent;
  transition: border-color 0.2s;
}

.cp-link:hover {
  border-bottom-color: var(--color-primary, #000c5b);
}

.cp-hours-text {
  font-size: 1rem;
  color: #444;
  line-height: 1.6;
  white-space: pre-line;
}

/* Quick Help Section */
.cp-quick-help {
  margin-bottom: 60px;
}

.cp-section-title {
  font-size: 1.5rem;
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 30px;
  letter-spacing: 0.1em;
}

.cp-help-links {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.cp-help-btn {
  padding: 15px 30px;
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 50px;
  text-decoration: none;
  color: #000;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.9rem;
  transition: all 0.3s ease;
  min-width: 160px;
}

.cp-help-btn:hover {
  background: var(--color-primary, #000c5b);
  color: #fff;
  border-color: var(--color-primary, #000c5b);
}

/* Social Media Section */
.cp-social {
  margin-top: 40px;
}

.cp-social-links {
  display: flex;
  justify-content: center;
  gap: 25px;
  margin-top: 20px;
}

.cp-social-icon {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f0f0;
  color: #000;
  transition: all 0.3s ease;
}

.cp-social-icon:hover {
  background: var(--color-primary, #000c5b);
  color: #fff;
  transform: scale(1.1);
}

.cp-social-icon svg {
  width: 24px;
  height: 24px;
  fill: currentColor;
}

/* Responsive */
@media (max-width: 768px) {
  .cp-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  
  .cp-help-links {
    flex-direction: column;
    align-items: center;
  }
  
  .cp-help-btn {
    width: 100%;
    max-width: 300px;
  }
}
</style>

<div class="contact-page-simple">
  
  <div class="cp-header">
    <h1 class="cp-title">{{ section.settings.title }}</h1>
    <p class="cp-subtitle">We're here to help you with your order, questions, or custom requests.</p>
  </div>

  <div class="cp-grid">
    <!-- WhatsApp Card -->
    <div class="cp-card">
      <svg class="cp-icon-large" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      <div class="cp-card-title">WhatsApp Us</div>
      <a href="https://wa.me/{{ section.settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' }}" class="cp-link" target="_blank">
        {{ section.settings.whatsapp_number }}
      </a>
      <p style="font-size: 0.9rem; color: #666; margin-top: 5px;">Direct Chat Support</p>
    </div>

    <!-- Email Card -->
    <div class="cp-card">
      <svg class="cp-icon-large" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
      <div class="cp-card-title">Email Us</div>
      <a href="mailto:{{ section.settings.email_address }}" class="cp-link">
        {{ section.settings.email_address }}
      </a>
      <p style="font-size: 0.9rem; color: #666; margin-top: 5px;">We reply within 24 hours</p>
    </div>

    <!-- Customer Service Hours -->
    <div class="cp-card">
      <svg class="cp-icon-large" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <div class="cp-card-title">Service Hours</div>
      <div class="cp-hours-text">
        {{ section.settings.customer_service_hours | newline_to_br }}
      </div>
    </div>
    
    <!-- FAQ Highlight -->
    <div class="cp-card">
       <svg class="cp-icon-large" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
       </svg>
       <div class="cp-card-title">Got Questions?</div>
       <a href="/pages/faqs" class="cp-link">Visit Help Center</a>
       <p style="font-size: 0.9rem; color: #666; margin-top: 5px;">Find answers instantly</p>
    </div>

  </div>

  <!-- Quick Help Links -->
  <div class="cp-quick-help">
    <h2 class="cp-section-title">Quick Help</h2>
    <div class="cp-help-links">
      <a href="/pages/faqs" class="cp-help-btn">FAQs</a>
      <a href="/pages/custom-orders" class="cp-help-btn">Custom Orders</a>
      <a href="/policies/shipping-policy" class="cp-help-btn">Shipping Policy</a>
      <a href="/policies/refund-policy" class="cp-help-btn">Returns & Refunds</a>
    </div>
  </div>

  <!-- Social Media -->
  <div class="cp-social">
    <h2 class="cp-section-title">Connect with us</h2>
    <div class="cp-social-links">
      {% if section.settings.social_instagram != blank %}
      <a href="{{ section.settings.social_instagram }}" class="cp-social-icon" target="_blank" aria-label="Instagram">
        <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>
      {% endif %}
      
      {% if section.settings.social_facebook != blank %}
      <a href="{{ section.settings.social_facebook }}" class="cp-social-icon" target="_blank" aria-label="Facebook">
        <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.791-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      {% endif %}

      {% if section.settings.social_twitter != blank %}
      <a href="{{ section.settings.social_twitter }}" class="cp-social-icon" target="_blank" aria-label="X (Twitter)">
        <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      {% endif %}

      {% if section.settings.social_youtube != blank %}
      <a href="{{ section.settings.social_youtube }}" class="cp-social-icon" target="_blank" aria-label="YouTube">
        <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
      {% endif %}
    </div>
  </div>

</div>
