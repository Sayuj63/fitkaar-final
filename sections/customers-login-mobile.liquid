{% comment %}
  #31: Mobile-number + OTP login mockup.
  This is UI-only. Wiring real OTP requires a backend (Twilio / MSG91 / Shopify Customer
  Accounts API). The form below collects phone/OTP and currently simulates the flow.
  Drop-in real backend later by replacing the simulated handlers in the inline script.
{% endcomment %}

<style>
  .otp-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: linear-gradient(135deg, #fafbff 0%, #f3f5fc 100%);
  }
  .otp-card {
    width: 100%;
    max-width: 420px;
    background: #fff;
    border-radius: 18px;
    padding: 36px 28px 32px;
    box-shadow: 0 18px 40px rgba(0, 12, 91, 0.10);
    position: relative;
    overflow: hidden;
  }
  .otp-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(90deg, var(--color-primary, #000c5b) 0%, var(--color-secondary, #71b6c8) 100%);
  }
  .otp-logo {
    text-align: center;
    margin-bottom: 12px;
  }
  .otp-logo img { height: 44px; margin: 0 auto; }
  .otp-title {
    text-align: center;
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-primary, #000c5b);
    margin: 14px 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .otp-subtitle {
    text-align: center;
    color: #6b7280;
    font-size: 0.9rem;
    margin-bottom: 26px;
  }
  .otp-form-group { margin-bottom: 18px; }
  .otp-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  .otp-phone-input {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f9fafb;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 12px 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .otp-phone-input:focus-within {
    border-color: var(--color-primary, #000c5b);
    box-shadow: 0 0 0 3px rgba(0, 12, 91, 0.08);
  }
  .otp-country-code {
    font-weight: 600;
    color: #374151;
    border-right: 1px solid #d1d5db;
    padding-right: 8px;
  }
  .otp-phone-input input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1rem;
    color: #111;
    letter-spacing: 0.05em;
    font-family: inherit;
  }
  .otp-input-row {
    display: flex;
    gap: 8px;
    justify-content: center;
  }
  .otp-input-cell {
    width: 48px;
    height: 56px;
    text-align: center;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    background: #f9fafb;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-primary, #000c5b);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    font-family: inherit;
  }
  .otp-input-cell:focus {
    outline: none;
    border-color: var(--color-primary, #000c5b);
    box-shadow: 0 0 0 3px rgba(0, 12, 91, 0.08);
    transform: translateY(-1px);
  }
  .otp-submit {
    width: 100%;
    padding: 14px 24px;
    background: var(--color-primary, #000c5b);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }
  .otp-submit:hover { background: #000940; transform: translateY(-1px); }
  .otp-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .otp-resend {
    text-align: center;
    margin-top: 14px;
    font-size: 0.85rem;
    color: #6b7280;
  }
  .otp-resend button {
    background: none;
    border: none;
    color: var(--color-primary, #000c5b);
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    font-family: inherit;
  }
  .otp-resend button:disabled { color: #9ca3af; cursor: not-allowed; text-decoration: none; }

  .otp-step { display: none; }
  .otp-step.active { display: block; }

  .otp-info-banner {
    margin-top: 16px;
    padding: 10px 14px;
    background: #fff8e7;
    border-left: 3px solid #f5a623;
    border-radius: 4px;
    font-size: 0.78rem;
    color: #5a4a1f;
    line-height: 1.4;
  }

  .otp-edit-phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 20px;
    font-size: 0.85rem;
    color: #6b7280;
    text-align: center;
  }
  .otp-edit-phone strong { color: #111; }
  .otp-edit-phone button {
    background: none;
    border: none;
    color: var(--color-primary, #000c5b);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 480px) {
    .otp-card { padding: 28px 22px 26px; border-radius: 14px; }
    .otp-title { font-size: 1.35rem; }
    .otp-input-cell { width: 42px; height: 50px; font-size: 1.2rem; }
  }
</style>

<section class="otp-page">
  <div class="otp-card" x-data="otpLogin()">
    <div class="otp-logo">
      <img src="{{ 'image copy 5.png' | asset_url }}" alt="Fitkaar">
    </div>

    <!-- Step 1: Phone -->
    <div class="otp-step" :class="{ 'active': step === 'phone' }">
      <h1 class="otp-title">Welcome back</h1>
      <p class="otp-subtitle">Sign in with your mobile number — we'll text you a 6-digit OTP.</p>

      <form @submit.prevent="requestOtp">
        <div class="otp-form-group">
          <label class="otp-label" for="otp-phone">Mobile Number</label>
          <div class="otp-phone-input">
            <span class="otp-country-code">+91</span>
            <input
              type="tel"
              id="otp-phone"
              x-model="phone"
              maxlength="10"
              pattern="[0-9]{10}"
              placeholder="10-digit number"
              autocomplete="tel-national"
              required
              inputmode="numeric"
            >
          </div>
        </div>
        <button type="submit" class="otp-submit" :disabled="phone.length !== 10 || sending">
          <span x-show="!sending">Send OTP</span>
          <span x-show="sending">Sending…</span>
        </button>
        <p class="otp-info-banner" x-show="!sending && !errorMsg">
          By continuing, you agree to our <a href="/policies/terms-of-service" style="color:#5a4a1f;text-decoration:underline;">Terms</a> and <a href="/policies/privacy-policy" style="color:#5a4a1f;text-decoration:underline;">Privacy Policy</a>.
        </p>
        <p class="otp-info-banner" style="background:#fee2e2;border-left-color:#dc2626;color:#991b1b;" x-show="errorMsg" x-text="errorMsg"></p>
      </form>
    </div>

    <!-- Step 2: OTP -->
    <div class="otp-step" :class="{ 'active': step === 'otp' }">
      <h1 class="otp-title">Enter OTP</h1>
      <p class="otp-subtitle">We sent a 6-digit code to your mobile.</p>
      <div class="otp-edit-phone">
        Sent to <strong>+91 <span x-text="phone"></span></strong>
        <button type="button" @click="step = 'phone'; otp = ['','','','','','']">Edit</button>
      </div>

      <form @submit.prevent="verifyOtp">
        <div class="otp-form-group">
          <label class="otp-label">6-digit OTP</label>
          <div class="otp-input-row">
            <template x-for="(digit, idx) in otp" :key="idx">
              <input
                type="text"
                class="otp-input-cell"
                maxlength="1"
                inputmode="numeric"
                pattern="[0-9]"
                :value="otp[idx]"
                @input="handleOtpInput($event, idx)"
                @keydown.backspace="handleBackspace($event, idx)"
                @paste="handlePaste($event)"
                :ref="'otpCell' + idx"
              >
            </template>
          </div>
        </div>

        <button type="submit" class="otp-submit" :disabled="!isOtpComplete() || verifying">
          <span x-show="!verifying">Verify &amp; Sign in</span>
          <span x-show="verifying">Verifying…</span>
        </button>

        <p class="otp-resend">
          Didn't get it?
          <button type="button" @click="resendOtp" :disabled="resendCooldown > 0">
            <span x-show="resendCooldown === 0">Resend OTP</span>
            <span x-show="resendCooldown > 0">Resend in <span x-text="resendCooldown"></span>s</span>
          </button>
        </p>
        <p class="otp-info-banner" style="background:#fee2e2;border-left-color:#dc2626;color:#991b1b;" x-show="errorMsg" x-text="errorMsg"></p>
      </form>
    </div>

    <!-- Step 3: Success -->
    <div class="otp-step" :class="{ 'active': step === 'success' }">
      <div style="text-align:center; padding: 14px 0 4px;">
        <div style="width:72px;height:72px;border-radius:50%;background:#d1fae5;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h1 class="otp-title" style="margin-top:0;">Signed in</h1>
        <p class="otp-subtitle">Welcome back to Fitkaar.</p>
        <a href="/account" class="otp-submit" style="display:block;text-decoration:none;text-align:center;">Go to my account</a>
      </div>
    </div>
  </div>
</section>

<script>
  function otpLogin() {
    return {
      step: 'phone',
      phone: '',
      otp: ['', '', '', '', '', ''],
      sending: false,
      verifying: false,
      errorMsg: '',
      resendCooldown: 0,
      _cooldownTimer: null,

      requestOtp() {
        this.errorMsg = '';
        if (this.phone.length !== 10) {
          this.errorMsg = 'Please enter a valid 10-digit Indian mobile number.';
          return;
        }
        this.sending = true;
        // TODO: replace with real OTP API call (Twilio / MSG91 / etc.)
        setTimeout(() => {
          this.sending = false;
          this.step = 'otp';
          this.otp = ['', '', '', '', '', ''];
          this.startCooldown(30);
          this.$nextTick(() => {
            const first = this.$refs.otpCell0;
            if (first) first.focus();
          });
        }, 800);
      },

      verifyOtp() {
        this.errorMsg = '';
        if (!this.isOtpComplete()) return;
        this.verifying = true;
        // TODO: replace with real verification call
        setTimeout(() => {
          this.verifying = false;
          // For mockup: accept any 6 digits
          this.step = 'success';
        }, 900);
      },

      resendOtp() {
        if (this.resendCooldown > 0) return;
        this.requestOtp();
      },

      startCooldown(seconds) {
        this.resendCooldown = seconds;
        clearInterval(this._cooldownTimer);
        this._cooldownTimer = setInterval(() => {
          this.resendCooldown--;
          if (this.resendCooldown <= 0) clearInterval(this._cooldownTimer);
        }, 1000);
      },

      isOtpComplete() {
        return this.otp.every(d => d.length === 1 && /[0-9]/.test(d));
      },

      handleOtpInput(e, idx) {
        const v = e.target.value.replace(/[^0-9]/g, '');
        this.otp[idx] = v.slice(0, 1);
        e.target.value = this.otp[idx];
        if (v && idx < 5) {
          const next = this.$refs['otpCell' + (idx + 1)];
          if (next) next.focus();
        }
      },

      handleBackspace(e, idx) {
        if (!this.otp[idx] && idx > 0) {
          const prev = this.$refs['otpCell' + (idx - 1)];
          if (prev) prev.focus();
        }
      },

      handlePaste(e) {
        e.preventDefault();
        const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '').slice(0, 6);
        for (let i = 0; i < 6; i++) this.otp[i] = pasted[i] || '';
        // Update DOM values too (Alpine inputs)
        for (let i = 0; i < 6; i++) {
          const cell = this.$refs['otpCell' + i];
          if (cell) cell.value = this.otp[i] || '';
        }
        const lastFilled = Math.min(pasted.length, 5);
        const focusEl = this.$refs['otpCell' + lastFilled];
        if (focusEl) focusEl.focus();
      }
    };
  }
</script>

{% schema %}
{
  "name": "Login (Mobile OTP)",
  "settings": [],
  "presets": [{ "name": "Login (Mobile OTP)" }]
}
{% endschema %}
