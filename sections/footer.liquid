{% comment %}
  Footer Section - FitKaar
  Layout: Logo+tagline | INFO | SHOP/EXPLORE | PROFILE | Newsletter
  Bottom: Social icons (only) | Tagline
{% endcomment %}

<style>
  .fk-footer {
    background: var(--color-primary, #000c5b);
    color: var(--color-white, #ffffff);
    font-family: var(--font-secondary, 'Raleway', sans-serif);
    padding: 60px 80px 50px;
    position: relative;
    z-index: 100;
  }

  /* Row 1 - Main Content */
  .fk-footer__row-1 {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: 50px;
  }

  /* Column 1 - Logo + Taglines */
  .fk-footer__logo-col {
    flex: 0 0 auto;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .fk-footer__brand-tagline .fk-footer__brand-line {
    white-space: nowrap;
  }

  .fk-footer__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 16px;
  }

  .fk-footer__logo img {
    width: 180px;
    height: auto;
    object-fit: contain;
  }

  .fk-footer__brand-tagline {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-accent, #bfdbe3);
    margin: 0;
    text-align: center;
  }

  /* Menu Columns */
  .fk-footer__menu-col {
    flex: 0 0 auto;
    display: flex;
    gap: 50px;
  }

  .fk-footer__menu-group {
    min-width: 140px;
  }

  .fk-footer__menu-group h4 {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    margin: 0 0 18px 0;
    color: var(--color-secondary, #71b6c8);
    font-family: var(--font-secondary, 'Raleway', sans-serif);
    text-transform: uppercase;
  }

  .fk-footer__menu-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .fk-footer__menu-group li {
    margin-bottom: 7px;
  }

  .fk-footer__menu-group a {
    color: var(--color-accent, #bfdbe3);
    text-decoration: none;
    font-size: 14px;
    line-height: 1.7;
    transition: color 0.2s;
    font-family: var(--font-secondary, 'Raleway', sans-serif);
  }

  .fk-footer__menu-group a:hover {
    color: var(--color-white, #ffffff);
  }

  /* Newsletter Column */
  .fk-footer__newsletter-col {
    flex: 0 0 auto;
    max-width: 280px;
  }

  .fk-footer__newsletter-heading {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    margin: 0 0 14px 0;
    color: var(--color-secondary, #71b6c8);
    font-family: var(--font-secondary, 'Raleway', sans-serif);
    text-transform: uppercase;
  }

  .fk-footer__newsletter-text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-accent, #bfdbe3);
    margin: 0 0 16px 0;
    max-width: 260px;
    font-family: var(--font-secondary, 'Raleway', sans-serif);
  }

  .fk-footer__form {
    display: flex;
    align-items: center;
    background: var(--color-secondary, #71b6c8);
    border-radius: 50px;
    overflow: hidden;
    max-width: 260px;
  }

  .fk-footer__form input[type="email"] {
    flex: 1;
    border: none;
    background: transparent;
    padding: 12px 18px;
    font-size: 13px;
    color: var(--color-primary, #000c5b);
    outline: none;
    font-family: var(--font-secondary, 'Raleway', sans-serif);
  }

  .fk-footer__form input[type="email"]::placeholder {
    color: var(--color-primary, #000c5b);
    opacity: 0.8;
  }

  .fk-footer__form button {
    background: transparent;
    border: none;
    padding: 12px 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fk-footer__form button svg {
    width: 20px;
    height: 20px;
    stroke: var(--color-primary, #000c5b);
  }

  /* #17: newsletter post-submit message */
  .fk-footer__newsletter-msg {
    width: 100%;
    flex-basis: 100%;
    margin-top: 10px;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-family: var(--font-secondary, 'Raleway', sans-serif);
    text-align: center;
  }
  .fk-footer__newsletter-msg--ok {
    background: rgba(113, 182, 200, 0.15);
    color: var(--color-secondary, #71b6c8);
  }
  .fk-footer__newsletter-msg--err {
    background: rgba(220, 38, 38, 0.15);
    color: #fecaca;
  }

  /* Row 2 - Social Icons & Tagline */
  .fk-footer__row-2 {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  /* Social Icons */
  .fk-footer__socials {
    display: flex;
    gap: 18px;
    align-items: flex-end;
  }

  .fk-footer__socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .fk-footer__socials a:hover {
    transform: translateY(-4px);
  }

  .fk-footer__socials a:active {
    transform: translateY(-2px) scale(0.95);
  }

  .fk-footer__socials svg {
    width: 26px;
    height: 26px;
    transition: all 0.3s ease;
  }

  .fk-footer__socials svg.icon-stroke {
    fill: none;
    stroke: var(--color-secondary, #71b6c8);
    stroke-width: 1.5;
  }

  .fk-footer__socials svg.icon-fill {
    fill: var(--color-secondary, #71b6c8);
  }

  .fk-footer__socials a:hover svg.icon-stroke {
    stroke: var(--color-white, #ffffff);
    filter: drop-shadow(0 0 6px rgba(113, 182, 200, 0.5));
  }

  .fk-footer__socials a:hover svg.icon-fill {
    fill: var(--color-white, #ffffff);
    filter: drop-shadow(0 0 6px rgba(113, 182, 200, 0.5));
  }

  /* Tagline */
  .fk-footer__tagline {
    font-size: 48px;
    font-weight: 800;
    color: var(--color-secondary, #71b6c8);
    letter-spacing: 0.02em;
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
    padding: 0;
  }

  .fk-footer__tagline .hindi {
    color: var(--color-accent, #bfdbe3);
    font-size: 0.55em;
    vertical-align: middle;
    margin: 0 2px;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .fk-footer {
      padding: 50px 40px;
    }
    .fk-footer__row-1 {
      flex-wrap: wrap;
      gap: 32px;
    }
    .fk-footer__menu-col {
      gap: 32px;
    }
    .fk-footer__tagline {
      font-size: 36px;
    }
  }

  @media (max-width: 768px) {
    .fk-footer {
      padding: 40px 24px;
    }
    .fk-footer__row-1 {
      flex-direction: column;
      gap: 28px;
      align-items: flex-start;
    }
    .fk-footer__logo-col {
      align-self: center;
      width: 100%;
    }
    .fk-footer__logo img {
      width: 140px;
    }
    .fk-footer__menu-col {
      flex-wrap: wrap;
      gap: 28px;
      justify-content: flex-start;
      align-content: flex-start;
      width: 100%;
    }
    .fk-footer__menu-group {
      min-width: 120px;
      text-align: left;
    }
    .fk-footer__row-2 {
      flex-direction: column;
      align-items: center;
      gap: 24px;
      text-align: center;
    }
    .fk-footer__tagline {
      font-size: 24px;
      text-align: center;
    }
    .fk-footer__socials {
      justify-content: center;
    }
    .fk-footer__socials svg {
      width: 22px;
      height: 22px;
    }
    .fk-footer__logo-col {
      max-width: 100%;
      width: 100%;
      align-self: center;
      align-items: center;
    }
    .fk-footer__brand-tagline {
      text-align: center;
    }
    .fk-footer__brand-tagline .fk-footer__brand-line {
      white-space: normal;
    }
    .fk-footer__newsletter-col {
      width: 100%;
      max-width: 320px;
      text-align: center;
    }
    .fk-footer__newsletter-text {
      margin-left: auto;
      margin-right: auto;
    }
    .fk-footer__form {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

<footer class="fk-footer">
  <!-- Row 1: Logo, Menus, Newsletter -->
  <div class="fk-footer__row-1">

    <!-- Column 1: Logo + Brand Taglines -->
    <div class="fk-footer__logo-col">
      <div class="fk-footer__logo">
        <img src="{{ 'FitKaar.png' | asset_url }}" alt="{{ shop.name }}" loading="lazy">
      </div>
      <p class="fk-footer__brand-tagline">
        <span class="fk-footer__brand-line">India's first ever fully customisable clothing brand</span><br>
        <span class="fk-footer__brand-line">Serving Pan India</span>
      </p>
    </div>

    <!-- Menu Columns -->
    <div class="fk-footer__menu-col">
      <!-- INFO -->
      <div class="fk-footer__menu-group">
        <h4>Info</h4>
        <ul>
            <li><a href="/pages/contact-us">Contact Us</a></li>
            <li><a href="/pages/faqs">FAQs</a></li>
            <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
            <li><a href="/pages/terms-conditions">Terms &amp; Conditions</a></li>
            <li><a href="/pages/about-us">About Us</a></li>
        </ul>
      </div>

      <!-- SHOP / EXPLORE -->
      <div class="fk-footer__menu-group">
        <h4>Shop / Explore</h4>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/collections/all">Shop</a></li>
            <li><a href="/collections/best-sellers">Best Sellers</a></li>
            <li><a href="/pages/process">Custom Orders</a></li>
            <li><a href="/pages/bulk-orders">Bulk Orders</a></li>
            <li><a href="/collections/all">Collections</a></li>
            <li><a href="/products/gift-card">Gift Card</a></li>
        </ul>
      </div>

      <!-- PROFILE -->
      <div class="fk-footer__menu-group">
        <h4>Profile</h4>
        <ul>
            <li><a href="/account">My Account</a></li>
            <li><a href="/account/login">Login / Register</a></li>
            <li><a href="/account/orders">Order History</a></li>
            <li><a href="/pages/wishlist">Wishlist</a></li>
        </ul>
      </div>
    </div>

    <!-- Newsletter -->
    <div class="fk-footer__newsletter-col">
      <h4 class="fk-footer__newsletter-heading">WE'VE GOT YOU COVERED:</h4>
      <p class="fk-footer__newsletter-text">Beyond the Outfit: Be the first to know about new arrivals, sales & exclusive drops.</p>

      {% form 'customer', id: 'footer-newsletter', class: 'fk-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          placeholder="your email here"
          required
          autocomplete="email"
        >
        <button type="submit" aria-label="Subscribe">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>

        {%- if form.posted_successfully? -%}
          <p class="fk-footer__newsletter-msg fk-footer__newsletter-msg--ok">Thanks! You're on the list ✨</p>
        {%- elsif form.errors -%}
          <p class="fk-footer__newsletter-msg fk-footer__newsletter-msg--err">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {% endform %}
    </div>

  </div>

  <!-- Row 2: Social Icons & Tagline -->
  <div class="fk-footer__row-2">

    <!-- Social Icons (only icons) -->
    <div class="fk-footer__socials">
      <!-- WhatsApp -->
      <a href="{{ section.settings.whatsapp | default: 'https://wa.me/919354478146' }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg class="icon-fill" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill-rule="evenodd" clip-rule="evenodd">
          <path d="M20.52 3.449A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.423-8.452zm-8.47 18.297h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.825 9.825 0 0 1 6.994 2.898 9.821 9.821 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.888 9.884zm5.422-7.403c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
      </a>

      <!-- Instagram -->
      <a href="{{ section.settings.ig | default: '#' }}" target="_blank" rel="noopener" aria-label="Instagram">
        <svg class="icon-stroke" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a href="{{ section.settings.li | default: '#' }}" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg class="icon-fill" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>

      <!-- YouTube -->
      <a href="{{ section.settings.yt | default: '#' }}" target="_blank" rel="noopener" aria-label="YouTube">
        <svg class="icon-fill" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      </a>

      <!-- Website -->
      <a href="{{ section.settings.website | default: '#' }}" target="_blank" rel="noopener" aria-label="Website">
        <svg class="icon-stroke" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </a>

      <!-- Blog -->
      <a href="{{ section.settings.blog | default: '/blogs' }}" target="_blank" rel="noopener" aria-label="Blog">
        <svg class="icon-stroke" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
      </a>

      <!-- Facebook -->
      <a href="{{ section.settings.facebook | default: '#' }}" target="_blank" rel="noopener" aria-label="Facebook">
        <svg class="icon-fill" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>
    </div>

    <!-- Tagline -->
    <div class="fk-footer__tagline">
      KAPDO <span class="hindi">का</span> KALAKAR
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "ig",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "li",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "yt",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "website",
      "label": "Website URL"
    },
    {
      "type": "url",
      "id": "blog",
      "label": "Blog URL"
    },
    {
      "type": "url",
      "id": "whatsapp",
      "label": "WhatsApp Business Link"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook URL"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
