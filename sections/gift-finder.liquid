    if (state.who === 'partner') return PARTNER_STEPS;
    if (state.who === 'family') return (state.relation === 'pet') ? FAMILY_PET_STEPS : FAMILY_STEPS;
    return FRIEND_STEPS;
  }
  function tick(stepName){ var steps = currentSteps(); updateTicket(steps.indexOf(stepName), steps.length); }
  function qLabel(stepName){ return 'Q' + (currentSteps().indexOf(stepName) + 1); }

