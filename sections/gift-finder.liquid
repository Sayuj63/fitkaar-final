  // Find every item sharing a group with the first keyword hit, searching ACROSS
  // food + sport + profession together (so "baking" typed anywhere still finds it),
  // capped at 3, seed first.
  function findMatches(text){
    var t = text.toLowerCase().trim();
    if (!t) return [];
    var seedGroup = null;
    var seedIdx = -1;
    for (var i=0;i<ALL_CATALOG.length;i++){
      for (var j=0;j<ALL_CATALOG[i].keys.length;j++){
        if (t.indexOf(ALL_CATALOG[i].keys[j]) !== -1){ seedGroup = ALL_CATALOG[i].group; seedIdx = i; break; }
      }
      if (seedGroup) break;
    }
    if (!seedGroup) return [];
    var out = [ALL_CATALOG[seedIdx]];
    for (var k=0;k<ALL_CATALOG.length;k++){
      if (k===seedIdx) continue;
      if (ALL_CATALOG[k].group === seedGroup) out.push(ALL_CATALOG[k]);
      if (out.length >= 3) break;
    }
    return out;
  }

  function findByGroup(catalog, group){
    var out = [];
    for (var i=0;i<catalog.length;i++){
      if (catalog[i].group === group){ out.push(catalog[i]); if (out.length>=3) break; }
    }
    return out;
  }

  // ---------------- Quiz state ----------------
  var state = { who:null, food:[], foodRaw:"", sport:[], sportRaw:"", profession:[], professionRaw:"", zodiac:null, coupleType:null, couplePicks:[], relation:null, familyPicks:[], familyLabel:"", petName:"" };

