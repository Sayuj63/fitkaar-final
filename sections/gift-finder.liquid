    });
    document.getElementById('profSkip').addEventListener('click', function(){ state.profession = []; state.professionRaw = ""; renderZodiac(); });
    document.getElementById('backBtn').addEventListener('click', function(){
      if (state.who === 'friend' || state.who === 'self') { renderSport(); } else { renderFood(); }
    });
  }

  // ---- Zodiac (final question, both flows) ----
  var SIGNS = ["Aries","Taurus","Gemini","Cancer","Leo","Virgo","Libra","Scorpio","Sagittarius","Capricorn","Aquarius","Pisces"];
  function renderZodiac(){
    tick('zodiac');
    var grid = SIGNS.map(function(s){ return '<button class="option" data-v="'+s+'">'+s+'</button>'; }).join('');
    screen.innerHTML =
      '<div class="q-tag">' + qLabel('zodiac') + ' - Zodiac</div>' +
      '<div class="q-prompt">What\u2019s ' + (isSelf() ? 'your' : 'their') + ' zodiac sign?</div>' +
      '<div class="zodiac-grid">' + grid + '</div>' +
      '<div class="nav-row"><button class="link-back" id="backBtn">\u2190 back</button><span></span></div>';

    Array.prototype.forEach.call(screen.querySelectorAll('.option'), function(btn){
      btn.addEventListener('click', function(){ state.zodiac = btn.getAttribute('data-v'); renderResult(); });
    });
    document.getElementById('backBtn').addEventListener('click', renderProfession);
  }

  function thumbHtml(m){
    if (m.image){
      return '<div class="pick-thumb"><img src="'+m.image+'" alt="" loading="lazy"></div>';
    }
    return '<div class="pick-thumb">\uD83D\uDC55</div>'; // placeholder - swap in item.image later for the real product photo
  }

  function picksHtml(items){
    return items.map(function(m){
      var priceHtml = m.was
        ? '<span class="pick-price"><span class="pick-was">'+m.was+'</span>'+m.price+'</span>'
        : '<span class="pick-price">'+m.price+'</span>';
      var offHtml = m.off ? '<span class="pick-off">'+m.off+'</span>' : '';
      return '<a class="pick" href="'+m.url+'" target="_blank" rel="noopener">' +
        '<div class="pick-body"><div class="pick-top"><span class="pick-name">'+m.name+'</span>'+priceHtml+'</div>'+offHtml+'</div>' +
        thumbHtml(m) +
        '</a>';
    }).join('');
  }

  function pickSection(items, rawText, fallbackUrl, fallbackLabel){
    if (items && items.length){
      return '<div class="pick-list">' + picksHtml(items) + '</div>';
    }
    if (!rawText){
      // genuinely skipped, not a miss
      return '<a class="pick" href="'+fallbackUrl+'" target="_blank" rel="noopener">' +
        '<div class="pick-top"><span class="pick-name">'+fallbackLabel+'</span></div></a>';
    }
    // typed something real, but we genuinely don't have a design for it yet
    return '<a class="pick" href="'+CUSTOMISE_URL+'" target="_blank" rel="noopener">' +
      '<div class="pick-top"><span class="pick-name">We don\u2019t have a design for \u201c'+rawText.trim()+'\u201d yet</span></div>' +
      '<div class="pick-fallback-note">But we\u2019d love to design it exclusively for you - tap to start a custom order.</div></a>' +
      '<a class="pick" href="'+fallbackUrl+'" target="_blank" rel="noopener" style="margin-top:10px;">' +
      '<div class="pick-top"><span class="pick-name">Or browse '+fallbackLabel+'</span></div></a>';
  }

  function renderResult(){
    updateTicket(currentSteps().length, currentSteps().length);
    var isPartner = state.who === 'partner';
    var isFamily = state.who === 'family';
    var isPet = isFamily && state.relation === 'pet';

    var coupleSectionHtml = '';
    if (isPartner){
      var coupleLabel = state.coupleType === 'hard' ? 'THE HARD LAUNCH PICK' : 'THE MATCHING PICK';
      var coupleFallback = state.coupleType === 'hard' ? COUPLES_URL : MATCHING_URL;
      coupleSectionHtml = '<div class="pick-group"><div class="pick-group-label">' + coupleLabel + '</div>' +
        pickSection(state.couplePicks, "", coupleFallback, "Browse Couples") + '</div>';
    }

    var familySectionHtml = '';
    if (isFamily){
      familySectionHtml = '<div class="pick-group"><div class="pick-group-label">' + state.familyLabel + '</div>' +
        '<div class="pick-list">' + picksHtml(state.familyPicks) + '</div></div>';
    }

    var sportSectionHtml = (isPartner || isFamily) ? '' :
      '<div class="pick-group"><div class="pick-group-label">SPORT / HOBBY</div>' + pickSection(state.sport, state.sportRaw, SPORT_URL, "Browse Sports & Fitness") + '</div>';

    var professionLabel = (isPartner || isFamily) ? 'HOBBY / PROFESSION' : 'PROFESSION';
    var professionSectionHtml = isPet ? '' :
      '<div class="pick-group"><div class="pick-group-label">' + professionLabel + '</div>' + pickSection(state.profession, state.professionRaw, PROFESSION_URL, "Browse Work & Hobbies") + '</div>';

    var foodSectionHtml = isPet ? '' :
      '<div class="pick-group"><div class="pick-group-label">FOOD</div>' + pickSection(state.food, state.foodRaw, FOOD_URL, "Browse Food & Drinks") + '</div>';

    var zodiacSectionHtml = '';
    if (!isPet && state.zodiac){
      var z = ZODIAC_CATALOG[state.zodiac];
      zodiacSectionHtml = '<div class="pick-group"><div class="pick-group-label">ZODIAC - ' + state.zodiac.toUpperCase() + '</div>' +
        '<div class="pick-list">' + picksHtml([z]) + '</div></div>';
    }

    screen.innerHTML =
      '<div class="result-eyebrow">HERE\u2019S WHAT WE FOUND</div>' +
      '<h2 class="result-title">A few picks for ' + (isSelf() ? 'you' : 'them') + '</h2>' +
      '<p class="result-sub">Based on what you told us - tap any pick to see it on the shop.</p>' +

      coupleSectionHtml +
      familySectionHtml +
      foodSectionHtml +
      sportSectionHtml +
      professionSectionHtml +
      zodiacSectionHtml +

      '<div class="pick-group">' +
        '<a class="pick" href="' + CUSTOMISE_URL + '" target="_blank" rel="noopener">' +
        '<div class="pick-top"><span class="pick-name">Didn\u2019t like these?</span></div>' +
        '<div class="pick-fallback-note">We\u2019ll design something exclusively for you - tap to start a custom order.</div></a>' +
      '</div>' +

      '<div class="restart-row"><button class="link-back" id="restartBtn">Start over</button></div>';

    document.getElementById('restartBtn').addEventListener('click', function(){
      state = { who:null, food:[], foodRaw:"", sport:[], sportRaw:"", profession:[], professionRaw:"", zodiac:null, coupleType:null, couplePicks:[], relation:null, familyPicks:[], familyLabel:"", petName:"" };
      renderIntro();
    });

    burst();
  }

  // ---------------- confetti ----------------
  function burst(){
    var canvas = document.getElementById('fk-burst');
    var ctx = canvas.getContext('2d');
    var dpr = window.devicePixelRatio || 1;
    canvas.width = window.innerWidth*dpr; canvas.height = window.innerHeight*dpr;
    canvas.style.width = window.innerWidth+'px'; canvas.style.height = window.innerHeight+'px';
    ctx.scale(dpr,dpr);
    var colors = ['#16204A','#7FB3E8','#EAF3FC','#FFFFFF'];
    var particles = []; var count = 60; var cx = window.innerWidth/2;
    for (var i=0;i<count;i++){
      var angle = Math.random()*Math.PI - Math.PI;
      var speed = 3 + Math.random()*5;
      particles.push({ x: cx+(Math.random()-0.5)*60, y: window.innerHeight*0.25,
        vx: Math.cos(angle)*speed, vy: Math.sin(angle)*speed-4,
        size: 4+Math.random()*5, color: colors[i%colors.length], rot: Math.random()*Math.PI, vr:(Math.random()-0.5)*0.3, life:0 });
    }
    var maxLife = 70;
    function frame(){
      ctx.clearRect(0,0,window.innerWidth,window.innerHeight);
      var alive = false;
      particles.forEach(function(p){
        p.life++; if (p.life>maxLife) return; alive = true;
        p.vy += 0.18; p.x += p.vx; p.y += p.vy; p.rot += p.vr;
        ctx.save(); ctx.globalAlpha = Math.max(0,1-p.life/maxLife);
        ctx.translate(p.x,p.y); ctx.rotate(p.rot); ctx.fillStyle = p.color;
        ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size); ctx.restore();
      });
      if (alive) requestAnimationFrame(frame); else ctx.clearRect(0,0,window.innerWidth,window.innerHeight);
    }
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) requestAnimationFrame(frame);
  }
  window.addEventListener('resize', function(){ var c=document.getElementById('fk-burst'); c.width=0; c.height=0; });

  renderIntro();
})();

</script>


