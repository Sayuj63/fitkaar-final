{% comment %}
  Gift Finder — interactive gift-recommendation quiz.
  Self-contained widget: styles + markup + JS, scoped under #fk-gift-finder. Product images included.
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;600;700;800&family=Raleway:wght@400;500;600;700&display=swap');
  #fk-gift-finder {
    --bg: #FFFFFF;
    --blue: #16204A;
    --blue-light: #7FB3E8;
    --paper: #EAF3FC;
    --border: #16204A;
  }
#fk-gift-finder * { box-sizing: border-box; }
  #fk-gift-finder { margin:0; padding:0; }
  #fk-gift-finder { display:flex; justify-content:center; align-items:center; min-height:100vh; padding:32px 16px 64px; position:relative; overflow:hidden; background:var(--bg); font-family:'Raleway', Helvetica, sans-serif; color:var(--blue); }
  #fk-gift-finder::before, #fk-gift-finder::after { content:""; position:absolute; width:360px; height:360px; border-radius:50%; background:var(--blue-light); opacity:0.28; filter:blur(70px); z-index:0; pointer-events:none; }
  #fk-gift-finder::before { top:-140px; left:-140px; }
  #fk-gift-finder::after { bottom:-160px; right:-160px; }
#fk-gift-finder .stage { width:100%; max-width:560px; position:relative; z-index:1; }
#fk-gift-finder h1, #fk-gift-finder h2, #fk-gift-finder h3, #fk-gift-finder .display { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; line-height:1.1; margin:0; text-transform:uppercase; color:var(--blue); }

#fk-gift-finder .ticket { background:var(--paper); border:1px solid var(--blue-light); border-radius:8px; padding:12px 16px; margin-bottom:24px; display:flex; align-items:center; gap:14px; }
#fk-gift-finder .ticket-label { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.66rem; letter-spacing:0.04em; color:var(--blue); white-space:nowrap; text-transform:uppercase; }
#fk-gift-finder .ticket-track { flex:1; height:4px; background:#fff; border-radius:4px; overflow:hidden; }
#fk-gift-finder .ticket-fill { height:100%; background:var(--blue); width:0%; transition:width .35s ease; }
#fk-gift-finder .ticket-count { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.8rem; min-width:36px; text-align:right; }

#fk-gift-finder .card { background:#fff; border:1px solid var(--blue-light); border-radius:10px; padding:28px 24px; }

#fk-gift-finder .eyebrow { display:inline-block; text-align:center; color:var(--blue); font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.66rem; letter-spacing:0.08em; padding-bottom:4px; margin-bottom:14px; text-transform:uppercase; border-bottom:2px solid var(--blue-light); }
#fk-gift-finder .intro { text-align:center; }
#fk-gift-finder .brand-logo { height:40px; margin-bottom:14px; }
#fk-gift-finder .intro h1 { font-size:1.9rem; margin-bottom:6px; }
#fk-gift-finder .intro h1 .h1-accent { display:block; color:var(--blue-light); }
#fk-gift-finder .intro-sub { color:var(--blue); opacity:0.7; font-size:1rem; margin-bottom:22px; text-transform:none; font-weight:600; }
#fk-gift-finder .intro p { color:var(--blue); opacity:0.7; font-size:1rem; line-height:1.5; margin-bottom:26px; text-transform:none; }

#fk-gift-finder .btn { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.92rem; letter-spacing:0.02em; text-transform:uppercase; text-align:center; color:#fff; background:var(--blue); border:1px solid var(--blue); border-radius:6px; padding:14px 22px; cursor:pointer; transition:opacity .12s ease; width:100%; }
#fk-gift-finder .btn:hover { opacity:0.85; }
#fk-gift-finder .btn:active { opacity:0.7; }
#fk-gift-finder .btn:focus-visible { outline:2px solid var(--blue); outline-offset:2px; }

#fk-gift-finder .q-tag { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.66rem; letter-spacing:0.06em; color:var(--blue); margin-bottom:10px; text-transform:uppercase; text-align:center; }
#fk-gift-finder .q-prompt { font-size:1.3rem; margin-bottom:20px; text-transform:none; text-align:center; }
#fk-gift-finder .options { display:flex; flex-direction:column; gap:10px; }
#fk-gift-finder .option { font-family:'Raleway', Helvetica, sans-serif; font-weight:600; font-size:0.95rem; text-align:center; background:var(--paper); color:var(--blue); border:1px solid var(--blue-light); border-radius:6px; padding:13px 16px; cursor:pointer; transition:background .12s ease, color .12s ease; }
#fk-gift-finder .option:hover { background:var(--blue); border-color:var(--blue); color:#fff; }
#fk-gift-finder .option:focus-visible { outline:2px solid var(--blue); outline-offset:2px; }
#fk-gift-finder .option.ghost { background:transparent; border:1px dashed var(--blue-light); color:var(--blue); opacity:0.65; }
#fk-gift-finder .option.ghost:hover { background:var(--paper); color:var(--blue); opacity:1; }

#fk-gift-finder .zodiac-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; }
#fk-gift-finder .zodiac-grid .option { text-align:center; padding:12px 6px; font-size:0.85rem; }

#fk-gift-finder .type-row { display:flex; gap:8px; margin-top:14px; }
#fk-gift-finder .type-input { flex:1; font-family:'Raleway', Helvetica, sans-serif; font-size:0.95rem; padding:11px 14px; border:1px solid var(--blue-light); border-radius:6px; background:#fff; color:var(--blue); }
#fk-gift-finder .type-input:focus { outline:2px solid var(--blue); outline-offset:1px; }
#fk-gift-finder .type-go { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.8rem; letter-spacing:0.03em; text-transform:uppercase; background:var(--blue); color:#fff; border:1px solid var(--blue); border-radius:6px; padding:0 16px; cursor:pointer; }
#fk-gift-finder .type-go:hover { opacity:0.85; }
#fk-gift-finder .type-hint { font-size:0.78rem; color:var(--blue); opacity:0.65; margin-top:8px; text-align:center; }

#fk-gift-finder .nav-row { display:flex; justify-content:center; margin-top:20px; align-items:center; }
#fk-gift-finder .link-back { font-family:'Raleway', Helvetica, sans-serif; font-weight:600; font-size:0.85rem; color:var(--blue); opacity:0.65; background:none; border:none; cursor:pointer; text-decoration:underline; padding:6px 0; text-align:center; }

#fk-gift-finder .result-eyebrow { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.66rem; letter-spacing:0.06em; color:var(--blue); margin-bottom:8px; text-transform:uppercase; }
#fk-gift-finder .result-eyebrow, #fk-gift-finder .result-title, #fk-gift-finder .result-sub { text-align:center; }
#fk-gift-finder .result-title { font-size:1.6rem; margin-bottom:6px; }
#fk-gift-finder .result-sub { color:var(--blue); opacity:0.7; font-size:0.9rem; margin-bottom:22px; text-transform:none; }

#fk-gift-finder .pick-group { margin-bottom:18px; }
#fk-gift-finder .pick-group-label { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.68rem; letter-spacing:0.05em; color:var(--blue); margin-bottom:8px; text-transform:uppercase; text-align:center; }
#fk-gift-finder .pick-list { display:flex; flex-direction:column; gap:8px; }
#fk-gift-finder .pick { display:flex; flex-direction:row; align-items:center; gap:12px; text-decoration:none; color:var(--blue); background:var(--paper); border:1px solid var(--blue-light); border-radius:8px; padding:12px 14px; transition:border-color .12s ease, background .12s ease; }
#fk-gift-finder .pick:hover { border-color:var(--blue); background:#fff; }
#fk-gift-finder .pick-body { flex:1; min-width:0; text-align:left; }
#fk-gift-finder .pick-top { display:flex; flex-direction:column; align-items:flex-start; gap:4px; }
#fk-gift-finder .pick-name { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.86rem; text-transform:uppercase; }
#fk-gift-finder .pick-price { font-family:'League Spartan', Helvetica, sans-serif; font-weight:700; font-size:0.86rem; color:var(--blue); white-space:nowrap; }
#fk-gift-finder .pick-was { font-size:0.76rem; color:var(--blue); opacity:0.55; text-decoration:line-through; margin-right:6px; }
#fk-gift-finder .pick-off { display:inline-block; margin-top:6px; font-size:0.66rem; font-weight:700; letter-spacing:0.02em; color:#fff; background:var(--blue); padding:2px 6px; border-radius:3px; text-transform:uppercase; }
#fk-gift-finder .pick-fallback-note { font-size:0.82rem; color:var(--blue); opacity:0.65; margin-top:8px; text-transform:none; text-align:center; }
#fk-gift-finder .pick-thumb { flex-shrink:0; width:52px; height:52px; border:1px solid var(--blue-light); border-radius:6px; background:#fff; display:flex; align-items:center; justify-content:center; overflow:hidden; font-size:1.3rem; }
#fk-gift-finder .pick-thumb img { width:100%; height:100%; object-fit:cover; display:block; }

#fk-gift-finder .restart-row { text-align:center; margin-top:10px; }
#fk-gift-finder canvas#fk-burst { position:fixed; inset:0; pointer-events:none; z-index:5; }
</style>
</head>
