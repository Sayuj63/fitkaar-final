  function updateTicket(n, total){
    if (n === null){ ticket.style.display='none'; return; }
    total = total || currentSteps().length;
    ticket.style.display='flex';
    ticketFill.style.width = Math.round((n/total)*100)+'%';
    ticketCount.textContent = n+'/'+total;
  }

