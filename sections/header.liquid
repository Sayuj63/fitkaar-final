      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 3px;
      line-height: 1.3;
    }
    .fk-cart-rec-card-price {
      font-size: 0.75rem;
      font-weight: 800;
      color: var(--color-primary);
    }
    .fk-cart-empty {
      text-align: center;
      padding: 2rem 0;
      color: #6b7280;
      font-size: 0.95rem;
    }
    .fk-cart-footer {
      flex-shrink: 0;
      padding: 1rem 1.25rem 1.25rem;
      border-top: 1px solid #f3f4f6;
      background: #fafbff;
    }
    .fk-cart-subtotal {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1rem;
      margin-bottom: 12px;
      color: var(--color-primary);
    }
    .fk-cart-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .fk-cart-btn {
      display: block;
      text-align: center;
      padding: 14px 16px;
      border-radius: 999px;
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .fk-cart-btn--primary {
      background: var(--color-primary);
      color: #fff;
      border: none;
    }
    .fk-cart-btn--ghost {
      background: #fff;
      color: var(--color-primary);
      border: 2px solid var(--color-primary);
    }
    .fk-cart-btn:hover { opacity: 0.92; }

    .fk-cart-drawer-enter { transition: transform 0.34s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.26s ease; }
    .fk-cart-drawer-enter-start { transform: translateX(100%); opacity: 0.9; }
    .fk-cart-drawer-enter-end { transform: translateX(0); opacity: 1; }
    .fk-cart-drawer-leave { transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.22s ease; }
    .fk-cart-drawer-leave-start { transform: translateX(0); opacity: 1; }
    .fk-cart-drawer-leave-end { transform: translateX(100%); opacity: 0.9; }

    /* Free T-shirt reward bar */
    .fk-cart-reward {
      flex-shrink: 0;
      padding: 10px 1.25rem 12px;
      background: linear-gradient(135deg, #fff8e7 0%, #fff 100%);
      border-bottom: 1px solid #f0e6d0;
    }
    .fk-cart-reward__msg {
      font-size: 0.82rem;
      color: #5a4a1f;
      font-weight: 600;
      margin: 0 0 8px;
    }
    .fk-cart-reward__msg strong { color: var(--color-primary); }
    .fk-cart-reward__won { color: #2e7d32 !important; }
    .fk-cart-reward__track {
      width: 100%; height: 5px;
      background: #f3e8c4; border-radius: 999px; overflow: hidden;
    }
    .fk-cart-reward__fill {
      height: 100%;
      background: linear-gradient(90deg, var(--color-secondary, #71b6c8) 0%, var(--color-primary, #000c5b) 100%);
      border-radius: 999px;
      transition: width 0.5s ease;
    }

    /* "You may also like" in drawer */
    .fk-cart-recs {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid #f3f4f6;
    }
    .fk-cart-recs__title {
      font-family: var(--font-heading);
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--color-primary);
      margin-bottom: 8px;
    }
  </style>

