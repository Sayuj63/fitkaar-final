{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Shown in the header (mobile + desktop). PNG or SVG upload recommended. If empty, the theme falls back to the default asset image."
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name (wordmark)",
      "default": "FITKAAR™",
      "info": "Shown next to the logo on desktop, as the mobile centre title, and in the mobile menu header."
    },
    {
      "type": "header",
      "content": "Main Navigation"
    },
    {
      "type": "text",
      "id": "nav_home_label",
      "label": "Home: label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "nav_customise_label",
      "label": "Customise: label",
      "default": "Customise"
    },
    {
      "type": "url",
      "id": "nav_customise_url",
      "label": "Customise: URL"
    },
    {
      "type": "text",
      "id": "nav_shop_label",
      "label": "Shop: label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "nav_shop_url",
      "label": "Shop: URL (used for the main shop link and Shop All)"
    },
    {
      "type": "text",
      "id": "nav_about_label",
      "label": "About Us: label",
      "default": "About Us"
    },
    {
      "type": "url",
      "id": "nav_about_url",
      "label": "About Us: URL"
    },
    {
      "type": "text",
      "id": "nav_contact_label",
      "label": "Contact: label",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "nav_contact_url",
      "label": "Contact: URL"
    },
    {
      "type": "header",
      "content": "Shop Dropdown — Column 1"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Heading",
      "default": "Essentials"
    },
    {
      "type": "text",
      "id": "col1_l1_label",
      "label": "Link 1 label",
      "default": "Everyday"
    },
    {
      "type": "url",
      "id": "col1_l1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "col1_l2_label",
      "label": "Link 2 label",
      "default": "Your Aesthetic"
    },
    {
      "type": "url",
      "id": "col1_l2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "col1_l3_label",
      "label": "Link 3 label",
      "default": "Basics"
    },
    {
      "type": "url",
      "id": "col1_l3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "text",
      "id": "col1_l4_label",
      "label": "Link 4 label",
      "default": "Only At Fitkaar"
    },
    {
      "type": "url",
      "id": "col1_l4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "col1_l5_label",
      "label": "Link 5 label (optional)"
    },
    {
      "type": "url",
      "id": "col1_l5_url",
      "label": "Link 5 URL (optional)"
    },
    {
      "type": "header",
