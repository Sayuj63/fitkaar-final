      "label": "Link 1 label",
      "default": "Pride Month Collection"
    },
    {
      "type": "url",
      "id": "col2_l1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "col2_l2_label",
      "label": "Link 2 label",
      "default": "Food & Drinks"
    },
    {
      "type": "url",
      "id": "col2_l2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "col2_l3_label",
      "label": "Link 3 label",
      "default": "Sports & Fitness"
    },
    {
      "type": "url",
      "id": "col2_l3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "text",
      "id": "col2_l4_label",
      "label": "Link 4 label",
      "default": "Work & Hobbies"
    },
    {
      "type": "url",
      "id": "col2_l4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "col2_l5_label",
      "label": "Link 5 label",
      "default": "Pun Intended"
    },
    {
      "type": "url",
      "id": "col2_l5_url",
      "label": "Link 5 URL"
    },
    {
      "type": "text",
      "id": "col2_l6_label",
      "label": "Link 6 label",
      "default": "Zodiac Signs"
    },
    {
      "type": "url",
      "id": "col2_l6_url",
      "label": "Link 6 URL"
    },
    {
      "type": "text",
      "id": "col2_l7_label",
      "label": "Link 7 label (optional)"
    },
    {
      "type": "url",
      "id": "col2_l7_url",
      "label": "Link 7 URL (optional)"
    },
    {
      "type": "header",
      "content": "Shop Dropdown — Column 3"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Heading",
      "default": "Fav People"
    },
    {
      "type": "text",
      "id": "col3_l1_label",
      "label": "Link 1 label",
      "default": "Matching"
    },
    {
      "type": "url",
      "id": "col3_l1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "col3_l2_label",
      "label": "Link 2 label",
      "default": "Couples"
    },
    {
      "type": "url",
      "id": "col3_l2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "col3_cta1_label",
      "label": "CTA 1 label",
      "default": "Bulk Orders"
    },
    {
      "type": "url",
      "id": "col3_cta1_url",
      "label": "CTA 1 URL"
    },
    {
      "type": "text",
      "id": "col3_cta2_label",
      "label": "CTA 2 label",
      "default": "Gift Card"
    },
    {
      "type": "url",
      "id": "col3_cta2_url",
      "label": "CTA 2 URL"
    },
    {
      "type": "header",
      "content": "Icon Links"
    },
    {
      "type": "url",
      "id": "account_url",
      "label": "Account / Login URL"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist URL"
    },
    {
      "type": "header",
      "content": "Social Links (shown in mobile menu)"
    },
    {
      "type": "text",
      "id": "social_instagram",
      "label": "Instagram URL",
      "default": "https://instagram.com/fitkaarclothing"
    },
    {
      "type": "text",
      "id": "social_facebook",
      "label": "Facebook URL",
      "default": "https://facebook.com/fitkaarclothing"
    },
    {
      "type": "text",
      "id": "social_whatsapp",
      "label": "WhatsApp URL",
      "default": "https://wa.me/919354478146"
    },
    {
      "type": "text",
      "id": "social_youtube",
      "label": "YouTube URL",
      "default": "https://youtube.com/@fitkaarclothing"
    },
    {
      "type": "header",
      "content": "Free Gift (Cart)"
    },
    {
      "type": "text",
      "id": "free_gift_variant_id",
      "label": "Free Gift Variant ID",
      "info": "Shopify variant ID of the free T-shirt product (must be priced ₹0 in admin). Leave blank to disable auto-add."
    }
  ]
}
{% endschema %}

<header
  class="site-header"
  style="background: #fff; padding: 12px 0; border-bottom: 1px solid #e5e5e5; color: var(--color-primary);"
  x-data="{ mobileMenuOpen: false, shopOpen: false, mobNavPage: 'main', mobAccE: false, mobAccT: false, mobAccV: false, cartDrawerOpen: false, cartLoading: false, cartMini: null, drawerRecs: [], freeGiftManaging: false, syncBodyScroll() { document.body.style.overflow = (this.mobileMenuOpen || this.cartDrawerOpen) ? 'hidden' : ''; var wa = document.querySelector('.fk-whatsapp-float'); if (wa) wa.style.display = this.cartDrawerOpen ? 'none' : ''; }, closeMobileMenu() { this.mobileMenuOpen = false; this.mobNavPage = 'main'; this.mobAccE = false; this.mobAccT = false; this.mobAccV = false; this.syncBodyScroll(); }, openShopPanel() { this.mobNavPage = 'shop'; }, backToMainNav() { this.mobNavPage = 'main'; this.mobAccE = false; this.mobAccT = false; this.mobAccV = false; }, async refreshCartDrawer() { this.cartLoading = true; try { const r = await fetch('/cart.js'); this.cartMini = await r.json(); } catch (e) { this.cartMini = null; } finally { this.cartLoading = false; } }, async openCartDrawer() { if (window.__fkCloseSearch) window.__fkCloseSearch(); this.mobileMenuOpen = false; this.cartDrawerOpen = true; this.syncBodyScroll(); await this.refreshCartDrawer(); await this.manageFreeGift(); this.fetchDrawerRecs(); }, closeCartDrawer() { this.cartDrawerOpen = false; this.syncBodyScroll(); }, cartIconClick(e) { e.preventDefault(); this.openCartDrawer(); }, async onCartUpdated() { if (!this.cartDrawerOpen) return; await this.refreshCartDrawer(); await this.manageFreeGift(); this.fetchDrawerRecs(); }, async manageFreeGift() { const variantId = Number('{{ section.settings.free_gift_variant_id | default: 0 }}'); if (!variantId || this.freeGiftManaging || !this.cartMini) return; this.freeGiftManaging = true; try { const threshold = 400000; const giftItem = this.cartMini.items.find(i => i.variant_id == variantId); const nonGiftTotal = this.cartMini.items.filter(i => i.variant_id != variantId).reduce((s, i) => s + i.final_line_price, 0); if (nonGiftTotal >= threshold && !giftItem) { await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: variantId, quantity: 1, properties: { _free_gift: 'yes' } }) }); const r = await fetch('/cart.js'); this.cartMini = await r.json(); } else if (nonGiftTotal < threshold && giftItem) { await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: giftItem.key, quantity: 0 }) }); const r = await fetch('/cart.js'); this.cartMini = await r.json(); } } finally { this.freeGiftManaging = false; } }, async fetchDrawerRecs() { if (!this.cartMini || !this.cartMini.items || !this.cartMini.items.length) return; const productId = this.cartMini.items[0].product_id; const cartIds = new Set(this.cartMini.items.map(i => i.product_id)); const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'; const map = p => { const raw = (p.images && p.images[0] && p.images[0].src) ? p.images[0].src : (typeof p.featured_image === 'string' && p.featured_image) ? p.featured_image : (p.featured_image && p.featured_image.src) ? p.featured_image.src : ''; const img = raw ? (raw.startsWith('//') ? 'https:' + raw : raw) : BLANK; const price = p.variants && p.variants[0] ? Math.round(parseFloat(p.variants[0].price) / 100) : 0; return { id: p.id, url: '/products/' + p.handle, title: p.title, price, img }; }; try { const r = await fetch('/recommendations/products.json?product_id=' + productId + '&limit=8'); if (r.ok) { const d = await r.json(); const recs = (d.products || []).filter(p => !cartIds.has(p.id)).slice(0, 4); if (recs.length) { this.drawerRecs = recs.map(map); return; } } } catch(e) {} try { const r2 = await fetch('/collections/all/products.json?limit=12'); if (r2.ok) { const d2 = await r2.json(); this.drawerRecs = (d2.products || []).filter(p => !cartIds.has(p.id)).slice(0, 4).map(map); } } catch(e) {} }, async changeQty(key, qty) { if (qty < 0) return; try { const r = await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: key, quantity: qty }) }); if (!r.ok) throw new Error('cart change failed'); this.cartMini = await r.json(); const cnt = this.cartMini ? this.cartMini.item_count : 0; document.querySelectorAll('.cart-count').forEach(function(el) { el.textContent = cnt; el.style.display = cnt > 0 ? 'flex' : 'none'; }); if (window.fitkaarCart) { window.fitkaarCart.cart = this.cartMini; } await this.manageFreeGift(); } catch(e) { console.error('changeQty error', e); } }, sizeOnly(vt) { if (!vt || vt === 'Default Title') return ''; const parts = vt.split(' / '); return parts[parts.length - 1]; }, sizeLabel(item) { if (item.options_with_values && item.options_with_values.length) { const sizes = item.options_with_values.filter(function(o) { const n = (o.name || '').toLowerCase(); return !n.includes('color') && !n.includes('colour') && !n.includes('type'); }).map(function(o) { return o.value; }); if (sizes.length) return sizes.join(' / '); } return this.sizeOnly(item.variant_title); }, formatCartMoney(cents) { if (window.Shopify && typeof Shopify.formatMoney === 'function') return Shopify.formatMoney(cents); const n = (Number(cents) || 0) / 100; return '₹' + n.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); } }"
  @cart:updated.window="onCartUpdated()"
>
  <div class="container fk-header-row">

    <!-- LEFT: hamburger + small logo image (mobile) | full logo (desktop) -->
    <div class="fk-header-left">
      <button type="button" class="md:hidden p-2 -ml-2 fk-header-burger" @click="mobileMenuOpen = !mobileMenuOpen; cartDrawerOpen = false; if (mobileMenuOpen) { mobNavPage = 'main'; mobAccE = false; mobAccT = false; mobAccV = false } syncBodyScroll()" aria-label="Open menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M3 12h18M3 6h18M3 18h18" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <!-- Mobile-only: just the circular logo image -->
      <a href="/" class="fk-mobile-logo" aria-label="Fitkaar home">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 280 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" style="height: 34px; width: auto; object-fit: contain;">
        {% else %}
          <img src="{{ 'image copy 5.png' | asset_url }}" alt="{{ shop.name | escape }}" style="height: 34px; width: auto; object-fit: contain;">
        {% endif %}
      </a>

      <!-- Desktop-only: image + FITKAAR wordmark -->
      <a href="/" class="hidden md:flex items-center gap-4" style="text-decoration: none;">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" style="height: 50px; width: auto; object-fit: contain;">
        {% else %}
          <img src="{{ 'image copy 5.png' | asset_url }}" alt="{{ shop.name | escape }}" style="height: 50px; width: auto; object-fit: contain;">
        {% endif %}
        <span class="h2" style="font-family: var(--font-heading); font-size: 30px; font-weight: 700; color: var(--color-primary); margin: 0; text-decoration: none;">{{ section.settings.store_name | default: 'FITKAAR™' }}</span>
      </a>
    </div>

    <!-- CENTER (mobile only): FITKAAR wordmark, absolutely centered -->
    <a href="/" class="md:hidden fk-header-center" style="text-decoration: none;" aria-label="Fitkaar home">
      <span style="font-family: var(--font-heading); font-size: 22px; font-weight: 800; color: var(--color-primary); letter-spacing: 1px;">{{ section.settings.store_name | default: 'FITKAAR™' }}</span>
    </a>

    <!-- DESKTOP NAV -->
    {%- assign _nav_customise_url = section.settings.nav_customise_url | default: '/pages/process' -%}
    {%- assign _nav_shop_url = section.settings.nav_shop_url | default: '/collections/all' -%}
    {%- assign _nav_about_url = section.settings.nav_about_url | default: '/pages/about-us' -%}
    {%- assign _nav_contact_url = section.settings.nav_contact_url | default: '/pages/contact-us' -%}
    {%- assign _nav_account_url = section.settings.account_url | default: '/account/login' -%}
    {%- assign _nav_wishlist_url = section.settings.wishlist_url | default: '/pages/wishlist' -%}
    {%- assign _p = request.path -%}
    {%- if _p == '/' -%}{%- assign _nav = 'home' -%}
    {%- elsif _p contains '/collections' or _p contains '/products' -%}{%- assign _nav = 'shop' -%}
    {%- elsif _nav_customise_url != blank and _p == _nav_customise_url -%}{%- assign _nav = 'customise' -%}
    {%- elsif _nav_about_url != blank and _p == _nav_about_url -%}{%- assign _nav = 'about' -%}
    {%- elsif _nav_contact_url != blank and _p == _nav_contact_url -%}{%- assign _nav = 'contact' -%}
    {%- endif -%}
    <nav class="hidden md:flex gap-8 fk-desktop-nav">
      <a href="/" class="fk-nav-link{% if _nav == 'home' %} fk-nav-link--active{% endif %}">{{ section.settings.nav_home_label | default: 'Home' }}</a>
      <a href="{{ _nav_customise_url }}" class="fk-nav-link{% if _nav == 'customise' %} fk-nav-link--active{% endif %}">{{ section.settings.nav_customise_label | default: 'Customise' }}</a>

      <!-- Shop dropdown (hover on desktop) -->
      <div class="fk-shop-trigger" @mouseenter="shopOpen = true" @mouseleave="shopOpen = false">
        <a href="{{ _nav_shop_url }}" class="fk-nav-link fk-shop-link{% if _nav == 'shop' %} fk-nav-link--active{% endif %}">
          {{ section.settings.nav_shop_label | default: 'Shop' }}
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="margin-left: 4px;"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="fk-shop-dropdown" x-show="shopOpen" x-transition.opacity.duration.150ms style="display: none;">
          <a href="{{ _nav_shop_url }}" class="fk-shop-all-link">{{ section.settings.nav_shop_label | default: 'Shop' }} All →</a>
          <div class="fk-shop-cols">
            <div class="fk-shop-col">
              <div class="fk-shop-col-head">{{ section.settings.col1_title | default: 'Essentials' }}</div>
              {%- if section.settings.col1_l1_label != blank -%}<a href="{{ section.settings.col1_l1_url | default: '/collections/everyday' }}">{{ section.settings.col1_l1_label }}</a>{%- endif -%}
              {%- if section.settings.col1_l2_label != blank -%}<a href="{{ section.settings.col1_l2_url | default: '/collections/your-aesthetic' }}">{{ section.settings.col1_l2_label }}</a>{%- endif -%}
              {%- if section.settings.col1_l3_label != blank -%}<a href="{{ section.settings.col1_l3_url | default: '/collections/basics' }}">{{ section.settings.col1_l3_label }}</a>{%- endif -%}
              {%- if section.settings.col1_l4_label != blank -%}<a href="{{ section.settings.col1_l4_url | default: '/pages/process' }}">{{ section.settings.col1_l4_label }}</a>{%- endif -%}
              {%- if section.settings.col1_l5_label != blank -%}<a href="{{ section.settings.col1_l5_url | default: '#' }}">{{ section.settings.col1_l5_label }}</a>{%- endif -%}
            </div>
            <div class="fk-shop-col">
              <div class="fk-shop-col-head">{{ section.settings.col2_title | default: 'Collections' }}</div>
              {%- if section.settings.col2_l1_label != blank -%}<a href="{{ section.settings.col2_l1_url | default: '/collections/pride-month-collection' }}">{{ section.settings.col2_l1_label }}</a>{%- endif -%}
              {%- if section.settings.col2_l2_label != blank -%}<a href="{{ section.settings.col2_l2_url | default: '/collections/food-and-drinks' }}">{{ section.settings.col2_l2_label }}</a>{%- endif -%}
              {%- if section.settings.col2_l3_label != blank -%}<a href="{{ section.settings.col2_l3_url | default: '/collections/sports-and-fitness' }}">{{ section.settings.col2_l3_label }}</a>{%- endif -%}
              {%- if section.settings.col2_l4_label != blank -%}<a href="{{ section.settings.col2_l4_url | default: '/collections/work-and-hobbies' }}">{{ section.settings.col2_l4_label }}</a>{%- endif -%}
              {%- if section.settings.col2_l5_label != blank -%}<a href="{{ section.settings.col2_l5_url | default: '/collections/pun-intended' }}">{{ section.settings.col2_l5_label }}</a>{%- endif -%}
              {%- if section.settings.col2_l6_label != blank -%}<a href="{{ section.settings.col2_l6_url | default: '/collections/zodiac-signs' }}">{{ section.settings.col2_l6_label }}</a>{%- endif -%}
              {%- if section.settings.col2_l7_label != blank -%}<a href="{{ section.settings.col2_l7_url | default: '#' }}">{{ section.settings.col2_l7_label }}</a>{%- endif -%}
            </div>
            <div class="fk-shop-col">
              <div class="fk-shop-col-head">{{ section.settings.col3_title | default: 'Fav People' }}</div>
              {%- if section.settings.col3_l1_label != blank -%}<a href="{{ section.settings.col3_l1_url | default: '/collections/matching' }}">{{ section.settings.col3_l1_label }}</a>{%- endif -%}
              {%- if section.settings.col3_l2_label != blank -%}<a href="{{ section.settings.col3_l2_url | default: '/collections/couples' }}">{{ section.settings.col3_l2_label }}</a>{%- endif -%}
              {%- if section.settings.col3_cta1_label != blank -%}<a href="{{ section.settings.col3_cta1_url | default: '/pages/bulk-orders' }}" class="fk-shop-col-cta">{{ section.settings.col3_cta1_label }}</a>{%- endif -%}
              {%- if section.settings.col3_cta2_label != blank -%}<a href="{{ section.settings.col3_cta2_url | default: '/products/gift-card' }}" class="fk-shop-col-cta">{{ section.settings.col3_cta2_label }}</a>{%- endif -%}
            </div>
          </div>
        </div>
      </div>

      <a href="{{ _nav_about_url }}" class="fk-nav-link{% if _nav == 'about' %} fk-nav-link--active{% endif %}">{{ section.settings.nav_about_label | default: 'About Us' }}</a>
      <a href="{{ _nav_contact_url }}" class="fk-nav-link{% if _nav == 'contact' %} fk-nav-link--active{% endif %}">{{ section.settings.nav_contact_label | default: 'Contact' }}</a>
    </nav>

    <!-- RIGHT: icons (search, login, wishlist, cart) -->
    <div class="header-icons fk-header-right">
      <button type="button" class="icon-search" aria-label="Search" onclick="window.__fkOpenSearch && window.__fkOpenSearch()" style="background: none; border: none; padding: 0; cursor: pointer; display: inline-flex; align-items: center; color: var(--color-primary);">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

