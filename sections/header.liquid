  <template x-teleport="body">
  <div
    class="fk-cart-overlay"
    x-show="cartDrawerOpen"
    style="display: none;"
    x-transition.opacity.duration.280ms
    @click.self="closeCartDrawer()"
    @keydown.escape.window="closeCartDrawer()"
  >
    <aside
      class="fk-cart-drawer flex flex-col"
      role="dialog"
      aria-modal="true"
      aria-label="Cart"
      @click.stop
      x-show="cartDrawerOpen"
      style="display: none;"
      x-transition:enter="fk-cart-drawer-enter"
      x-transition:enter-start="fk-cart-drawer-enter-start"
      x-transition:enter-end="fk-cart-drawer-enter-end"
      x-transition:leave="fk-cart-drawer-leave"
      x-transition:leave-start="fk-cart-drawer-leave-start"
      x-transition:leave-end="fk-cart-drawer-leave-end"
    >
      <!-- Header -->
      <div class="fk-cart-drawer-hd">
        <h2 class="fk-cart-drawer-title">Your cart</h2>
        <button type="button" style="color: var(--color-primary); background:none; border:none; cursor:pointer; padding:4px;" @click="closeCartDrawer()" aria-label="Close cart">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <!-- Free T-shirt reward progress bar -->
      <div class="fk-cart-reward" x-show="!cartLoading && cartMini && cartMini.item_count > 0" x-cloak>
        <p class="fk-cart-reward__msg" x-show="cartMini && cartMini.total_price / 100 < 4000">
          🎽 Spend <strong x-text="'₹' + (4000 - Math.round(cartMini.total_price / 100))"></strong> more to unlock a <strong>FREE T-shirt</strong>!
        </p>
        <p class="fk-cart-reward__msg fk-cart-reward__won" x-show="cartMini && cartMini.total_price / 100 >= 4000" style="display:none;">
          🎉 You've unlocked a <strong>FREE T-shirt</strong>!
        </p>
        <div class="fk-cart-reward__track">
          <div class="fk-cart-reward__fill" :style="'width:' + Math.min(100, cartMini ? Math.round(cartMini.total_price / 4000) : 0) + '%'"></div>
        </div>
      </div>

      <!-- Body: items + "You may also like" -->
      <div class="fk-cart-drawer-body">
        <p x-show="cartLoading" x-cloak class="fk-cart-empty" style="padding: 2rem;">Loading…</p>
        <p x-show="!cartLoading && cartMini && cartMini.item_count === 0" x-cloak class="fk-cart-empty">Your cart is empty.<br><a href="/collections/all" @click="closeCartDrawer()" style="color:var(--color-primary);font-weight:700;">Start Shopping →</a></p>

        <div x-show="!cartLoading && cartMini && cartMini.item_count > 0" x-cloak>
          <!-- Cart items -->
          <template x-for="(item, idx) in cartMini.items" :key="item.key || idx">
            <div class="fk-cart-item">
              <a :href="item.url" @click="closeCartDrawer()" style="flex-shrink:0;">
                <img :src="(item.featured_image && item.featured_image.url) ? item.featured_image.url : (item.image || '')" :alt="item.product_title" width="88" height="88" loading="lazy">
              </a>
              <div class="fk-cart-item-meta">
                <a :href="item.url" @click="closeCartDrawer()" style="text-decoration:none;">
                  <span class="fk-cart-item-title" x-text="item.product_title"></span>
                </a>
                <span class="fk-cart-item-size" x-show="sizeLabel(item)" x-text="sizeLabel(item)"></span>
                <template x-if="item.properties && Object.keys(item.properties).filter(k => !k.startsWith('_')).length > 0">
                  <div class="fk-cart-item-props">
                    <template x-for="[k,v] in Object.entries(item.properties).filter(([k]) => !k.startsWith('_'))" :key="k">
                      <div class="fk-cart-item-prop"><span class="fk-cart-prop-key" x-text="k + ':'"></span> <span class="fk-cart-prop-val" x-text="v"></span></div>
                    </template>
                  </div>
                </template>
                <div class="fk-cart-item-prices">
                  <span class="fk-cart-item-price" x-text="'₹' + Math.round(item.final_price / 100) + '/-'"></span>
                  <span class="fk-cart-item-mrp" x-show="item.compare_at_price && item.compare_at_price > item.final_price" x-text="'₹' + Math.round(item.compare_at_price / 100)"></span>
                  <span class="fk-cart-item-off" x-show="item.compare_at_price && item.compare_at_price > item.final_price" x-text="Math.round((1 - item.final_price / item.compare_at_price) * 100) + '% OFF'"></span>
                </div>
                <div class="fk-cart-item-actions">
                  <div class="fk-cart-item-qty">
                    <button type="button" @click="changeQty(item.key, item.quantity - 1)" aria-label="Decrease quantity">−</button>
                    <span x-text="item.quantity"></span>
                    <button type="button" @click="changeQty(item.key, item.quantity + 1)" aria-label="Increase quantity">+</button>
                  </div>
                  <button type="button" class="fk-cart-item-delete" @click="changeQty(item.key, 0)" aria-label="Remove item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </div>
            </div>
          </template>

          <!-- You may also like -->
          <div x-show="drawerRecs.length > 0" class="fk-cart-recs" x-cloak>
            <div class="fk-cart-recs__title">You may also like</div>
            <div class="fk-cart-recs__scroll">
              <template x-for="r in drawerRecs" :key="r.id">
                <a :href="r.url" class="fk-cart-rec-card" @click="closeCartDrawer()">
                  <img :src="r.img" :alt="r.title" width="118" height="118" loading="lazy">
                  <div class="fk-cart-rec-card-meta">
                    <div class="fk-cart-rec-card-title" x-text="r.title"></div>
                    <div class="fk-cart-rec-card-price" x-text="'₹' + r.price + '/-'"></div>
                  </div>
                </a>
              </template>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="fk-cart-footer" x-show="!cartLoading && cartMini && cartMini.item_count > 0" style="display: none;">
        <div class="fk-cart-subtotal">
          <span>Subtotal</span>
          <span x-text="cartMini ? formatCartMoney(cartMini.total_price) : ''"></span>
        </div>
        <div class="fk-cart-actions">
          <a href="{{ routes.cart_url }}" class="fk-cart-btn fk-cart-btn--ghost" @click="closeCartDrawer()">View full cart</a>
          <a href="/checkout" class="fk-cart-btn fk-cart-btn--primary">Checkout</a>
        </div>
      </div>
    </aside>
  </div>
  </template>
</header>
