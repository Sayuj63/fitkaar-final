{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ]
}
{% endschema %}

<header class="site-header" style="background: #fff; padding: 15px 0; border-bottom: 1px solid #e5e5e5; position: sticky; top: 0; z-index: 50;" x-data="{ mobileMenuOpen: false }">
  <div class="container flex justify-between items-center">
    
    <!-- Mobile Hamburger Button -->
    <button type="button" class="md:hidden p-2 -ml-2" @click="mobileMenuOpen = !mobileMenuOpen">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12h18M3 6h18M3 18h18" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <!-- Logo -->
    <div class="logo">
      <a href="/" class="flex items-center gap-4">
        <img src="{{ 'image copy 5.png' | asset_url }}" alt="Fitkaar Logo" style="height: 50px; width: auto; object-fit: contain;">
        <span class="h2" style="font-family: var(--font-heading); font-size: 20px; font-weight: 800; color: var(--color-primary); margin: 0;">FITKAAR</span>
      </a>
    </div>

    <!-- Navigation (Desktop) -->
    <nav class="hidden md:flex gap-8">
      {% for link in linklists.main-menu.links %}
        {% assign link_title_lower = link.title | downcase %}
        {% unless link_title_lower contains 'about' %}
          <a href="{{ link.url }}" class="text-base hover:text-primary uppercase font-bold" style="font-family: var(--font-heading); color: #000; text-decoration: none;">{{ link.title }}</a>
        {% endunless %}
      {% endfor %}
      <a href="/pages/about-us" class="text-base hover:text-primary uppercase font-bold" style="font-family: var(--font-heading); color: #000; text-decoration: none;">About Us</a>
    </nav>

    <!-- Icons -->
    <div class="header-icons flex gap-4 items-center">
      <a href="/search" class="icon-search">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <!-- Wishlist Icon -->
      <a href="/pages/wishlist" class="icon-wishlist" aria-label="Wishlist">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <!-- Cart Icon with Alpine.js logic for count -->
      <a href="/cart" class="icon-cart relative" id="cart-icon-bubble">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z" fill="currentColor"/><path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z" fill="currentColor"/><path d="M1 1H5L7.68 14.39C7.77144 14.8504 8.02191 15.264 8.38755 15.5583C8.75318 15.8526 9.2107 16.009 9.68 16H19.4C19.8693 16.009 20.3268 15.8526 20.6925 15.5583C21.0581 15.264 21.3086 14.8504 21.4 14.39L23 6H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <div class="cart-count-bubble cart-count" style="background-color: var(--color-secondary); color: white; position: absolute; top: -8px; right: -8px; border-radius: 50%; width: 20px; height: 20px; display: {% if cart.item_count > 0 %}flex{% else %}none{% endif %}; align-items: center; justify-content: center; font-size: 10px; font-weight: bold;">
          {{ cart.item_count }}
        </div>
      </a>
    </div>
  </div>




  <style>
    /* Custom Slide Animation Classes */
    .mobile-menu-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100vw;
      height: 100vh;
      z-index: 200; /* High z-index */
      display: flex;
    }
    
    .mobile-menu-panel {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 100vh;
      background-color: #ffffff;
      z-index: 201;
      will-change: transform;
    }

    /* Transition Utilities */
    .slide-transition {
      transition: transform 0.3s ease-in-out !important;
    }
    
    .slide-closed {
      transform: translateX(-100%) !important;
    }
    
    .slide-open {
      transform: translateX(0) !important;
    }
    
    .fade-transition {
      transition: opacity 0.3s linear !important;
    }
    
    .fade-in {
      opacity: 1 !important;
    }
    
    .fade-out {
      opacity: 0 !important;
    }
  </style>

  <!-- Mobile Menu Drawer (Full Screen, Left Slide) -->
  <div class="mobile-menu-overlay md:hidden" x-show="mobileMenuOpen" style="display: none;" 
       x-transition:enter="fade-transition" 
       x-transition:enter-start="fade-out" 
       x-transition:enter-end="fade-in" 
       x-transition:leave="fade-transition" 
       x-transition:leave-start="fade-in" 
       x-transition:leave-end="fade-out">
     
    <!-- White Background Panel (Full Screen) -->
    <div class="mobile-menu-panel flex flex-col"
         x-show="mobileMenuOpen"
         x-transition:enter="slide-transition" 
         x-transition:enter-start="slide-closed" 
         x-transition:enter-end="slide-open" 
         x-transition:leave="slide-transition" 
         x-transition:leave-start="slide-open" 
         x-transition:leave-end="slide-closed">
         
         <!-- Header inside Menu -->
         <div class="flex justify-between items-center p-6 border-b border-gray-100 bg-white">
            <span class="h2" style="font-family: var(--font-heading); font-size: 24px; font-weight: 800; color: var(--color-primary);">FITKAAR</span>
            
            <button @click="mobileMenuOpen = false" class="p-2 -mr-2 text-black hover:opacity-70 transition-opacity">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
         </div>

         <!-- Navigation Links -->
         <nav class="flex flex-col flex-1 p-6 gap-6 overflow-y-auto bg-white">
            {% for link in linklists.main-menu.links %}
              {% assign link_title_lower = link.title | downcase %}
              {% unless link_title_lower contains 'about' %}
                <a href="{{ link.url }}" 
                   class="text-2xl font-bold uppercase text-black hover:text-secondary transition-colors"
                   style="font-family: var(--font-heading); letter-spacing: 1px;">
                   {{ link.title }}
                </a>
              {% endunless %}
            {% endfor %}
            <a href="/pages/about-us" 
               class="text-2xl font-bold uppercase text-black hover:text-secondary transition-colors"
               style="font-family: var(--font-heading); letter-spacing: 1px;">
               About Us
            </a>
         </nav>
    </div>
  </div>
</header>
