{% schema %}
{
  "name": "Hero Slideshow",
  "settings": [
    {
      "type": "range",
      "id": "slide_duration",
      "label": "Slide Duration (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height (vh)",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 100
    },
    {
      "type": "select",
      "id": "mobile_aspect",
      "label": "Mobile aspect ratio",
      "info": "Controls the shape of the banner on phones.",
      "options": [
        { "value": "1/1", "label": "1:1 (square)" },
        { "value": "4/5", "label": "4:5 (portrait)" },
        { "value": "9/16", "label": "9:16 (tall)" },
        { "value": "16/9", "label": "16:9 (landscape)" }
      ],
      "default": "1/1"
    }
  ],
  "blocks": [
    {
      "type": "image_slide",
      "name": "Image Slide",
      "settings": [
        {
          "type": "header",
          "content": "Desktop"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Landscape image for laptop / desktop."
        },
        {
          "type": "header",
          "content": "Mobile"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Square (1:1) or portrait image for phones. If empty, desktop image is used."
        },
        {
          "type": "header",
          "content": "Common"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Fitkaar hero slide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link (optional)"
        }
      ]
    },
    {
      "type": "video_slide",
      "name": "Video Slide",
      "settings": [
        {
          "type": "header",
          "content": "Desktop"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Desktop video",
          "info": "Upload an mp4/mov for laptop / desktop."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Desktop poster image",
          "info": "Shown before the video plays on desktop."
        },
        {
          "type": "header",
          "content": "Mobile"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Mobile video",
          "info": "Optional vertical/square video for phones. If empty, desktop video is used."
        },
        {
          "type": "image_picker",
          "id": "poster_mobile",
          "label": "Mobile poster image",
          "info": "Shown before the video plays on phones. If empty, desktop poster is used."
        },
        {
          "type": "header",
          "content": "Playback"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay (muted)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "loop",
          "label": "Loop",
          "default": true
        },
        {
          "type": "header",
          "content": "Common"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Fitkaar hero video"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "blocks": [
        { "type": "image_slide" },
        { "type": "image_slide" },
        { "type": "image_slide" }
      ]
    }
  ]
}
{% endschema %}

<style>
#HeroSlideshow-{{ section.id }} {
  position: relative;
  width: 100%;
  height: {{ section.settings.desktop_height }}vh;
  max-height: 900px;
  overflow: hidden;
  background: #000;
}

#HeroSlideshow-{{ section.id }} .hero-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 1s ease-in-out;
}

#HeroSlideshow-{{ section.id }} .hero-slide.active {
  opacity: 1;
}

#HeroSlideshow-{{ section.id }} .hero-slide picture,
#HeroSlideshow-{{ section.id }} .hero-slide img,
#HeroSlideshow-{{ section.id }} .hero-slide video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
}

#HeroSlideshow-{{ section.id }} .hero-slide a {
  display: block;
  width: 100%;
  height: 100%;
}

#HeroSlideshow-{{ section.id }} .hero-dots {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12px;
  z-index: 10;
}

#HeroSlideshow-{{ section.id }} .hero-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.5);
  cursor: pointer;
  transition: background-color 0.3s ease;
  border: 1px solid rgba(255, 255, 255, 0.8);
}

#HeroSlideshow-{{ section.id }} .hero-dot.active {
  background-color: rgba(255, 255, 255, 1);
}

#HeroSlideshow-{{ section.id }} .hero-dot:hover {
  background-color: rgba(255, 255, 255, 0.8);
}

#HeroSlideshow-{{ section.id }} .hero-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #fff;
  font-family: var(--font-heading);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  opacity: 0.7;
}

@media (max-width: 768px) {
  #HeroSlideshow-{{ section.id }} {
    height: auto;
    max-height: none;
    aspect-ratio: {{ section.settings.mobile_aspect | default: '1/1' | replace: '/', ' / ' }};
  }
  #HeroSlideshow-{{ section.id }} .hero-dots {
    bottom: 20px;
    gap: 8px;
  }
  #HeroSlideshow-{{ section.id }} .hero-dot {
    width: 8px;
    height: 8px;
  }
}
</style>

<div class="hero-slideshow hero-fade-slideshow" id="HeroSlideshow-{{ section.id }}">
  {%- if section.blocks.size == 0 -%}
    <div class="hero-empty">Add a slide from the theme editor</div>
  {%- else -%}
    {%- for block in section.blocks -%}
      {%- assign is_active = '' -%}
      {%- if forloop.first -%}{%- assign is_active = ' active' -%}{%- endif -%}

      {%- case block.type -%}
        {%- when 'image_slide' -%}
          <div class="hero-slide{{ is_active }}" data-index="{{ forloop.index0 }}" data-type="image" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {%- if block.settings.image != blank or block.settings.image_mobile != blank -%}
              {%- assign desktop_img = block.settings.image | default: block.settings.image_mobile -%}
              {%- assign mobile_img = block.settings.image_mobile | default: block.settings.image -%}
              <picture>
                <source
                  media="(max-width: 768px)"
                  srcset="{{ mobile_img | image_url: width: 600 }} 600w,
                          {{ mobile_img | image_url: width: 900 }} 900w,
                          {{ mobile_img | image_url: width: 1200 }} 1200w"
                  sizes="100vw">
                <img
                  src="{{ desktop_img | image_url: width: 2000 }}"
                  srcset="{{ desktop_img | image_url: width: 800 }} 800w,
                          {{ desktop_img | image_url: width: 1200 }} 1200w,
                          {{ desktop_img | image_url: width: 1600 }} 1600w,
                          {{ desktop_img | image_url: width: 2000 }} 2000w"
                  sizes="100vw"
                  alt="{{ block.settings.alt | escape }}"
                  {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  width="{{ desktop_img.width }}"
                  height="{{ desktop_img.height }}">
              </picture>
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>

        {%- when 'video_slide' -%}
          <div class="hero-slide{{ is_active }}" data-index="{{ forloop.index0 }}" data-type="video" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}

            {%- assign has_video = false -%}
            {%- if block.settings.video != blank or block.settings.video_mobile != blank -%}
              {%- assign has_video = true -%}
            {%- endif -%}

            {%- assign desktop_poster = block.settings.poster | default: block.settings.poster_mobile -%}
            {%- assign mobile_poster  = block.settings.poster_mobile | default: block.settings.poster -%}

            {%- if has_video -%}
              {%- capture desktop_sources_json -%}
                [{% if block.settings.video != blank %}{% for s in block.settings.video.sources %}{"url":"{{ s.url }}","type":"{{ s.mime_type }}"}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
              {%- endcapture -%}
              {%- capture mobile_sources_json -%}
                [{% if block.settings.video_mobile != blank %}{% for s in block.settings.video_mobile.sources %}{"url":"{{ s.url }}","type":"{{ s.mime_type }}"}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
              {%- endcapture -%}

              <video
                class="hero-video"
                {% if block.settings.autoplay %}autoplay muted playsinline{% endif %}
                {% if block.settings.loop %}loop{% endif %}
                preload="none"
                data-hero-video
                data-desktop-sources='{{ desktop_sources_json | strip_newlines | strip }}'
                data-mobile-sources='{{ mobile_sources_json | strip_newlines | strip }}'
                {% if desktop_poster != blank %}data-desktop-poster="{{ desktop_poster | image_url: width: 2000 }}"{% endif %}
                {% if mobile_poster != blank %}data-mobile-poster="{{ mobile_poster | image_url: width: 1200 }}"{% endif %}>
              </video>
            {%- elsif desktop_poster != blank or mobile_poster != blank -%}
              <picture>
                {%- if mobile_poster != blank -%}
                  <source media="(max-width: 768px)" srcset="{{ mobile_poster | image_url: width: 1200 }}">
                {%- endif -%}
                <img src="{{ desktop_poster | default: mobile_poster | image_url: width: 2000 }}" alt="{{ block.settings.alt | escape }}">
              </picture>
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            {%- endif -%}

            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}

    <div class="hero-dots" data-hero-dots></div>
  {%- endif -%}
</div>

<script>
(function() {
  var root = document.getElementById('HeroSlideshow-{{ section.id }}');
  if (!root) return;
  var slides = root.querySelectorAll('.hero-slide');
  var dotsContainer = root.querySelector('[data-hero-dots]');
  if (!slides.length || !dotsContainer) return;

  var mq = window.matchMedia('(max-width: 768px)');

  function hydrateVideo(video) {
    if (!video || video.dataset.hydrated === 'true') return;
    var isMobile = mq.matches;
    var desktopSources = safeParse(video.dataset.desktopSources);
    var mobileSources  = safeParse(video.dataset.mobileSources);
    var sources = isMobile && mobileSources && mobileSources.length ? mobileSources : desktopSources;
    if (!sources || !sources.length) {
      sources = mobileSources && mobileSources.length ? mobileSources : desktopSources;
    }
    if (!sources || !sources.length) return;

    var poster = isMobile ? (video.dataset.mobilePoster || video.dataset.desktopPoster)
                          : (video.dataset.desktopPoster || video.dataset.mobilePoster);
    if (poster) video.setAttribute('poster', poster);

    while (video.firstChild) video.removeChild(video.firstChild);
    sources.forEach(function(s) {
      if (!s || !s.url) return;
      var el = document.createElement('source');
      el.src = s.url;
      if (s.type) el.type = s.type;
      video.appendChild(el);
    });
    try { video.load(); } catch (e) {}
    video.dataset.hydrated = 'true';
  }

  function safeParse(s) {
    if (!s) return null;
    try { return JSON.parse(s); } catch (e) { return null; }
  }

  slides.forEach(function(slide) {
    var v = slide.querySelector('[data-hero-video]');
    if (v) hydrateVideo(v);
  });

  mq.addEventListener ? mq.addEventListener('change', reHydrate) : mq.addListener(reHydrate);
  function reHydrate() {
    slides.forEach(function(slide) {
      var v = slide.querySelector('[data-hero-video]');
      if (!v) return;
      v.dataset.hydrated = 'false';
      hydrateVideo(v);
    });
  }

  var current = 0;
  var total = slides.length;
  var duration = {{ section.settings.slide_duration | default: 4 }} * 1000;
  var timer;

  for (var i = 0; i < total; i++) {
    var dot = document.createElement('div');
    dot.className = 'hero-dot' + (i === 0 ? ' active' : '');
    (function(idx) {
      dot.addEventListener('click', function() { goTo(idx); });
    })(i);
    dotsContainer.appendChild(dot);
  }
  var dots = dotsContainer.querySelectorAll('.hero-dot');

  function updateDots() {
    dots.forEach(function(d, idx) { d.classList.toggle('active', idx === current); });
  }

  function activate(idx) {
    slides.forEach(function(s) { s.classList.remove('active'); });
    slides[idx].classList.add('active');

    var v = slides[idx].querySelector('video');
    if (v) {
      try { v.currentTime = 0; v.play(); } catch (e) {}
    }
    slides.forEach(function(s, i) {
      if (i !== idx) {
        var other = s.querySelector('video');
        if (other) { try { other.pause(); } catch (e) {} }
      }
    });

    current = idx;
    updateDots();
  }

  function goTo(idx) {
    clearTimeout(timer);
    activate(idx);
    schedule();
  }

  function schedule() {
    clearTimeout(timer);
    var slide = slides[current];
    var vid = slide.querySelector('video');
    if (vid && !vid.paused) {
      var waitFor = isFinite(vid.duration) && vid.duration > 0 ? vid.duration * 1000 : duration;
      timer = setTimeout(next, Math.max(2000, waitFor));
    } else {
      timer = setTimeout(next, duration);
    }
  }

  function next() {
    activate((current + 1) % total);
    schedule();
  }

  schedule();
})();
</script>
