{% schema %}
{
  "name": "Hero Slideshow",
  "settings": [
    {
      "type": "range",
      "id": "slide_duration",
      "label": "Slide Duration (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow"
    }
  ]
}
{% endschema %}

<style>
.hero-fade-slideshow {
  position: relative;
  width: 100%;
  height: 100vh;
  max-height: 800px;
  overflow: hidden;
}

.hero-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 1s ease-in-out;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-slide.active {
  opacity: 1;
}

.hero-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
}

/* Ensure container maintains aspect ratio on mobile */
@media (max-width: 768px) {
  .hero-fade-slideshow {
    height: 60vh;
    max-height: 600px;
  }
}
</style>

<div class="hero-slideshow hero-fade-slideshow" id="heroSlideshow">
  <div class="hero-slide" data-index="0">
    <img src="https://cdn.shopify.com/s/files/1/0716/3373/1756/files/Home_page_1.png?v=1768768965" alt="Fitkaar Home 1" loading="eager">
  </div>
  <div class="hero-slide" data-index="1">
    <img src="https://cdn.shopify.com/s/files/1/0716/3373/1756/files/Home_page_2.png?v=1768768965" alt="Fitkaar Home 2">
  </div>
  <div class="hero-slide" data-index="2">
    <img src="https://cdn.shopify.com/s/files/1/0716/3373/1756/files/Home_page_3.png?v=1768768964" alt="Fitkaar Home 3">
  </div>
  <div class="hero-slide" data-index="3">
    <img src="https://cdn.shopify.com/s/files/1/0716/3373/1756/files/home_page_4.png?v=1768768964" alt="Fitkaar Home 4">
  </div>
  <div class="hero-slide" data-index="4" data-is-gif="true">
    <img src="https://cdn.shopify.com/s/files/1/0716/3373/1756/files/hero.gif?v=1766316556" alt="Fitkaar Hero GIF">
  </div>
  <div class="hero-slide" data-index="5">
    <img src="https://cdn.shopify.com/s/files/1/0716/3373/1756/files/Home_page_5.png?v=1768768964" alt="Fitkaar Home 5">
  </div>
  <div class="hero-slide" data-index="6">
    <img src="https://cdn.shopify.com/s/files/1/0716/3373/1756/files/Home_page_6.png?v=1768768964" alt="Fitkaar Home 6">
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const slides = document.querySelectorAll('#heroSlideshow .hero-slide');
  const totalSlides = slides.length;
  let currentSlide = 0;
  const duration = {{ section.settings.slide_duration | default: 4 }} * 1000;
  let slideTimer;
  let gifDuration = 0;
  const GIF_INDEX = 4; // Index of the GIF slide (5th slide, 0-indexed)

  // Show first slide
  if (slides.length > 0) {
    slides[0].classList.add('active');
  }

  // Function to detect GIF duration
  function getGifDuration(imgElement) {
    return new Promise((resolve) => {
      // Create a temporary canvas to analyze the GIF
      const img = new Image();
      img.src = imgElement.src;
      
      img.onload = function() {
        // For GIFs, we'll estimate based on file size and typical frame rates
        // Most GIFs are 10-15 frames at 10fps, so roughly 1-1.5 seconds
        // We'll use a safe default of 3 seconds to ensure it completes
        // You can adjust this value based on your specific GIF
        const estimatedDuration = 3000; // 3 seconds
        resolve(estimatedDuration);
      };
      
      img.onerror = function() {
        resolve(duration); // Fallback to normal duration
      };
    });
  }

  // Fade transition function
  async function nextSlide() {
    slides[currentSlide].classList.remove('active');
    currentSlide = (currentSlide + 1) % totalSlides;
    slides[currentSlide].classList.add('active');

    // Clear existing timer
    if (slideTimer) {
      clearTimeout(slideTimer);
    }

    // Check if current slide is the GIF
    if (currentSlide === GIF_INDEX) {
      const gifImg = slides[currentSlide].querySelector('img');
      const gifDuration = await getGifDuration(gifImg);
      
      // Wait for GIF to complete before transitioning
      slideTimer = setTimeout(nextSlide, gifDuration + 1000); // Add 1 second buffer
    } else {
      // Normal slide duration
      slideTimer = setTimeout(nextSlide, duration);
    }
  }

  // Start the slideshow
  slideTimer = setTimeout(nextSlide, duration);
});
</script>
