{%- comment -%}
  List Collections page — renders /collections as a styled grid.
  Replaces Shopify's default unstyled <ul> fallback.
{%- endcomment -%}

<section class="fk-collections-page">
  <div class="fk-collections-page__container">
    <header class="fk-collections-page__header">
      <p class="fk-collections-page__eyebrow">{{ section.settings.eyebrow | default: 'Shop' }}</p>
      <h1 class="fk-collections-page__title">{{ section.settings.title | default: 'All Collections' }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="fk-collections-page__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <div class="fk-collections-page__grid">
      {%- assign sort_by = section.settings.sort_by | default: 'manual' -%}
      {%- assign list = collections -%}
      {%- if sort_by == 'alphabetical' -%}
        {%- assign list = collections | sort: 'title' -%}
      {%- endif -%}

      {%- for collection in list -%}
        {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        {%- assign card_image = collection.image -%}
        {%- if card_image == blank and collection.products.first.featured_image -%}
          {%- assign card_image = collection.products.first.featured_image -%}
        {%- endif -%}

        <a class="fk-collection-card" href="{{ collection.url }}" aria-label="Shop {{ collection.title }}">
          <div class="fk-collection-card__media">
            {%- if card_image != blank -%}
              <img
                src="{{ card_image | image_url: width: 800 }}"
                srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 800 }} 800w, {{ card_image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 600px) 90vw, (max-width: 1024px) 45vw, 30vw"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="800"
                height="800">
            {%- else -%}
              <div class="fk-collection-card__placeholder" aria-hidden="true">
                <span>{{ collection.title | slice: 0 | upcase }}</span>
              </div>
            {%- endif -%}
            <span class="fk-collection-card__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
          </div>
          <div class="fk-collection-card__body">
            <h2 class="fk-collection-card__title">{{ collection.title }}</h2>
            <span class="fk-collection-card__cta">Shop now <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .fk-collections-page {
    background: #ffffff;
    padding: 56px 0 96px;
  }
  .fk-collections-page__container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .fk-collections-page__header {
    text-align: center;
    margin-bottom: 48px;
  }
  .fk-collections-page__eyebrow {
    font-family: var(--font-secondary, 'Raleway', sans-serif);
    font-size: 13px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-secondary, #71b6c8);
    margin: 0 0 14px;
    font-weight: 600;
  }
  .fk-collections-page__title {
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: clamp(34px, 6vw, 64px);
    font-weight: 900;
    color: var(--color-primary, #000c5b);
    letter-spacing: -0.01em;
    line-height: 1;
    margin: 0;
  }
  .fk-collections-page__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    color: #444;
    max-width: 560px;
    margin: 16px auto 0;
    line-height: 1.5;
  }

  .fk-collections-page__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  @media (max-width: 1023px) {
    .fk-collections-page__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (max-width: 600px) {
    .fk-collections-page__grid { grid-template-columns: 1fr; gap: 22px; }
    .fk-collections-page { padding: 36px 0 64px; }
    .fk-collections-page__header { margin-bottom: 32px; }
  }

  .fk-collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
    overflow: hidden;
    background: #f7f7f8;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    border: 1px solid #eceef1;
  }
  .fk-collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 38px -18px rgba(0, 12, 91, 0.35);
    border-color: var(--color-accent, #bfdbe3);
  }
  .fk-collection-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-accent, #bfdbe3);
  }
  .fk-collection-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .fk-collection-card:hover .fk-collection-card__media img {
    transform: scale(1.06);
  }
  .fk-collection-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-accent, #bfdbe3), var(--color-secondary, #71b6c8));
    color: #ffffff;
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: 72px;
    font-weight: 900;
  }
  .fk-collection-card__count {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-primary, #000c5b);
    font-family: var(--font-secondary, 'Raleway', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: 999px;
  }

  .fk-collection-card__body {
    padding: 18px 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .fk-collection-card__title {
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: 20px;
    font-weight: 800;
    color: var(--color-primary, #000c5b);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .fk-collection-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-secondary, 'Raleway', sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary, #71b6c8);
    white-space: nowrap;
    transition: gap 0.25s ease, color 0.25s ease;
  }
  .fk-collection-card:hover .fk-collection-card__cta {
    gap: 10px;
    color: var(--color-primary, #000c5b);
  }
  .fk-collection-card__cta svg { flex-shrink: 0; }

  @media (max-width: 600px) {
    .fk-collection-card__title { font-size: 18px; }
    .fk-collection-card__body { padding: 16px 16px 18px; }
  }
</style>

{% schema %}
{
  "name": "All Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "All Collections"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore our full range — every collection, hand-picked and 100% customisable."
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Sort collections by",
      "options": [
        { "value": "manual", "label": "Manual (Shopify Admin order)" },
        { "value": "alphabetical", "label": "Alphabetical (A → Z)" }
      ],
      "default": "manual"
    }
  ],
  "presets": [
    {
      "name": "All Collections"
    }
  ]
}
{% endschema %}
