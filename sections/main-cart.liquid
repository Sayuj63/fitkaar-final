<div class="container py-8 md:py-16 px-4 md:px-8 max-w-7xl mx-auto" x-data="cartPage()">
  <h1 class="text-3xl md:text-5xl font-bold mb-8 md:mb-12 text-center" style="font-family: var(--font-heading);">YOUR CART</h1>

  <template x-if="itemCount > 0">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      
      <!-- Cart Items List (Left Column) -->
      <div class="lg:col-span-8 space-y-6 md:space-y-8">
        <!-- Header Row (Desktop Only) -->
        <div class="hidden md:grid grid-cols-12 gap-4 border-b border-gray-200 pb-4 text-sm font-semibold tracking-wider text-gray-500 uppercase">
          <div class="col-span-6">Product</div>
          <div class="col-span-3 text-center">Quantity</div>
          <div class="col-span-3 text-right">Total</div>
        </div>

        <!-- Items Loop -->
        <template x-for="(item, index) in items" :key="item.key">
          <div class="grid grid-cols-3 md:grid-cols-12 gap-4 md:gap-6 items-center border-b border-gray-100 pb-6 last:border-0 relative" :class="{ 'opacity-50 pointer-events-none': loading }">
            
            <!-- Product Image & Info -->
            <div class="col-span-2 md:col-span-6 flex gap-4 md:gap-6">
              <a :href="item.url" class="shrink-0 w-20 h-24 md:w-28 md:h-36 bg-gray-100 rounded-md overflow-hidden relative">
                <img :src="item.image ? item.image : ''" :alt="item.title" class="w-full h-full object-cover">
              </a>
              <div class="flex flex-col justify-center">
                <a :href="item.url" class="font-bold text-base md:text-lg hover:underline transition-colors duration-200" x-text="item.product_title"></a>
                <p class="text-sm text-gray-500 mt-1" x-text="item.variant_title !== 'Default Title' ? item.variant_title : ''"></p>
                <div class="md:hidden mt-2 font-medium" x-text="formatMoney(item.original_line_price)"></div>
              </div>
            </div>

            <!-- Quantity Selector & Remove -->
            <div class="col-span-1 md:col-span-3 flex flex-col md:flex-row items-center justify-center gap-2">
              <div class="flex items-center border border-gray-300 rounded md:rounded-none h-10 w-full md:w-32 max-w-[100px] md:max-w-none">
                <button 
                  type="button"
                  @click="updateQuantity(index, item.quantity - 1)" 
                  class="w-8 md:w-10 h-full flex items-center justify-center hover:bg-gray-100 transition-colors"
                  aria-label="Decrease quantity"
                >−</button>
                <input 
                  type="number" 
                  x-model="item.quantity"
                  @change="updateQuantity(index, parseInt($el.value))"
                  min="0" 
                  class="flex-1 w-full text-center border-none p-0 focus:ring-0 text-sm md:text-base h-full [-moz-appearance:_textfield] [&::-webkit-inner-spin-button]:m-0 [&::-webkit-inner-spin-button]:appearance-none"
                >
                <button 
                  type="button" 
                  @click="updateQuantity(index, item.quantity + 1)" 
                  class="w-8 md:w-10 h-full flex items-center justify-center hover:bg-gray-100 transition-colors"
                  aria-label="Increase quantity"
                >+</button>
              </div>
              <button 
                @click="updateQuantity(index, 0)" 
                class="text-xs text-red-500 underline md:no-underline md:text-gray-400 md:hover:text-red-500 transition-colors md:absolute md:top-1/2 md:translate-y-[-50%] md:right-4 md:mt-0"
                :class="{'mt-2': true}"
              >
                <span class="md:hidden">Remove</span>
                <svg class="hidden md:block w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>

            <!-- Total Price (Desktop) -->
            <div class="col-span-3 text-right font-bold text-lg hidden md:block" x-text="formatMoney(item.original_line_price)"></div>
          </div>
        </template>
      </div>

      <!-- Order Summary (Right Column - Sticky) -->
      <div class="lg:col-span-4 mt-8 lg:mt-0">
        <div class="bg-gray-50 p-6 md:p-8 rounded-lg md:sticky md:top-32 shadow-sm border border-gray-100">
           <h2 class="text-xl md:text-2xl font-bold mb-6 pb-4 border-b border-gray-200">Order Summary</h2>
           
           <div class="flex justify-between items-center mb-4 text-gray-600">
              <span>Subtotal</span>
              <span class="font-bold text-black text-lg" x-text="formatMoney(window.cart.total_price)"></span> <!-- Fallback or x-text binding -->
              <span class="font-bold text-black text-lg" x-text="formatMoney(totalPrice)"></span>
           </div>
           
           <p class="text-sm text-gray-500 mb-8 italic">Shipping & taxes calculated at checkout</p>
           
           <!-- Checkout Actions -->
           <form action="{{ routes.cart_url }}" method="post" class="space-y-3">
             <button 
               type="submit" 
               name="checkout" 
               class="w-full bg-black text-white py-4 px-6 font-bold text-base md:text-lg hover:bg-gray-800 transition-all duration-300 transform hover:-translate-y-0.5 shadow-md hover:shadow-lg flex items-center justify-center gap-2"
               :disabled="loading"
               :class="{ 'opacity-75 cursor-wait': loading }"
             >
               <span x-show="!loading">PROCEED TO CHECKOUT</span>
               <span x-show="loading" class="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></span>
             </button>
             
             <!-- Payment Icons -->
             <div class="flex justify-center gap-2 pt-4 opacity-70 grayscale">
               <!-- Simple SVGs for generic cards -->
               <div class="h-6 w-10 bg-gray-200 rounded"></div>
               <div class="h-6 w-10 bg-gray-200 rounded"></div>
               <div class="h-6 w-10 bg-gray-200 rounded"></div>
             </div>
           </form>
        </div>
      </div>
    
    </div>
  </template>

  <!-- Empty Cart State -->
  <template x-if="itemCount === 0 && !initialLoading">
    <div class="text-center py-20 md:py-32 fadeIn">
       <div class="mb-6 opacity-30">
          <svg class="w-20 h-20 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
       </div>
       <h2 class="text-2xl font-bold mb-4">Your cart is current empty.</h2>
       <p class="text-gray-500 mb-8 max-w-md mx-auto">Looks like you haven't added any items to your cart yet.</p>
       <a href="/collections/all" class="inline-block bg-black text-white px-8 py-3 font-bold uppercase hover:bg-gray-800 transition-colors">Start Shopping</a>
    </div>
  </template>
</div>

<script>
  function cartPage() {
    return {
      items: [],
      itemCount: 0,
      totalPrice: 0,
      loading: false,
      initialLoading: true,

      init() {
        // Fetch cart data on load to ensure fresh state
        this.fetchCart();
      },

      fetchCart() {
        fetch(window.Shopify.routes.root + 'cart.js')
          .then(response => response.json())
          .then(cart => {
            this.items = cart.items;
            this.itemCount = cart.item_count;
            this.totalPrice = cart.total_price;
            this.initialLoading = false;
            
            // Update cart bubble count in header if it exists
            this.updateHeaderCartCount(cart.item_count);
          })
          .catch(error => console.error('Error fetching cart:', error));
      },

      updateQuantity(index, newQty) {
        if (newQty < 0) return;
        
        this.loading = true;
        const item = this.items[index];
        
        // Optimistic UI update (optional, but safer to wait for server response for price calculations)
        // For simplicity and accuracy with discounts/tiers, we rely on the server response.

        const body = JSON.stringify({
          line: index + 1, // Shopify uses 1-based index for line items
          quantity: newQty
        });

        fetch(window.Shopify.routes.root + 'cart/change.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: body
        })
        .then(response => response.json())
        .then(cart => {
          this.items = cart.items;
          this.itemCount = cart.item_count;
          this.totalPrice = cart.total_price;
          this.loading = false;
          this.updateHeaderCartCount(cart.item_count);
        })
        .catch(error => {
          console.error('Error updating cart:', error);
          this.loading = false;
        });
      },

      formatMoney(cents) {
        return 'Rs. ' + (cents / 100).toFixed(2);
      },
      
      updateHeaderCartCount(count) {
        // Look for common cart count selectors or dispatch an event
        const countElements = document.querySelectorAll('.cart-count-bubble span, [data-cart-count]');
        countElements.forEach(el => el.innerText = count);
        
        // Dispatch event for other components
        window.dispatchEvent(new CustomEvent('cart:updated', { detail: { count: count } }));
      }
    }
  }
</script>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
