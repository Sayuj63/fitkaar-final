<style>
  .cart-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .cart-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 40px;
    font-weight: 700;
  }

  /* Cart Layout */
  .cart-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 992px) {
    .cart-layout {
      grid-template-columns: 2fr 1fr;
      gap: 60px;
    }
  }

  /* Cart Items */
  .cart-items-header {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 15px;
    margin-bottom: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .cart-header-product { text-align: left; }
  .cart-header-qty { text-align: center; }
  .cart-header-total { text-align: right; }

  @media (max-width: 768px) {
    .cart-items-header { display: none; }
  }

  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid #f3f4f6;
    position: relative;
    transition: opacity 0.3s ease;
  }
  
  .cart-item.loading {
    opacity: 0.5;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .cart-item {
      grid-template-columns: 100px 2fr 1fr 1fr;
      align-items: center;
    }
  }

  .cart-item-image {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: 8px;
    background-color: #f3f4f6;
  }

  .cart-item-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .cart-item-title {
    font-size: 1rem;
    font-weight: 700;
    color: #000;
    text-decoration: none;
    margin-bottom: 4px;
    display: block;
  }

  .cart-item-variant {
    font-size: 0.875rem;
    color: #6b7280;
  }

  .cart-item-price-mobile {
    margin-top: 8px;
    font-weight: 600;
    display: block;
  }
  @media (min-width: 768px) {
    .cart-item-price-mobile { display: none; }
  }

  /* Quantity Selector */
  .qty-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qty-input-group {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    overflow: hidden;
    height: 40px;
    width: 120px;
  }

  .qty-btn {
    width: 36px;
    height: 100%;
    border: none;
    background: #fff;
    cursor: pointer;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .qty-btn:hover { background: #f9fafb; }

  .qty-input {
    flex: 1;
    width: 100%;
    height: 100%;
    border: none;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 500;
    -moz-appearance: textfield;
  }
  .qty-input::-webkit-inner-spin-button, 
  .qty-input::-webkit-outer-spin-button { 
    -webkit-appearance: none; 
    margin: 0; 
  }

  .remove-btn {
    margin-top: 8px;
    font-size: 0.75rem;
    color: #ef4444;
    text-decoration: underline;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }
  
  @media (min-width: 768px) {
     .remove-btn {
        margin-top: 0;
        margin-left: 10px;
        position: static;
        display: inline-block;
        color: #9ca3af;
        text-decoration: none;
     }
     .remove-btn:hover { color: #ef4444; }
     .qty-wrapper {
        flex-direction: row;
        justify-content: center;
     }
  }

  .items-total-price {
    text-align: right;
    font-weight: 700;
    font-size: 1.125rem;
    display: none;
  }
  @media (min-width: 768px) {
    .items-total-price { display: block; }
  }

  /* Order Summary */
  .cart-summary {
    background: #f9fafb;
    border: 1px solid #f3f4f6;
    border-radius: 12px;
    padding: 30px;
    position: sticky;
    top: 100px;
  }

  .summary-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    color: #4b5563;
  }

  .summary-price {
    font-weight: 700;
    color: #000;
    font-size: 1.25rem;
  }

  .summary-note {
    font-size: 0.875rem;
    color: #9ca3af;
    font-style: italic;
    margin-bottom: 30px;
  }

  .checkout-btn {
    width: 100%;
    background-color: #000;
    color: #fff;
    font-weight: 700;
    padding: 16px;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.3s, transform 0.2s;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .checkout-btn:hover {
    background-color: #1f2937;
    transform: translateY(-2px);
  }
  
  .checkout-btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  
  .loading-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid #fff;
    border-bottom-color: transparent;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  /* Empty State */
  .empty-cart {
    text-align: center;
    padding: 80px 20px;
  }
  .empty-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }
  .continue-shopping-btn {
    display: inline-block;
    background: #000;
    color: #fff;
    padding: 14px 32px;
    font-weight: 700;
    text-transform: uppercase;
    margin-top: 20px;
    text-decoration: none;
    transition: background 0.3s;
  }
  .continue-shopping-btn:hover { background: #333; }

  /* #64: Rewards progress bar */
  .rewards-bar {
    background: linear-gradient(135deg, #fff8e7 0%, #fff 100%);
    border: 1px solid #f0e6d0;
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 22px;
  }
  .rewards-bar__msg {
    margin: 0 0 10px;
    font-size: 0.85rem;
    color: #5a4a1f;
    font-weight: 600;
  }
  .rewards-bar__msg strong { color: var(--color-primary, #000c5b); }
  .rewards-bar__track {
    width: 100%;
    height: 6px;
    background: #f3e8c4;
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }
  .rewards-bar__fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-secondary, #71b6c8) 0%, var(--color-primary, #000c5b) 100%);
    border-radius: 999px;
    transition: width 0.5s ease;
  }

  /* #64: You may also like in cart */
  .cart-recommendations {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #f3f4f6;
  }
  .cart-recommendations__title {
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-primary, #000c5b);
    margin: 0 0 14px;
    letter-spacing: 0.05em;
  }
  .cart-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 640px) {
    .cart-recommendations__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .rec-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid #f3f4f6;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .rec-card:hover { transform: translateY(-2px); box-shadow: 0 6px 14px rgba(0,0,0,0.08); }
  .rec-card__img {
    width: 100%;
    aspect-ratio: 3/4;
    background: #f5f5f5;
    overflow: hidden;
  }
  .rec-card__img img { width: 100%; height: 100%; object-fit: cover; }
  .rec-card__info { padding: 8px 10px 10px; }
  .rec-card__title {
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 4px;
    line-height: 1.2;
    color: #000;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rec-card__price {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-primary, #000c5b);
  }

  /* #55: Coupon code section */
  .coupon-section {
    margin-bottom: 18px;
    padding: 14px 16px;
    background: #fff;
    border: 1px dashed #d1d5db;
    border-radius: 8px;
  }
  .coupon-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #4b5563;
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }
  .coupon-input-row {
    display: flex;
    gap: 8px;
  }
  .coupon-input {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .coupon-input:focus {
    outline: none;
    border-color: var(--color-primary, #000c5b);
    box-shadow: 0 0 0 3px rgba(0, 12, 91, 0.08);
  }
  .coupon-btn {
    padding: 10px 18px;
    background: var(--color-primary, #000c5b);
    color: #fff;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.2s;
  }
  .coupon-btn:hover { background: #000940; }
  .coupon-hint {
    margin-top: 8px;
    font-size: 0.75rem;
    color: #6b7280;
  }
  .coupon-hint.coupon-error { color: #dc2626; font-weight: 600; }

  /* Size Chart */
  .size-chart-section {
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    overflow: hidden;
    margin-top: 20px;
  }

  .size-chart-toggle {
    width: 100%;
    padding: 16px 20px;
    background: #fff;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .size-chart-toggle svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .size-chart-toggle.open svg {
    transform: rotate(180deg);
  }

  .size-chart-content {
    display: none;
    padding: 20px;
    background: #f8f9fa;
    border-top: 1px solid #e0e0e0;
  }

  .size-chart-content.open {
    display: block;
  }

  .size-chart-notes {
    font-size: 0.8rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .size-chart-notes li {
    margin-bottom: 8px;
    padding-left: 8px;
  }

  .size-chart-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .size-chart-table th,
  .size-chart-table td {
    padding: 12px;
    text-align: center;
    border: 1px solid #ddd;
  }

  .size-chart-table th {
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
  }

  .size-chart-table tr:nth-child(even) {
    background: #f0f0f0;
  }
</style>

<div class="cart-container" x-data="cartPage()">
  <h1 class="cart-title">YOUR FIT-KART</h1>

  <template x-if="itemCount > 0">
    <div class="cart-layout">

      <!-- Cart Items List (Left Column) -->
      <div class="cart-items-section">
        <!-- #64: Rewards progress bar -->
        <div class="rewards-bar" x-show="totalPrice > 0" x-cloak>
          <p class="rewards-bar__msg" x-show="totalPrice/100 < 4000">
            Spend ₹<strong x-text="(4000 - totalPrice/100).toFixed(0)"></strong> more to get a <strong>FREE T-shirt</strong>!
          </p>
          <p class="rewards-bar__msg" x-show="totalPrice/100 >= 4000" style="color: #2e7d32;">
            🎉 You've unlocked a <strong>FREE T-shirt</strong>!
          </p>
          <div class="rewards-bar__track">
            <div class="rewards-bar__fill" :style="`width: ${Math.min(100, (totalPrice/100)/4000*100)}%`"></div>
          </div>
        </div>

        <!-- Header Row (Desktop Only) -->
        <div class="cart-items-header">
          <div class="cart-header-product">Product</div>
          <div class="cart-header-qty">Quantity</div>
          <div class="cart-header-total">Total</div>
        </div>

        <!-- Items Loop -->
        <template x-for="(item, index) in items" :key="item.key">
          <div class="cart-item" :class="{ 'loading': loading }">
            
            <!-- Image (Grid Col 1) -->
            <a :href="item.url">
              <img :src="item.image ? item.image : ''" :alt="item.title" class="cart-item-image">
            </a>

            <!-- Details (Grid Col 2) -->
            <div class="cart-item-details">
              <a :href="item.url" class="cart-item-title" x-text="item.product_title"></a>
              <p class="cart-item-variant" x-text="item.variant_title !== 'Default Title' ? item.variant_title : ''"></p>
              <div class="cart-item-price-mobile" x-text="formatMoney(item.original_line_price)"></div>
            </div>

            <!-- Quantity (Grid Col 3) -->
            <div class="qty-wrapper">
              <div class="qty-input-group">
                <button 
                  type="button"
                  @click="updateQuantity(index, item.quantity - 1)" 
                  class="qty-btn"
                  aria-label="Decrease quantity"
                >−</button>
                <input 
                  type="number" 
                  x-model="item.quantity"
                  @change="updateQuantity(index, parseInt($el.value))"
                  min="0" 
                  class="qty-input"
                >
                <button 
                  type="button" 
                  @click="updateQuantity(index, item.quantity + 1)" 
                  class="qty-btn"
                  aria-label="Increase quantity"
                >+</button>
              </div>
              <button 
                @click="updateQuantity(index, 0)" 
                class="remove-btn"
                aria-label="Remove item"
              >
                <span class="md:hidden">Remove</span>
                <!-- Desktop Trash Icon -->
                <svg viewBox="0 0 24 24" fill="none" class="hidden md:block" stroke="currentColor" width="20" height="20" style="display:none">
                   <!-- Icon handled by CSS display media queries if cleaner, using text 'remove' for now on mobile -->
                </svg>
              </button>
            </div>

            <!-- Total Price (Grid Col 4) -->
            <div class="items-total-price" x-text="formatMoney(item.original_line_price)"></div>
          </div>
        </template>

        <!-- #64: You may also like -->
        <div class="cart-recommendations" x-show="recommendations.length > 0" x-cloak>
          <h3 class="cart-recommendations__title">You may also like</h3>
          <div class="cart-recommendations__grid">
            <template x-for="r in recommendations" :key="r.id">
              <a :href="r.url" class="rec-card">
                <div class="rec-card__img">
                  <img :src="r.featured_image" :alt="r.title">
                </div>
                <div class="rec-card__info">
                  <div class="rec-card__title" x-text="r.title"></div>
                  <div class="rec-card__price" x-text="'₹' + Math.round(r.price/100) + '/-'"></div>
                </div>
              </a>
            </template>
          </div>
        </div>
      </div>

      <!-- Order Summary (Right Column) -->
      <div class="cart-summary-section">
        <div class="cart-summary">
           <h2 class="summary-title">Order Summary</h2>
           
           <div class="summary-row">
              <span>Subtotal</span>
              <span class="summary-price" x-text="formatMoney(window.cart ? window.cart.total_price : totalPrice)"></span>
           </div>
           
           <p class="summary-note">Inclusive of taxes and free shipping</p>

           <!-- #55: Coupon Code (applies at checkout) -->
           <div class="coupon-section" x-data="{ code: '', error: '' }">
             <label class="coupon-label">Have a coupon code?</label>
             <div class="coupon-input-row">
               <input type="text" x-model="code" placeholder="Enter code" class="coupon-input" autocapitalize="characters" spellcheck="false">
               <button type="button" class="coupon-btn" @click="
                 if (!code.trim()) { error = 'Please enter a code'; return; }
                 window.location.href = '/checkout?discount=' + encodeURIComponent(code.trim())
               ">Apply</button>
             </div>
             <p class="coupon-hint" x-show="!error">Code is applied on the checkout page.</p>
             <p class="coupon-hint coupon-error" x-show="error" x-text="error"></p>
           </div>


           <!-- Checkout Actions -->
           <form action="{{ routes.cart_url }}" method="post">
             <button
               type="submit"
               name="checkout"
               class="checkout-btn"
               :disabled="loading"
             >
               <span x-show="!loading">PROCEED TO CHECKOUT</span>
               <span x-show="loading" class="loading-spinner"></span>
             </button>
           </form>
        </div>
      </div>
    
    </div>
  </template>

  <!-- Empty Cart State -->
  <template x-if="itemCount === 0 && !initialLoading">
    <div class="empty-cart fadeIn">
       <svg class="empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
       </svg>
       <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 10px;">Your cart is currently empty.</h2>
       <p style="color: #6b7280; margin-bottom: 30px;">Looks like you haven't added any items to your cart yet.</p>
       <a href="/collections/all" class="continue-shopping-btn">Start Shopping</a>
    </div>
  </template>
</div>

<script>
  function cartPage() {
    return {
      items: [],
      itemCount: 0,
      totalPrice: 0,
      loading: false,
      initialLoading: true,
      sizeChartOpen: false,
      recommendations: [],

      init() {
        this.fetchCart();
      },

      async fetchRecommendations(productId) {
        const cartIds = new Set(this.items.map(i => i.product_id));
        const mapProduct = p => ({
          id: p.id,
          url: '/products/' + p.handle,
          title: p.title,
          price: (p.variants && p.variants[0]) ? Math.round(parseFloat(p.variants[0].price) * 100) : 0,
          featured_image: (p.images && p.images[0]) ? p.images[0].src : ''
        });
        const pick = (arr) => arr.filter(p => !cartIds.has(p.id)).slice(0, 6).map(mapProduct);

        // 1. Shopify native recommendations API (seeded by first cart product)
        if (productId) {
          try {
            const r = await fetch(`/recommendations/products.json?product_id=${productId}&limit=9`);
            if (r.ok) {
              const d = await r.json();
              const recs = pick(d.products || []);
              if (recs.length > 0) { this.recommendations = recs; return; }
            }
          } catch (e) {}
        }

        // 2. Fall back to /collections/all
        try {
          const r2 = await fetch('/collections/all/products.json?limit=12');
          if (r2.ok) {
            const d2 = await r2.json();
            this.recommendations = pick(d2.products || []);
          }
        } catch (e) {}
      },

      fetchCart() {
        fetch(window.Shopify.routes.root + 'cart.js')
          .then(response => response.json())
          .then(cart => {
            this.items = cart.items;
            this.itemCount = cart.item_count;
            this.totalPrice = cart.total_price;
            this.initialLoading = false;
            this.updateHeaderCartCount(cart.item_count);
            const firstProductId = cart.items && cart.items[0] ? cart.items[0].product_id : null;
            this.fetchRecommendations(firstProductId);
          })
          .catch(error => console.error('Error fetching cart:', error));
      },

      updateQuantity(index, newQty) {
        if (newQty < 0) return;
        
        this.loading = true;
        const item = this.items[index];
        
        // Optimistic UI update (optional, but safer to wait for server response for price calculations)
        // For simplicity and accuracy with discounts/tiers, we rely on the server response.

        const body = JSON.stringify({
          line: index + 1, // Shopify uses 1-based index for line items
          quantity: newQty
        });

        fetch(window.Shopify.routes.root + 'cart/change.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: body
        })
        .then(response => response.json())
        .then(cart => {
          this.items = cart.items;
          this.itemCount = cart.item_count;
          this.totalPrice = cart.total_price;
          this.loading = false;
          this.updateHeaderCartCount(cart.item_count);
        })
        .catch(error => {
          console.error('Error updating cart:', error);
          this.loading = false;
        });
      },

      formatMoney(cents) {
        return 'Rs. ' + (cents / 100).toFixed(2);
      },
      
      updateHeaderCartCount(count) {
        // Look for common cart count selectors or dispatch an event
        const countElements = document.querySelectorAll('.cart-count-bubble span, [data-cart-count]');
        countElements.forEach(el => el.innerText = count);
        
        // Dispatch event for other components
        window.dispatchEvent(new CustomEvent('cart:updated', { detail: { count: count } }));
      }
    }
  }
</script>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
