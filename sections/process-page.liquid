<script>
(function() {
  // Only one FAQ open at a time
  var faqs = document.querySelectorAll('.process-faq');
  faqs.forEach(function(faq) {
    faq.addEventListener('toggle', function() {
      if (faq.open) {
        faqs.forEach(function(other) {
          if (other !== faq) other.open = false;
        });
      }
    });
  });
})();
</script>

<script>
(function() {
  // Slideshow for creative section
  const images = document.querySelectorAll('.creative-image');
  const dotsContainer = document.querySelector('[data-creative-dots]');
  let currentSlide = 0;
  let slideTimer;

  function goToSlide(index) {
    images[currentSlide].classList.remove('active');
    currentSlide = index;
    images[currentSlide].classList.add('active');
    if (dotsContainer) {
      dotsContainer.querySelectorAll('.creative-dot').forEach((d, i) => {
        d.classList.toggle('active', i === currentSlide);
      });
    }
  }

  function startAutoplay() {
    if (images.length <= 1) return;
    clearInterval(slideTimer);
    slideTimer = setInterval(() => {
      goToSlide((currentSlide + 1) % images.length);
    }, 4000);
  }

  if (images.length > 1 && dotsContainer) {
    images.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'creative-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      dot.addEventListener('click', () => {
        goToSlide(i);
        startAutoplay();
      });
      dotsContainer.appendChild(dot);
    });
  }

  startAutoplay();

  const DESIGN_FEE = {{ section.settings.design_fee_amount | default: 499 }};
  let productCount = 1;
  const MAX_PRODUCTS = 5;

  // Track selected apparels to show/hide pricing
  const selectedApparels = new Set();

  // Update price breakdown visibility when apparel changes
  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('apparel-select')) {
      updatePriceBreakdown();
      updateFee();
    }
  });

  // Update price breakdown to show only selected apparels
  function updatePriceBreakdown() {
    selectedApparels.clear();

    // Collect all selected apparels
    document.querySelectorAll('.apparel-select').forEach(function(select) {
      if (select.value) {
        selectedApparels.add(select.value);
      }
    });

    // Show/hide the entire design fee and price breakdown sections
    var hasSelected = selectedApparels.size > 0;
    var designFeeSection = document.querySelector('.design-fee-section');
    var priceBreakdownSection = document.querySelector('.price-breakdown-section');

    if (designFeeSection) {
      designFeeSection.style.display = hasSelected ? 'block' : 'none';
    }
    if (priceBreakdownSection) {
      priceBreakdownSection.style.display = hasSelected ? 'block' : 'none';
    }

    // Show/hide pricing blocks
    document.querySelectorAll('.apparel-pricing').forEach(function(block) {
      var apparelName = block.querySelector('.apparel-name').textContent;
      block.style.display = selectedApparels.has(apparelName) ? 'block' : 'none';
    });
  }

  // Add product function
  window.addProduct = function() {
    if (productCount >= MAX_PRODUCTS) return;
    productCount++;

    var container = document.getElementById('productBlocksContainer');
    var block = document.createElement('div');
    block.className = 'product-block';
    block.dataset.product = productCount;
    block.innerHTML =
      '<div class="product-block-header">' +
        '<span class="product-block-title">Product ' + productCount + '</span>' +
        '<button type="button" class="remove-product-btn" onclick="removeProduct(this)">Remove</button>' +
      '</div>' +
      '<div class="form-group">' +
        '<label class="form-label">Choice of Apparel <span class="required">*</span></label>' +
        '<select name="contact[product_' + productCount + '_apparel]" class="form-select apparel-select" data-product="' + productCount + '" required>' +
          '<option value="" disabled selected>Select Apparel Type</option>' +
          '<option value="Cropped Tee">Cropped Tee (Only front printing)</option>' +
          '<option value="Regular Tee">Regular Tee</option>' +
          '<option value="Oversized Tee">Oversized Tee</option>' +
          '<option value="Boxy Vest">Boxy Vest</option>' +
          '<option value="Sweatshirt">Sweatshirt</option>' +
          '<option value="Hoodie">Hoodie</option>' +
        '</select>' +
      '</div>' +
      '<div class="form-group">' +
        '<label class="form-label">Size <span class="required">*</span></label>' +
        '<select name="contact[product_' + productCount + '_size]" class="form-select" required>' +
          '<option value="" disabled selected>Pick a Size</option>' +
          '<option value="XS">XS</option>' +
          '<option value="S">S</option>' +
          '<option value="M">M</option>' +
          '<option value="L">L</option>' +
          '<option value="XL">XL</option>' +
          '<option value="XXL">XXL</option>' +
        '</select>' +
      '</div>';

    container.appendChild(block);
    updateFee();
    updateAddButton();
  };

  // Remove product function
  window.removeProduct = function(btn) {
    var block = btn.closest('.product-block');
    block.remove();
    productCount--;

    // Renumber remaining blocks
    var blocks = document.querySelectorAll('.product-block');
    blocks.forEach(function(b, i) {
      var num = i + 1;
      b.dataset.product = num;
      b.querySelector('.product-block-title').textContent = 'Product ' + num;

      // Update name attributes
      var selects = b.querySelectorAll('select');
      var inputs = b.querySelectorAll('input');
      selects.forEach(function(s) {
        s.name = s.name.replace(/product_\d+/, 'product_' + num);
        if (s.classList.contains('apparel-select')) {
          s.dataset.product = num;
        }
      });
      inputs.forEach(function(inp) {
        if (inp.name) inp.name = inp.name.replace(/product_\d+/, 'product_' + num);
      });
    });

    updatePriceBreakdown();
    updateFee();
    updateAddButton();
  };

  function updateFee() {
    var count = document.querySelectorAll('.product-block').length;
    document.getElementById('productCountField').value = count;
    var totalFee = DESIGN_FEE * count;
    document.getElementById('designFeeField').value = totalFee;
  }

  function updateAddButton() {
    var btn = document.getElementById('addProductBtn');
    var count = document.querySelectorAll('.product-block').length;
    btn.disabled = count >= MAX_PRODUCTS;
    btn.textContent = count >= MAX_PRODUCTS ? 'Maximum 5 products reached' : '+ Add Another Product (up to 5)';
  }
})();
</script>

