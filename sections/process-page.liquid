{% comment %}
  Process Page Section - Fitkaar
  Detailed Custom Order Form with Fabric/Stitch Aesthetics matching Contact Page
{% endcomment %}

<style>
/* Reusing Contact Page Typography & Base Styles */
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@300;400;500;600&display=swap');

.process-page {
  font-family: 'Outfit', sans-serif;
  background-color: #faf9f7;
  color: #333;
  line-height: 1.6;
  position: relative;
  min-height: 100vh;
  padding-bottom: 4rem;
  background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0h1v1H0V0zm2 0h1v1H2V0zm2 0h1v1H4V0zm2 0h1v1H6V0zm2 0h1v1H8V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0zm2 0h1v1h-1V0z' fill='%23e8e4de' fill-opacity='0.4'/%3E%3C/svg%3E");
}

/* Header */
.process-header {
  text-align: center;
  padding: 5rem 1rem 3rem;
}

.process-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 3.5rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: #000c5b;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}

.process-subtitle {
  font-size: 1.1rem;
  color: #666;
  max-width: 600px;
  margin: 0 auto;
}

/* Form Container */
.process-form-container {
  max-width: 800px;
  margin: 0 auto;
  background: #fff;
  padding: 40px;
  border-radius: 4px;
  position: relative;
  border: 1px solid #e0e0e0;
  box-shadow: 0 10px 40px rgba(0,0,0,0.08);
}

/* Corner fabric fold */
.process-form-container::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 60px 60px 0;
  border-color: transparent #f0ebe3 transparent transparent;
  z-index: 2;
}

/* Form Groups */
.form-group {
  margin-bottom: 1.5rem;
}

.form-label {
  display: block;
  font-size: 0.9rem;
  font-weight: 600;
  color: #000c5b;
  margin-bottom: 0.5rem;
  letter-spacing: 0.05em;
}

.form-label span.required {
  color: #e53935;
  margin-left: 2px;
}

.form-input, .form-select, .form-textarea {
  width: 100%;
  padding: 12px 15px;
  font-family: 'Outfit', sans-serif;
  font-size: 1rem;
  border: 1px solid #ddd;
  background: #fdfcfa;
  color: #333;
  border-radius: 0;
  transition: all 0.3s;
}

.form-input:focus, .form-select:focus, .form-textarea:focus {
  outline: none;
  border-color: #000c5b;
  box-shadow: 0 0 0 3px rgba(0, 12, 91, 0.05);
  background: #fff;
}

.form-textarea {
  min-height: 100px;
  resize: vertical;
}

/* File Input Styling */
.form-file-input {
  display: block;
  width: 100%;
  padding: 10px;
  background: #f4f4f4;
  border: 1px dashed #ccc;
  cursor: pointer;
}

.section-divider {
  margin: 2rem 0 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid #eee;
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.5rem;
  color: #000c5b;
}

.submit-btn {
  display: block;
  width: 100%;
  padding: 16px;
  background: #000c5b;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 1.1rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border: none;
  cursor: pointer;
  transition: background 0.3s;
  margin-top: 2rem;
}

.submit-btn:hover {
  background: #71b6c8;
}

/* Product Block Styles */
.product-block {
  border: 1px solid #eee;
  padding: 20px;
  margin-bottom: 1.5rem;
  position: relative;
  background: #fdfcfa;
}

.product-block-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.product-block-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.2rem;
  color: #000c5b;
  font-weight: 600;
}

.remove-product-btn {
  background: none;
  border: 1px solid #e53935;
  color: #e53935;
  padding: 4px 12px;
  font-size: 0.8rem;
  cursor: pointer;
  font-family: 'Outfit', sans-serif;
  transition: all 0.3s;
}

.remove-product-btn:hover {
  background: #e53935;
  color: #fff;
}

.add-product-btn {
  display: block;
  width: 100%;
  padding: 12px;
  background: transparent;
  border: 2px dashed #000c5b;
  color: #000c5b;
  font-family: 'Outfit', sans-serif;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s;
  margin-bottom: 1rem;
}

.add-product-btn:hover {
  background: rgba(0, 12, 91, 0.05);
}

.add-product-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* Design Fee */
.design-fee-display {
  background: #f0f7fa;
  border: 1px solid #71b6c8;
  padding: 15px 20px;
  margin-top: 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.design-fee-label {
  font-weight: 600;
  color: #000c5b;
  font-size: 1rem;
}

.design-fee-amount {
  font-size: 1.3rem;
  font-weight: 700;
  color: #000c5b;
}

.form-hint {
  display: block;
  color: #777;
  margin-top: 5px;
  font-size: 0.8rem;
}

/* Size Chart Link */
.size-chart-toggle {
  color: #000c5b;
  text-decoration: underline;
  cursor: pointer;
  font-size: 0.85rem;
  margin-top: 6px;
  display: inline-block;
}

.size-chart-container {
  display: none;
  margin-top: 10px;
}

.size-chart-container.active {
  display: block;
}

/* Responsive */
@media (max-width: 768px) {
  .process-form-container {
    padding: 25px;
    margin: 0 15px;
  }
  .process-title {
    font-size: 2.5rem;
  }
  .product-block {
    padding: 15px;
  }
}
</style>

<div class="process-page">
  <div class="process-header">
    <h1 class="process-title">{{ section.settings.title | default: "Custom Order Process" }}</h1>
    <p class="process-subtitle">{{ section.settings.subtitle | default: "Tell us what you have in mind, and we'll craft it for you." }}</p>
  </div>

  <div class="process-form-container">
    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <div style="background: #e8f5e9; color: #2e7d32; padding: 15px; margin-bottom: 20px; text-align: center; border: 1px solid #c8e6c9;">
          <strong>Thanks!</strong> Your custom order request has been sent. We'll be in touch shortly.
        </div>
      {% elsif form.errors %}
        <div style="background: #ffebee; color: #c62828; padding: 15px; margin-bottom: 20px; border: 1px solid #ffcdd2;">
          <strong>Error:</strong> Please check the form and try again.
        </div>
      {% endif %}

      <!-- Hidden Identifiers -->
      <input type="hidden" name="contact[form_type]" value="custom_order_process">
      <input type="hidden" name="contact[product_count]" id="productCountField" value="1">
      <input type="hidden" name="contact[design_fee]" id="designFeeField" value="">

      <!-- Personal Info -->
      <h3 class="section-divider">Contact Details</h3>

      <div class="form-group">
        <label class="form-label" for="ContactFormName">Name <span class="required">*</span></label>
        <input type="text" id="ContactFormName" name="contact[name]" class="form-input" placeholder="Your Name" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="ContactFormEmail">Email <span class="required">*</span></label>
        <input type="email" id="ContactFormEmail" name="contact[email]" class="form-input" placeholder="your@email.com" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="ContactFormPhone">Phone (WhatsApp) <span class="required">*</span></label>
        <input type="tel" id="ContactFormPhone" name="contact[phone]" class="form-input" placeholder="Just numbers please" pattern="[0-9]*" required title="Please enter only numbers">
      </div>

      <!-- Order Details -->
      <h3 class="section-divider">Order Details</h3>

      <div class="form-group">
        <label class="form-label" for="ContactFormPurpose">Purpose <span class="required">*</span></label>
        <select id="ContactFormPurpose" name="contact[purpose]" class="form-select" required>
          <option value="" disabled selected>Select Purpose</option>
          <option value="Gifting">Gifting</option>
          <option value="Yourself">Yourself</option>
        </select>
      </div>

      <!-- Product Blocks Container -->
      <div id="productBlocksContainer">
        <!-- Product 1 (always visible, can't be removed) -->
        <div class="product-block" data-product="1">
          <div class="product-block-header">
            <span class="product-block-title">Product 1</span>
          </div>

          <div class="form-group">
            <label class="form-label">Choice of Apparel <span class="required">*</span></label>
            <select name="contact[product_1_apparel]" class="form-select apparel-select" data-product="1" required>
              <option value="" disabled selected>Select Apparel Type</option>
              <option value="Cropped Tee">Cropped Tee (Only front printing)</option>
              <option value="Regular Tee">Regular Tee</option>
              <option value="Oversized Tee">Oversized Tee</option>
              <option value="Boxy Vest">Boxy Vest</option>
              <option value="Sweatshirt">Sweatshirt</option>
              <option value="Hoodie">Hoodie</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Colour <span class="required">*</span></label>
            <select name="contact[product_1_colour]" class="form-select colour-select" data-product="1" required>
              <option value="" disabled selected>Select apparel first</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Quantity <span class="required">*</span></label>
            <input type="number" name="contact[product_1_quantity]" class="form-input" placeholder="1" min="1" required>
            <small class="form-hint">For the same design, If you want more than one design, please fill separate forms for the other ones!</small>
          </div>

          <div class="form-group">
            <label class="form-label">Size <span class="required">*</span></label>
            <select name="contact[product_1_size]" class="form-select" required>
              <option value="" disabled selected>Pick a Size</option>
              <option value="XS">XS</option>
              <option value="S">S</option>
              <option value="M">M</option>
              <option value="L">L</option>
              <option value="XL">XL</option>
              <option value="XXL">XXL</option>
            </select>
            {% if section.settings.size_chart_image %}
              <span class="size-chart-toggle" onclick="this.nextElementSibling.classList.toggle('active')">View Size Chart</span>
              <div class="size-chart-container">
                <img src="{{ section.settings.size_chart_image | image_url: width: 600 }}" alt="Size Chart" style="max-width: 100%; border: 1px solid #ddd;">
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Add Another Product Button -->
      <button type="button" class="add-product-btn" id="addProductBtn" onclick="addProduct()">
        + Add Another Product (up to 5)
      </button>

      <!-- Design Fee Display -->
      <div class="design-fee-display">
        <span class="design-fee-label">Design Fee</span>
        <span class="design-fee-amount" id="designFeeDisplay">{{ section.settings.design_fee_amount | default: 499 | money_without_trailing_zeros }}</span>
      </div>
      <small class="form-hint" style="margin-top: 4px;">Design fee is per product. Multiple products = fee x number of products.</small>

      <!-- Personalization Questions -->
      <h3 class="section-divider">Personalization</h3>

      <div class="form-group">
        <label class="form-label" for="ContactFormHobbies">Hobbies / Interests</label>
        <textarea id="ContactFormHobbies" name="contact[hobbies]" class="form-textarea" placeholder="What are the recipient's favorites?"></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="ContactFormFood">Favorite Food / Cuisine</label>
        <textarea id="ContactFormFood" name="contact[food]" class="form-textarea" placeholder="E.g., Pizza, Ramen, Indian..."></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="ContactFormQuotes">Quotes / Words</label>
        <textarea id="ContactFormQuotes" name="contact[quotes]" class="form-textarea" placeholder="Phrases to include in the design"></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="ContactFormColourPref">Any particular colour to be included in the design?</label>
        <textarea id="ContactFormColourPref" name="contact[colour_preference]" class="form-textarea" placeholder="E.g., Red and black theme, pastel tones, neon..."></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="ContactFormElements">Other Elements</label>
        <textarea id="ContactFormElements" name="contact[other_elements]" class="form-textarea" placeholder="Anything else to include?"></textarea>
      </div>

      <!-- File Uploads -->
      <h3 class="section-divider">Uploads</h3>

      <div class="form-group">
        <label class="form-label">Photos to Include</label>
        <input type="file" name="contact[photos]" class="form-file-input" multiple accept="image/*">
        <small class="form-hint">For high-quality images or if upload fails, email them to <strong>fitkaarclothing@gmail.com</strong></small>
      </div>

      <div class="form-group">
        <label class="form-label">Design References</label>
        <input type="file" name="contact[references]" class="form-file-input" multiple accept="image/*">
        <small class="form-hint">You can also send references via email to <strong>fitkaarclothing@gmail.com</strong></small>
      </div>

      <button type="submit" class="submit-btn">Submit Request</button>

    {% endform %}
  </div>
</div>

<script>
(function() {
  const DESIGN_FEE = {{ section.settings.design_fee_amount | default: 499 }};
  let productCount = 1;
  const MAX_PRODUCTS = 5;

  // Colour options per apparel type
  const coloursByApparel = {
    'Cropped Tee': ['Black', 'White', 'Baby Pink', 'Lavender', 'Sky Blue'],
    'Regular Tee': ['Black', 'White', 'Navy Blue', 'Maroon', 'Grey', 'Olive Green', 'Baby Pink', 'Lavender'],
    'Oversized Tee': ['Black', 'White', 'Navy Blue', 'Beige', 'Grey', 'Olive Green', 'Lavender', 'Baby Pink'],
    'Boxy Vest': ['Black', 'White', 'Grey'],
    'Sweatshirt': ['Black', 'White', 'Navy Blue', 'Grey', 'Maroon', 'Olive Green', 'Beige'],
    'Hoodie': ['Black', 'White', 'Navy Blue', 'Grey', 'Maroon', 'Olive Green', 'Beige']
  };

  // Update colour dropdown when apparel changes
  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('apparel-select')) {
      const productNum = e.target.dataset.product;
      const colourSelect = document.querySelector('.colour-select[data-product="' + productNum + '"]');
      const apparel = e.target.value;
      const colours = coloursByApparel[apparel] || [];

      colourSelect.innerHTML = '<option value="" disabled selected>Select Colour</option>';
      colours.forEach(function(colour) {
        const opt = document.createElement('option');
        opt.value = colour;
        opt.textContent = colour;
        colourSelect.appendChild(opt);
      });
      // Add "Other" option
      var otherOpt = document.createElement('option');
      otherOpt.value = 'Other';
      otherOpt.textContent = 'Other (specify in personalization)';
      colourSelect.appendChild(otherOpt);
    }
  });

  // Add product function
  window.addProduct = function() {
    if (productCount >= MAX_PRODUCTS) return;
    productCount++;

    var container = document.getElementById('productBlocksContainer');
    var block = document.createElement('div');
    block.className = 'product-block';
    block.dataset.product = productCount;
    block.innerHTML =
      '<div class="product-block-header">' +
        '<span class="product-block-title">Product ' + productCount + '</span>' +
        '<button type="button" class="remove-product-btn" onclick="removeProduct(this)">Remove</button>' +
      '</div>' +
      '<div class="form-group">' +
        '<label class="form-label">Choice of Apparel <span class="required">*</span></label>' +
        '<select name="contact[product_' + productCount + '_apparel]" class="form-select apparel-select" data-product="' + productCount + '" required>' +
          '<option value="" disabled selected>Select Apparel Type</option>' +
          '<option value="Cropped Tee">Cropped Tee (Only front printing)</option>' +
          '<option value="Regular Tee">Regular Tee</option>' +
          '<option value="Oversized Tee">Oversized Tee</option>' +
          '<option value="Boxy Vest">Boxy Vest</option>' +
          '<option value="Sweatshirt">Sweatshirt</option>' +
          '<option value="Hoodie">Hoodie</option>' +
        '</select>' +
      '</div>' +
      '<div class="form-group">' +
        '<label class="form-label">Colour <span class="required">*</span></label>' +
        '<select name="contact[product_' + productCount + '_colour]" class="form-select colour-select" data-product="' + productCount + '" required>' +
          '<option value="" disabled selected>Select apparel first</option>' +
        '</select>' +
      '</div>' +
      '<div class="form-group">' +
        '<label class="form-label">Quantity <span class="required">*</span></label>' +
        '<input type="number" name="contact[product_' + productCount + '_quantity]" class="form-input" placeholder="1" min="1" required>' +
        '<small class="form-hint">For same design only.</small>' +
      '</div>' +
      '<div class="form-group">' +
        '<label class="form-label">Size <span class="required">*</span></label>' +
        '<select name="contact[product_' + productCount + '_size]" class="form-select" required>' +
          '<option value="" disabled selected>Pick a Size</option>' +
          '<option value="XS">XS</option>' +
          '<option value="S">S</option>' +
          '<option value="M">M</option>' +
          '<option value="L">L</option>' +
          '<option value="XL">XL</option>' +
          '<option value="XXL">XXL</option>' +
        '</select>' +
      '</div>';

    container.appendChild(block);
    updateFee();
    updateAddButton();
  };

  // Remove product function
  window.removeProduct = function(btn) {
    var block = btn.closest('.product-block');
    block.remove();
    productCount--;

    // Renumber remaining blocks
    var blocks = document.querySelectorAll('.product-block');
    blocks.forEach(function(b, i) {
      var num = i + 1;
      b.dataset.product = num;
      b.querySelector('.product-block-title').textContent = 'Product ' + num;

      // Update name attributes
      var selects = b.querySelectorAll('select');
      var inputs = b.querySelectorAll('input');
      selects.forEach(function(s) {
        s.name = s.name.replace(/product_\d+/, 'product_' + num);
        if (s.classList.contains('apparel-select') || s.classList.contains('colour-select')) {
          s.dataset.product = num;
        }
      });
      inputs.forEach(function(inp) {
        if (inp.name) inp.name = inp.name.replace(/product_\d+/, 'product_' + num);
      });
    });

    updateFee();
    updateAddButton();
  };

  function updateFee() {
    var count = document.querySelectorAll('.product-block').length;
    document.getElementById('productCountField').value = count;
    var totalFee = DESIGN_FEE * count;
    document.getElementById('designFeeDisplay').textContent = '\u20B9' + totalFee.toLocaleString('en-IN');
    document.getElementById('designFeeField').value = totalFee;
  }

  function updateAddButton() {
    var btn = document.getElementById('addProductBtn');
    var count = document.querySelectorAll('.product-block').length;
    btn.disabled = count >= MAX_PRODUCTS;
    btn.textContent = count >= MAX_PRODUCTS ? 'Maximum 5 products reached' : '+ Add Another Product (up to 5)';
  }
})();
</script>

{% schema %}
{
  "name": "Process Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Custom Order Process"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Fill out the details below so we can create something unique for you."
    },
    {
      "type": "image_picker",
      "id": "size_chart_image",
      "label": "Size Chart Image"
    },
    {
      "type": "number",
      "id": "design_fee_amount",
      "label": "Design Fee per Product (INR)",
      "default": 499
    }
  ],
  "presets": [
    {
      "name": "Process Page"
    }
  ]
}
{% endschema %}
