<script>
(function() {
  // Slideshow for creative section
  const images = document.querySelectorAll('.creative-image');
  const dotsContainer = document.querySelector('[data-creative-dots]');
  let currentSlide = 0;
  let slideTimer;

  function goToSlide(index) {
    images[currentSlide].classList.remove('active');
    currentSlide = index;
    images[currentSlide].classList.add('active');
    if (dotsContainer) {
      dotsContainer.querySelectorAll('.creative-dot').forEach((d, i) => {
        d.classList.toggle('active', i === currentSlide);
      });
    }
  }

  function startAutoplay() {
    if (images.length <= 1) return;
    clearInterval(slideTimer);
    slideTimer = setInterval(() => {
      goToSlide((currentSlide + 1) % images.length);
    }, 4000);
  }

  if (images.length > 1 && dotsContainer) {
    images.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'creative-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      dot.addEventListener('click', () => {
        goToSlide(i);
        startAutoplay();
      });
      dotsContainer.appendChild(dot);
    });
  }

  startAutoplay();

  const DESIGN_FEE = {{ section.settings.design_fee_amount | default: 400 }};
  let productCount = 1;
  const MAX_PRODUCTS = 5;

  // Track selected apparels to show/hide pricing
  const selectedApparels = new Set();

  var PROCESS_SIZE_ROW_HTML =
    '<div class="process-size-label-row">' +
      '<label class="form-label process-size-label">Size <span class="required">*</span></label>' +
      '<button type="button" class="sizing-guide-link process-sizing-guide" style="display:none;" onclick="openProcessSizeChart(this)" aria-haspopup="dialog">' +
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
          '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>' +
          '<polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline>' +
          '<line x1="12" y1="22.08" x2="12" y2="11.73"></line>' +
        '</svg>' +
        ' Sizing guide' +
      '</button>' +
    '</div>';

  /* ── Size chart per apparel type ────────────────────────── */
  var SIZECHART_URLS = {
    'Cropped Tee':   '{{ section.settings.size_chart_cropped_tee | image_url: width: 700 }}',
    'Regular Tee':   '{{ section.settings.size_chart_regular_tee | image_url: width: 700 }}',
    'Oversized Tee': '{{ section.settings.size_chart_oversized_tee | image_url: width: 700 }}',
    'Boxy Vest':     '{{ section.settings.size_chart_boxy_vest | image_url: width: 700 }}',
    'Sweatshirt':    '{{ section.settings.size_chart_sweatshirt | image_url: width: 700 }}',
    'Hoodie':        '{{ section.settings.size_chart_hoodie | image_url: width: 700 }}'
  };

  function updateSizeChart(block, apparel) {
    if (!block) return;
    var url = SIZECHART_URLS[apparel] || '';
    var toggle = block.querySelector('.process-sizing-guide');
    if (toggle) toggle.style.display = url ? 'inline-flex' : 'none';
  }

  window.openProcessSizeChart = function(btn) {
    var block = btn.closest('.product-block');
    if (!block) return;
    var apparel = '';
    var sel = block.querySelector('.apparel-select');
    if (sel) apparel = sel.value || '';
    var url = SIZECHART_URLS[apparel] || '';
    var overlay = document.getElementById('process-size-chart-overlay');
    var img = document.getElementById('process-size-chart-img');
    var empty = document.getElementById('process-size-chart-empty');
    var titleSpan = document.getElementById('process-size-chart-apparel');
    if (titleSpan) titleSpan.textContent = apparel;
    if (img && empty) {
      if (url) {
        img.src = url;
        img.alt = 'Size chart for ' + apparel;
        img.style.display = '';
        empty.style.display = 'none';
      } else {
        img.removeAttribute('src');
        img.alt = '';
        img.style.display = 'none';
        empty.style.display = 'block';
      }
    }
    if (overlay) {
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  };

  window.closeProcessSizeChart = function() {
    var overlay = document.getElementById('process-size-chart-overlay');
    if (overlay) {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
    }
    document.body.style.overflow = '';
  };

  // Update price breakdown visibility when apparel changes
  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('apparel-select')) {
      updatePriceBreakdown();
      updateFee();
      updateSizeChart(e.target.closest('.product-block'), e.target.value);
    }
  });

  // Update price breakdown to show only selected apparels
  function updatePriceBreakdown() {
    selectedApparels.clear();

    // Collect all selected apparels
    document.querySelectorAll('.apparel-select').forEach(function(select) {
      if (select.value) {
        selectedApparels.add(select.value);
      }
    });

    // Show/hide the entire design fee and price breakdown sections
    var hasSelected = selectedApparels.size > 0;
    var designFeeSection = document.querySelector('.design-fee-section');
    var priceBreakdownSection = document.querySelector('.price-breakdown-section');

    if (designFeeSection) {
      designFeeSection.style.display = hasSelected ? 'block' : 'none';
    }
    if (priceBreakdownSection) {
      priceBreakdownSection.style.display = hasSelected ? 'block' : 'none';
    }

    // Show/hide pricing blocks
    document.querySelectorAll('.apparel-pricing').forEach(function(block) {
      var apparelName = block.querySelector('.apparel-name').textContent;
      block.style.display = selectedApparels.has(apparelName) ? 'block' : 'none';
    });
  }

  // #63: Block adding a new product until the previous one is filled
  function isProductBlockComplete(block) {
    if (!block) return false;
    var requiredFields = block.querySelectorAll('select[required], input[required]');
    for (var i = 0; i < requiredFields.length; i++) {
      if (!requiredFields[i].value || requiredFields[i].value === '') return false;
    }
    return true;
  }

  // Add product function
  window.addProduct = function() {
    if (productCount >= MAX_PRODUCTS) return;

    // #63: validate previous product is filled
    var blocks = document.querySelectorAll('.product-block');
    var lastBlock = blocks[blocks.length - 1];
    if (!isProductBlockComplete(lastBlock)) {
      alert('Please fill out the current product (apparel + size) before adding another one.');
      // Highlight first empty field
      var firstEmpty = lastBlock.querySelector('select[required]:invalid, input[required]:invalid');
      if (firstEmpty) {
        firstEmpty.style.borderColor = '#e53935';
        firstEmpty.focus();
        setTimeout(function() { firstEmpty.style.borderColor = ''; }, 2500);
      }
      return;
    }

    productCount++;

    var container = document.getElementById('productBlocksContainer');
    var block = document.createElement('div');
    block.className = 'product-block';
    block.dataset.product = productCount;
    block.innerHTML =
      '<div class="product-block-header">' +
        '<span class="product-block-title">Product ' + productCount + '</span>' +
        '<button type="button" class="remove-product-btn" onclick="removeProduct(this)">Remove</button>' +
      '</div>' +
      '<div class="form-group">' +
        '<label class="form-label">Choice of Apparel <span class="required">*</span></label>' +
        '<select name="contact[product_' + productCount + '_apparel]" class="form-select apparel-select" data-product="' + productCount + '" required>' +
          '<option value="" disabled selected>Select Apparel Type</option>' +
          '<option value="Cropped Tee">Cropped Tee (Only front printing)</option>' +
          '<option value="Regular Tee">Regular Tee</option>' +
          '<option value="Oversized Tee">Oversized Tee</option>' +
          '<option value="Boxy Vest">Boxy Vest</option>' +
          '<option value="Sweatshirt">Sweatshirt</option>' +
          '<option value="Hoodie">Hoodie</option>' +
        '</select>' +
      '</div>' +
      '<div class="form-group">' +
        PROCESS_SIZE_ROW_HTML +
        '<select name="contact[product_' + productCount + '_size]" class="form-select" required>' +
          '<option value="" disabled selected>Pick a Size</option>' +
          '<option value="XS">XS</option>' +
          '<option value="S">S</option>' +
          '<option value="M">M</option>' +
          '<option value="L">L</option>' +
          '<option value="XL">XL</option>' +
          '<option value="XXL">XXL</option>' +
        '</select>' +
      '</div>';

    container.appendChild(block);
    updateFee();
    updateAddButton();
  };

  // Remove product function
  window.removeProduct = function(btn) {
    var block = btn.closest('.product-block');
    block.remove();
    productCount--;

    // Renumber remaining blocks
    var blocks = document.querySelectorAll('.product-block');
    blocks.forEach(function(b, i) {
      var num = i + 1;
      b.dataset.product = num;
      b.querySelector('.product-block-title').textContent = 'Product ' + num;

      // Update name attributes
      var selects = b.querySelectorAll('select');
      var inputs = b.querySelectorAll('input');
      selects.forEach(function(s) {
        s.name = s.name.replace(/product_\d+/, 'product_' + num);
        if (s.classList.contains('apparel-select')) {
          s.dataset.product = num;
        }
      });
      inputs.forEach(function(inp) {
        if (inp.name) inp.name = inp.name.replace(/product_\d+/, 'product_' + num);
      });
    });

    updatePriceBreakdown();
    updateFee();
    updateAddButton();
  };

  function updateFee() {
    var count = document.querySelectorAll('.product-block').length;
    document.getElementById('productCountField').value = count;
    var totalFee = DESIGN_FEE * count;
    document.getElementById('designFeeField').value = totalFee;
    var feeDisplay = document.getElementById('proceedFeeDisplay');
    if (feeDisplay) feeDisplay.textContent = totalFee;
  }

  function updateAddButton() {
    var btn = document.getElementById('addProductBtn');
    var count = document.querySelectorAll('.product-block').length;
    btn.disabled = count >= MAX_PRODUCTS;
    btn.textContent = count >= MAX_PRODUCTS ? 'Maximum 5 products reached' : '+ Add Another Product (up to 5)';
  }

  /* ==================================================================
     #62: Save form progress to localStorage so users can resume later.
     Saves on every change. Prompts to restore on next visit.
     ================================================================== */
  var STORAGE_KEY = 'fitkaar:processFormState';
  var SAVE_DEBOUNCE = 400;
  var saveTimer;

  function snapshotForm() {
    var form = document.querySelector('.process-form-container form');
    if (!form) return null;
    var data = {};
    var fields = form.querySelectorAll('input, select, textarea');
    fields.forEach(function(f) {
      // Skip files (can't be persisted)
      if (f.type === 'file') return;
      if (!f.name) return;
      data[f.name] = f.value;
    });
    data.__productCount = document.querySelectorAll('.product-block').length;
    data.__savedAt = Date.now();
    return data;
  }

  function debounceSave() {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(function() {
      var snap = snapshotForm();
      if (!snap) return;
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(snap)); } catch (e) {}
    }, SAVE_DEBOUNCE);
  }

  function loadSavedSnapshot() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      var data = JSON.parse(raw);
      // Expire after 7 days
      if (data.__savedAt && (Date.now() - data.__savedAt) > 7 * 24 * 60 * 60 * 1000) {
        localStorage.removeItem(STORAGE_KEY);
        return null;
      }
      return data;
    } catch (e) { return null; }
  }

  window.discardFormProgress = function() {
    try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
    var banner = document.getElementById('restoreProgressBanner');
    if (banner) banner.classList.remove('active');
  };

  window.restoreFormProgress = function() {
    var data = loadSavedSnapshot();
    if (!data) return;

    // Recreate the right number of product blocks first
    var targetCount = parseInt(data.__productCount || 1, 10);
    while (document.querySelectorAll('.product-block').length < targetCount && productCount < MAX_PRODUCTS) {
      // bypass the validation since we trust the saved data
      productCount++;
      var container = document.getElementById('productBlocksContainer');
      var block = document.createElement('div');
      block.className = 'product-block';
      block.dataset.product = productCount;
      block.innerHTML =
        '<div class="product-block-header">' +
          '<span class="product-block-title">Product ' + productCount + '</span>' +
          '<button type="button" class="remove-product-btn" onclick="removeProduct(this)">Remove</button>' +
        '</div>' +
        '<div class="form-group">' +
          '<label class="form-label">Choice of Apparel <span class="required">*</span></label>' +
          '<select name="contact[product_' + productCount + '_apparel]" class="form-select apparel-select" data-product="' + productCount + '" required>' +
            '<option value="" disabled selected>Select Apparel Type</option>' +
            '<option value="Cropped Tee">Cropped Tee (Only front printing)</option>' +
            '<option value="Regular Tee">Regular Tee</option>' +
            '<option value="Oversized Tee">Oversized Tee</option>' +
            '<option value="Boxy Vest">Boxy Vest</option>' +
            '<option value="Sweatshirt">Sweatshirt</option>' +
            '<option value="Hoodie">Hoodie</option>' +
          '</select>' +
        '</div>' +
        '<div class="form-group">' +
          PROCESS_SIZE_ROW_HTML +
          '<select name="contact[product_' + productCount + '_size]" class="form-select" required>' +
            '<option value="" disabled selected>Pick a Size</option>' +
            '<option value="XS">XS</option>' +
            '<option value="S">S</option>' +
            '<option value="M">M</option>' +
            '<option value="L">L</option>' +
            '<option value="XL">XL</option>' +
            '<option value="XXL">XXL</option>' +
          '</select>' +
        '</div>';
      container.appendChild(block);
    }

    // Now populate field values
    var form = document.querySelector('.process-form-container form');
    if (form) {
      Object.keys(data).forEach(function(name) {
        if (name.indexOf('__') === 0) return;
        var field = form.querySelector('[name="' + name.replace(/"/g, '\\"') + '"]');
        if (field && field.type !== 'file') field.value = data[name];
      });
    }

    updatePriceBreakdown();
    updateFee();
    updateAddButton();

    // Restore sizing guide button visibility per block
    document.querySelectorAll('.product-block').forEach(function(b) {
      var sel = b.querySelector('.apparel-select');
      if (sel && sel.value) updateSizeChart(b, sel.value);
    });

    var banner = document.getElementById('restoreProgressBanner');
    if (banner) banner.classList.remove('active');
  };

  // Hook saving on every input change
  document.addEventListener('input', function(e) {
    if (e.target.closest('.process-form-container')) debounceSave();
  });
  document.addEventListener('change', function(e) {
    if (e.target.closest('.process-form-container')) debounceSave();
  });

  // On load, prompt to restore if we have saved data
  document.addEventListener('DOMContentLoaded', function() {
    var saved = loadSavedSnapshot();
    if (saved) {
      var banner = document.getElementById('restoreProgressBanner');
      if (banner) banner.classList.add('active');
    }

    var chartOv = document.getElementById('process-size-chart-overlay');
    if (chartOv) {
      chartOv.addEventListener('click', function(e) {
        if (e.target === chartOv) closeProcessSizeChart();
      });
    }
    document.addEventListener('keydown', function(e) {
      if (e.key !== 'Escape') return;
      var o = document.getElementById('process-size-chart-overlay');
      if (o && o.classList.contains('is-open')) closeProcessSizeChart();
    });
  });

  // Cart-based checkout — add Design Advance to cart, then redirect to /checkout
  var variantId = parseInt('{{ section.settings.design_fee_variant_id }}', 10) || 0;
  var waLink = {{ section.settings.whatsapp_link | default: 'https://wa.me/message/O4GF737LSF3YC1' | json }};
  var IMGBB_KEY = {{ section.settings.imgbb_api_key | default: '' | json }};
  var formEl = document.getElementById('processForm');
  var proceedBtn = document.getElementById('proceedBtn');

  // Upload a single File to imgbb; returns the public URL or null on failure
  async function uploadFileToImgbb(file, thumbEl) {
    if (!IMGBB_KEY) return null;
    if (thumbEl) thumbEl.classList.add('upload-thumb--uploading');
    try {
      var fd = new FormData();
      fd.append('image', file);
      var res = await fetch('https://api.imgbb.com/1/upload?key=' + IMGBB_KEY, { method: 'POST', body: fd });
      var json = await res.json();
      if (json.success) {
        if (thumbEl) {
          thumbEl.classList.remove('upload-thumb--uploading');
          thumbEl.classList.add('upload-thumb--done');
          var img = document.createElement('img');
          img.src = json.data.thumb ? json.data.thumb.url : json.data.url;
          thumbEl.innerHTML = '';
          thumbEl.appendChild(img);
        }
        return json.data.url;
      }
    } catch (err) {}
    if (thumbEl) {
      thumbEl.classList.remove('upload-thumb--uploading');
      thumbEl.classList.add('upload-thumb--error');
      thumbEl.textContent = 'Failed';
    }
    return null;
  }

  // Build preview thumbs for a file input and upload all files; returns array of URLs
  // Show local previews immediately when files are chosen
  function showPreviews(inputEl, statusEl) {
    if (!statusEl) return;
    statusEl.innerHTML = '';
    if (!inputEl || !inputEl.files || !inputEl.files.length) return;
    Array.from(inputEl.files).forEach(function(file) {
      var thumb = document.createElement('div');
      thumb.className = 'upload-thumb';
      var reader = new FileReader();
      reader.onload = function(e) {
        var img = document.createElement('img');
        img.src = e.target.result;
        thumb.innerHTML = '';
        thumb.appendChild(img);
      };
      reader.readAsDataURL(file);
      statusEl.appendChild(thumb);
    });
  }

  // Wire up instant previews on file select
  var photosInput = document.getElementById('processPhotosInput');
  var photosStatus = document.getElementById('processPhotosStatus');
  var refsInput = document.getElementById('processRefsInput');
  var refsStatus = document.getElementById('processRefsStatus');

  if (photosInput) photosInput.addEventListener('change', function() { showPreviews(photosInput, photosStatus); });
  if (refsInput)   refsInput.addEventListener('change',   function() { showPreviews(refsInput,  refsStatus);  });

  async function uploadFilesFromInput(inputEl, statusEl) {
    if (!inputEl || !inputEl.files || !inputEl.files.length) return [];
    var files = Array.from(inputEl.files);
    // Reuse existing thumbs already rendered by showPreviews
    var thumbEls = statusEl ? Array.from(statusEl.querySelectorAll('.upload-thumb')) : [];
    // Pad in case counts differ
    while (thumbEls.length < files.length) {
      var t = document.createElement('div');
      t.className = 'upload-thumb';
      if (statusEl) statusEl.appendChild(t);
      thumbEls.push(t);
    }
    var urls = await Promise.all(files.map(function(file, i) {
      return uploadFileToImgbb(file, thumbEls[i]);
    }));
    return urls.filter(Boolean);
  }

  function showProceedError(msg) {
    var el = document.getElementById('proceedError');
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function hideProceedError() {
    var el = document.getElementById('proceedError');
    if (el) el.style.display = 'none';
  }

  function setLoading(on) {
    if (!proceedBtn) return;
    proceedBtn.disabled = on;
    if (on) {
      proceedBtn.innerHTML = 'Redirecting to checkout&#8230;';
    } else {
      var fee = document.getElementById('designFeeField').value || DESIGN_FEE;
      proceedBtn.innerHTML = 'Proceed &amp; Pay &#8377;<span id="proceedFeeDisplay">' + fee + '</span> Design Advance';
    }
  }

  if (formEl) {
    formEl.addEventListener('submit', async function(e) {
      e.preventDefault();
      hideProceedError();

      if (!formEl.checkValidity()) {
        formEl.reportValidity();
        return;
      }

      if (!variantId) {
        showProceedError('Checkout is not configured yet. Please contact us on WhatsApp.');
        return;
      }

      var count = document.querySelectorAll('.product-block').length;
      var fee = DESIGN_FEE * count;

      // Collect all form values
      var name    = (document.getElementById('ContactFormName') || {}).value || '';
      var email   = (document.getElementById('ContactFormEmail') || {}).value || '';
      var phone   = (document.getElementById('ContactFormPhone') || {}).value || '';
      var purpose = (document.getElementById('ContactFormPurpose') || {}).value || '';
      var gender  = (document.getElementById('ContactFormGender') || {}).value || '';
      var hobbies = (document.getElementById('ContactFormHobbies') || {}).value || '';
      var food    = (document.getElementById('ContactFormFood') || {}).value || '';
      var quotes  = (document.getElementById('ContactFormQuotes') || {}).value || '';
      var jokes   = (document.getElementById('ContactFormJokes') || {}).value || '';
      var symbols = (document.getElementById('ContactFormSymbols') || {}).value || '';
      var colour  = (document.getElementById('ContactFormColourPref') || {}).value || '';
      var other   = (document.getElementById('ContactFormElements') || {}).value || '';

      var productLines = [];
      document.querySelectorAll('.product-block').forEach(function(block, i) {
        var apparel = (block.querySelector('.apparel-select') || {}).value || '';
        var sizeEl  = block.querySelector('select[name*="_size"]');
        var size    = sizeEl ? sizeEl.value : '';
        productLines.push('Product ' + (i + 1) + ': ' + apparel + ' (' + size + ')');
      });

      // Upload photos to imgbb before submitting
      setLoading(true);
      if (proceedBtn) proceedBtn.innerHTML = 'Uploading photos&#8230;';

      var photoUrls = await uploadFilesFromInput(
        document.getElementById('processPhotosInput'),
        document.getElementById('processPhotosStatus')
      );
      var refUrls = await uploadFilesFromInput(
        document.getElementById('processRefsInput'),
        document.getElementById('processRefsStatus')
      );

      if (proceedBtn) proceedBtn.innerHTML = 'Redirecting to checkout&#8230;';

      // Build cart note (visible in Shopify admin order)
      var noteParts = [
        '=== FITKAAR CUSTOM ORDER ===',
        'Name: ' + name,
        'Phone: ' + phone,
        'Email: ' + email,
        'Purpose: ' + purpose,
        gender  ? 'Recipient Gender: ' + gender  : '',
        '',
        '--- Products (' + count + ') ---',
        productLines.join('\n'),
        '',
        '--- Design Brief ---',
        hobbies ? 'Hobbies / Interests: ' + hobbies : '',
        food    ? 'Favourite Food: '       + food    : '',
        quotes  ? 'Quotes / Words: '       + quotes  : '',
        jokes   ? 'Inside Jokes / Traits: '+ jokes   : '',
        symbols ? 'Symbols / Elements: '   + symbols : '',
        colour  ? 'Colour Preference: '    + colour  : '',
        other   ? 'Other Details: '        + other   : '',
        '',
        '--- Uploads ---',
        photoUrls.length ? 'Photos:\n' + photoUrls.join('\n') : 'Photos: (none uploaded — customer will WhatsApp)',
        refUrls.length   ? 'References:\n' + refUrls.join('\n') : 'References: (none uploaded)',
        '',
        'Design Advance: ₹' + fee + ' (' + count + ' × ₹' + DESIGN_FEE + ')',
      ].filter(Boolean).join('\n');

      // Add Design Advance product to cart
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            id: variantId,
            quantity: count,
            properties: {
              'Name':     name,
              'Phone':    phone,
              'Products': productLines.join(', ')
            }
          }]
        })
      })
      .then(function(r) {
        if (!r.ok) return r.json().then(function(d) { throw new Error(d.description || 'Cart error'); });
        // Attach order brief as cart note (visible in Shopify admin)
        return fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ note: noteParts })
        });
      })
      .then(function() {
        // Clear saved progress now that submission succeeded
        try { localStorage.removeItem(STORAGE_KEY); } catch (ex) {}
        // Go straight to checkout — WhatsApp prompt appears on the thank you page after payment
        window.location.href = '/checkout';
      })
      .catch(function(err) {
        setLoading(false);
        showProceedError((err && err.message) || 'Something went wrong. Please try again or reach us on WhatsApp.');
      });
    });
  }
})();
</script>

<script>
(function() {
  var track = document.getElementById('nhc-track');
  var marquee = document.getElementById('nhc-marquee');
  if (!track || !marquee) return;

  var speed = 40;
  var half = 0;
  var pos = 0;
  var lastTs = null;
  var paused = false;

  function computeHalf() { half = track.scrollWidth / 2; }
  computeHalf();
  window.addEventListener('resize', computeHalf);

  marquee.addEventListener('mouseenter', function() { paused = true; });
  marquee.addEventListener('mouseleave', function() { paused = false; });

  document.addEventListener('visibilitychange', function() {
    paused = document.hidden;
    if (!document.hidden) lastTs = null;
  });

  function step(ts) {
    if (!paused) {
      if (lastTs !== null && half > 0) {
        pos += (half / (speed * 1000)) * (ts - lastTs);
        if (pos >= half) pos -= half;
        track.style.transform = 'translateX(-' + pos.toFixed(3) + 'px)';
      }
      lastTs = ts;
    }
    requestAnimationFrame(step);
  }

  requestAnimationFrame(step);
})();
</script>

