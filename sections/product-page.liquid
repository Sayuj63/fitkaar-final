      findVariantIdForSize(size) {
        const want = this.normOpt(size);
        const pick = (availOnly) => this.variants.find(v => {
          if (availOnly && !v.available) return false;
          {% if color_opt %}
          if (this.normOpt(v.option{{ color_opt.position }}) !== this.normOpt(this.selectedColor)) return false;
          {% endif %}
          {% if type_opt %}
          if (this.normOpt(v.option{{ type_opt.position }}) !== this.normOpt(this.selectedType)) return false;
          {% endif %}
          {% if size_opt %}
          return this.normOpt(v.option{{ size_opt.position }}) === want;
          {% endif %}
          return false;
        });
        const hit = pick(true) || pick(false);
        return hit ? hit.id : null;
      },

      customFields: {{ custom_fields_json }},
      uploadingFields: {},
      uploadPreviews: {},
      uploadErrors: {},

      get customisationValid() {
        const vals = Object.values(this.customFields);
        if (!vals.length) return true;
        return vals.every(function(v) { return v && v.trim().length > 0; });
      },

      async uploadPhoto(label, event) {
        const file = event.target.files[0];
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          this.uploadErrors[label] = 'Please select an image file.';
          return;
        }
        const apiKey = {{ section.settings.imgbb_api_key | default: '' | json }};
        if (!apiKey) {
          this.uploadErrors[label] = 'Upload not configured — please contact the store.';
          return;
        }
        this.uploadErrors[label] = '';
        this.uploadingFields[label] = true;
        this.customFields[label] = '';
        this.uploadPreviews[label] = '';
        try {
          const fd = new FormData();
          fd.append('image', file);
          const res = await fetch('https://api.imgbb.com/1/upload?key=' + apiKey, { method: 'POST', body: fd });
          const json = await res.json();
          if (json.success) {
            this.customFields[label] = json.data.url;
            this.uploadPreviews[label] = json.data.thumb ? json.data.thumb.url : json.data.url;
          } else {
            this.uploadErrors[label] = 'Upload failed — please try again.';
          }
        } catch(e) {
          this.uploadErrors[label] = 'Upload failed — check your connection.';
        } finally {
          this.uploadingFields[label] = false;
        }
      },

      buildCartItems() {
        const item = { id: this.selectedVariantId, quantity: this.quantity };
        const props = {};
        for (const [k, v] of Object.entries(this.customFields)) {
          if (v && v.trim()) props[k] = v.trim();
        }
        if (Object.keys(props).length) item.properties = props;
        return [item];
      },

