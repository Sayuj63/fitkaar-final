  @media (min-width: 1024px) { .pdp-strip__grid { grid-template-columns: repeat(5, 1fr); } }

  .pdp-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 12px;
    overflow: hidden;
