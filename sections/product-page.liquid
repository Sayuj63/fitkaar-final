        if (t.includes('hoodie')) return 'Hoodie';
        if (t.includes('sweatshirt')) return 'Sweatshirt';
        if (t.includes('boxy') || t === 'vest') return 'Boxy Vest';
        if (t.includes('cropped')) return 'Cropped Tee';
        if (t.includes('oversized')) return 'Oversized Tee';
        if (t.includes('regular') || t.includes('t-shirt') || t.includes('tshirt') || t === 'tee' || t === 'tees') return 'Regular Tee';
        return 'Regular Tee';
      },

      get descriptionLines() {
