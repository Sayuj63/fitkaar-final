{%- comment -%} Recently viewed — populated client-side via localStorage {%- endcomment -%}
<section class="pdp-strip pdp-strip--hidden" id="RecentlyViewedStrip" aria-hidden="true">
  <div class="pdp-strip__inner">
    <h2 class="pdp-strip__title">Recently viewed</h2>
    <div class="pdp-strip__grid" id="RecentlyViewedGrid"></div>
  </div>
</section>

<script>
(function() {
  var STORAGE_KEY = 'fitkaar:recentlyViewed';
  var MAX_ITEMS = 12;

  var currentProduct = {
    id: {{ product.id | json }},
    handle: {{ product.handle | json }},
    url: {{ product.url | json }},
    title: {{ product.title | json }},
    price: {{ product.price | json }},
    image: {{ product.featured_image | image_url: width: 500 | json }}
  };

  function read() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch (e) { return []; }
  }
  function write(list) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch (e) {}
  }

  var list = read().filter(function(item) { return item && item.id !== currentProduct.id; });
  list.unshift(currentProduct);
  if (list.length > MAX_ITEMS) list = list.slice(0, MAX_ITEMS);
  write(list);

  var toRender = list.filter(function(item) { return item.id !== currentProduct.id; }).slice(0, 5);
  if (toRender.length === 0) return;

  var strip = document.getElementById('RecentlyViewedStrip');
  var grid  = document.getElementById('RecentlyViewedGrid');
  if (!strip || !grid) return;

  grid.innerHTML = toRender.map(function(p) {
    var priceText = (typeof p.price === 'number') ? ('₹' + (p.price / 100) + '/-') : '';
    var imgHtml = p.image
      ? '<img src="' + p.image + '" alt="' + escapeAttr(p.title || '') + '" loading="lazy">'
      : '';
    return '<a href="' + escapeAttr(p.url || '#') + '" class="pdp-card">' +
             '<div class="pdp-card__image">' + imgHtml + '</div>' +
             '<div class="pdp-card__info">' +
               '<h3 class="pdp-card__title">' + escapeHtml(p.title || '') + '</h3>' +
               (priceText ? '<div class="pdp-card__price">' + priceText + '</div>' : '') +
             '</div>' +
           '</a>';
  }).join('');

  strip.classList.remove('pdp-strip--hidden');
  strip.setAttribute('aria-hidden', 'false');

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }
  function escapeAttr(s) {
    return escapeHtml(s).replace(/"/g, '&quot;');
  }
})();
</script>

<script>
  function productPage() {
    return {
      // Product data
      productId: {{ product.id }},
      productTitle: '{{ product.title | escape }}',
      productUrl: '{{ product.url }}',
      
      // Images Data (Loaded from Liquid)
      allImages: [
        {% for image in product.images %}
          {
            id: {{ image.id }},
            src: '{{ image | image_url: width: 800 }}',
            thumb: '{{ image | image_url: width: 200 }}',
            alt: `{{ image.alt | escape }}`
          },
        {% endfor %}
      ],

      // Carousel State
      currentSlide: 0,
      transitionImage: '',
      isTransitioning: false,
      touchStartX: 0,
      touchEndX: 0,
      
      // Computed: Visible Images based on selection (excludes size chart images)
      get visibleImages() {
        const isSizeChart = (img) => img.alt && img.alt.toLowerCase().includes('size chart');
        const isGeneric = (img) => !img.alt || img.alt === '' || img.alt === '{{ product.title | escape }}';

        // First try to find images matching the selected type + colour
        const matched = this.allImages.filter(img => {
          if (isSizeChart(img)) return false;
          if (isGeneric(img)) return false;

          const alt = img.alt.toLowerCase();

          // Filter by type first (e.g., "Hoodie")
          if (this.selectedType && !alt.includes(this.selectedType.toLowerCase())) return false;

          // Then filter by colour (e.g., "Black")
          if (this.selectedColor && !alt.includes(this.selectedColor.toLowerCase())) return false;

          return true;
        });

        // If we found matching images, use them; otherwise fall back to non-size-chart images
        if (matched.length > 0) return matched;
        return this.allImages.filter(img => !isSizeChart(img));
      },

      get totalSlides() {
        return this.visibleImages.length;
      },

      // Computed: Size chart image for the currently selected type
      get sizeChartImage() {
        if (!this.selectedType) return null;
        console.log('Looking for size chart. Type:', this.selectedType);
        console.log('All image alts:', this.allImages.map(img => img.alt));
        const found = this.allImages.find(img => {
          if (!img.alt) return false;
          const alt = img.alt.toLowerCase();
          return alt.includes('size chart') && alt.includes(this.selectedType.toLowerCase());
        }) || null;
        console.log('Found:', found);
        return found;
      },

      // Variants
      // Variants - Dynamic Initialization
      {% assign color_opt = null %}
      {% assign size_opt = null %}
      {% assign type_opt = null %}
      {% for option in product.options_with_values %}
        {% assign opt_name = option.name | downcase %}
        {% if opt_name contains 'color' or opt_name contains 'colour' %}
          {% assign color_opt = option %}
        {% elsif opt_name contains 'size' %}
          {% assign size_opt = option %}
        {% elsif opt_name contains 'type' %}
          {% assign type_opt = option %}
        {% endif %}
      {% endfor %}

      {% comment %}
        Pick the cheapest available variant as the default so the product page's
        opening price matches the "from" price shown on the collection card.
        If the URL has ?variant= (product.selected_variant), honour that instead.
      {% endcomment %}
      {% assign cheapest_variant = nil %}
      {% for v in product.variants %}
        {% if v.available %}
          {% if cheapest_variant == nil or v.price < cheapest_variant.price %}
            {% assign cheapest_variant = v %}
          {% endif %}
        {% endif %}
      {% endfor %}
      {% assign default_variant = product.selected_variant | default: cheapest_variant | default: product.selected_or_first_available_variant %}

      {%- assign default_color = '' -%}
      {%- assign default_size = '' -%}
      {%- assign default_type = '' -%}
      {%- if color_opt -%}
        {%- case color_opt.position -%}
          {%- when 1 -%}{%- assign default_color = default_variant.option1 -%}
          {%- when 2 -%}{%- assign default_color = default_variant.option2 -%}
          {%- when 3 -%}{%- assign default_color = default_variant.option3 -%}
        {%- endcase -%}
      {%- endif -%}
      {%- if size_opt -%}
        {%- case size_opt.position -%}
          {%- when 1 -%}{%- assign default_size = default_variant.option1 -%}
          {%- when 2 -%}{%- assign default_size = default_variant.option2 -%}
          {%- when 3 -%}{%- assign default_size = default_variant.option3 -%}
        {%- endcase -%}
      {%- endif -%}
      {%- if type_opt -%}
        {%- case type_opt.position -%}
          {%- when 1 -%}{%- assign default_type = default_variant.option1 -%}
          {%- when 2 -%}{%- assign default_type = default_variant.option2 -%}
          {%- when 3 -%}{%- assign default_type = default_variant.option3 -%}
        {%- endcase -%}
      {%- endif -%}

      selectedColor: {{ default_color | default: '' | json }},
      selectedSize: {{ default_size | default: '' | json }},
      selectedType: {{ default_type | default: '' | json }},
      selectedVariantId: {{ default_variant.id }},

      // Variants JSON
      variants: {{ product.variants | json }},

      // Quantity
      quantity: 1,

      // Per-unit sizes (one entry per unit when quantity > 1)
      unitSizes: [],

      initUnitSizes() {
        this.unitSizes = [this.selectedSize];
        this.$watch('quantity', (newQty) => {
          const qty = Math.max(1, parseInt(newQty, 10) || 1);
          if (this.unitSizes.length < qty) {
            while (this.unitSizes.length < qty) this.unitSizes.push(this.selectedSize);
          } else if (this.unitSizes.length > qty) {
            this.unitSizes = this.unitSizes.slice(0, qty);
          }
        });
        this.$watch('selectedSize', (newSize, oldSize) => {
          // If every unit still shows the old main size, mirror the new one across all units.
          // Otherwise the customer has customised each unit — leave them alone.
          if (this.unitSizes.every(s => s === oldSize)) {
            this.unitSizes = this.unitSizes.map(() => newSize);
          }
        });
      },

      setUnitSize(idx, size) {
        const copy = this.unitSizes.slice();
        copy[idx] = size;
        this.unitSizes = copy;
      },

      findVariantIdForSize(size) {
        const variant = this.variants.find(v => {
          const options = [v.option1, v.option2, v.option3].filter(Boolean);
          const selected = [this.selectedColor, size, this.selectedType].filter(Boolean);
          return selected.every(sel => options.includes(sel));
        });
        return variant ? variant.id : null;
      },

      buildCartItems() {
        if (this.quantity <= 1) {
          return [{ id: this.selectedVariantId, quantity: 1 }];
        }
        const counts = {};
        for (let i = 0; i < this.quantity; i++) {
          const size = this.unitSizes[i] || this.selectedSize;
          const id = this.findVariantIdForSize(size) || this.selectedVariantId;
          counts[id] = (counts[id] || 0) + 1;
        }
        return Object.keys(counts).map(id => ({ id: parseInt(id, 10), quantity: counts[id] }));
      },

      // UI State
      isAddingToCart: false,
      sizeChartOpen: false,

      // Only one accordion open at a time
      openAccordion: 'description',
      toggleAccordion(key) {
        this.openAccordion = this.openAccordion === key ? null : key;
      },

      // Per-apparel Description (changes with selectedType)
      descriptionsByType: {
        'Hoodie': [
          { label: 'Composition', value: 'Heavyweight Cotton fleece' },
          { label: 'Fabric Weight', value: '450 GSM' },
          { label: 'Print Type', value: 'DTF Printing' },
          { label: 'Country of Production', value: 'India' }
        ],
        'Sweatshirt': [
          { label: 'Neckline', value: 'Crewneck' },
          { label: 'Composition', value: 'Thick Cotton fleece' },
          { label: 'Fabric Weight', value: '360 GSM' },
          { label: 'Print Type', value: 'DTF Printing' },
          { label: 'Country of Production', value: 'India' }
        ],
        'Boxy Vest': [
          { label: 'Neckline', value: 'Round Neck' },
          { label: 'Composition', value: '100% Cotton' },
          { label: 'Fabric Weight', value: '240 GSM' },
          { label: 'Print Type', value: 'DTF Printing' },
          { label: 'Country of Production', value: 'India' }
        ],
        'Cropped Tee': [
          { label: 'Neckline', value: 'Round Neck' },
          { label: 'Composition', value: '100% Cotton' },
          { label: 'Fabric Weight', value: '180 GSM' },
          { label: 'Print Type', value: 'DTF Printing' },
          { label: 'Country of Production', value: 'India' }
        ],
        'Regular Tee': [
          { label: 'Neckline', value: 'Round Neck' },
          { label: 'Composition', value: '100% Cotton' },
          { label: 'Fabric Weight', value: '180 GSM' },
          { label: 'Print Type', value: 'DTF Printing' },
          { label: 'Country of Production', value: 'India' }
        ],
        'Oversized Tee': [
          { label: 'Neckline', value: 'Round Neck' },
          { label: 'Composition', value: '100% Cotton' },
          { label: 'Fabric Weight', value: '180 GSM' },
          { label: 'Print Type', value: 'DTF Printing' },
          { label: 'Country of Production', value: 'India' }
        ]
      },

      // Per-apparel Product Feel & Fit
      feelFitByType: {
        'Hoodie': [
          'Heavyweight Cotton fleece fabric with a thick, premium feel',
          'Brushed inner surface that provides warmth and insulation',
          'Comfortable full sleeves with ribbed cuffs and neckline',
          'Designed to keep you warm and cosy during winters',
          'Unisex design that is easy to style for everyday wear'
        ],
        'Sweatshirt': [
          'Soft cotton fleece fabric with a thick, premium feel',
          'Brushed inner surface that provides warmth and insulation',
          'Comfortable full sleeves with ribbed cuffs and neckline',
          'Designed to keep you warm and cosy during winters',
          'Unisex design that is easy to style for everyday wear'
        ],
        'Boxy Vest': [
          'Soft, printed cotton fabric with a smooth feel on the skin',
          'Ribbed trim around the neckline',
          'Comfortable cut sleeves for ease of movement',
          'Breathable and suitable for Indian weather',
          'Unisex design that is easy to style for everyday wear'
        ],
        'Cropped Tee': [
          'Soft, printed cotton fabric with a smooth feel on the skin',
          'Ribbed trim around the neckline',
          'Body-hugging silhouette',
          'Cropped length for a fitted, flattering look',
          'Breathable and suitable for Indian weather'
        ],
        'Regular Tee': [
          'Soft, printed cotton fabric with a smooth feel on the skin',
          'Ribbed trim around the neckline',
          'Comfortable half sleeves for ease of movement',
          'Breathable and suitable for Indian weather',
          'Unisex design that is easy to style for everyday wear'
        ],
        'Oversized Tee': [
          'Soft, printed cotton fabric with a smooth feel on the skin',
          'Ribbed trim around the neckline',
          'Relaxed, oversized silhouette for a trendy street-style look',
          'Breathable and suitable for Indian weather',
          'Unisex design that is easy to style for everyday wear'
        ]
      },

      normalizeType(type) {
        if (!type) return 'Regular Tee';
        const t = String(type).toLowerCase().trim();
        if (t.includes('hoodie')) return 'Hoodie';
        if (t.includes('sweatshirt')) return 'Sweatshirt';
        if (t.includes('boxy') || t === 'vest') return 'Boxy Vest';
        if (t.includes('cropped')) return 'Cropped Tee';
        if (t.includes('oversized')) return 'Oversized Tee';
        if (t.includes('regular') || t.includes('t-shirt') || t.includes('tshirt') || t === 'tee' || t === 'tees') return 'Regular Tee';
        return 'Regular Tee';
      },

      get descriptionLines() {
        return this.descriptionsByType[this.normalizeType(this.selectedType)]
            || this.descriptionsByType['Regular Tee'];
      },

      get feelFitLines() {
        return this.feelFitByType[this.normalizeType(this.selectedType)]
            || this.feelFitByType['Regular Tee'];
      },

      // Pincode
      pincode: '',
      pincodeStatus: '',
      pincodeMessage: '',

      // Toast
      toastVisible: false,
      toastMessage: '',

      // Carousel Methods
      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
      },

      prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
      },

      goToSlide(index) {
        this.currentSlide = index;
      },

      initSwipe() {
        const carousel = document.querySelector('.carousel-main');
        if (!carousel) return;

        carousel.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        carousel.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
        }, { passive: true });
      },

      handleSwipe() {
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }
      },

      // Available colours for the currently selected type
      get availableColorsForType() {
        if (!this.selectedType) return [];
        const colors = new Set();
        this.variants.forEach(v => {
          const opts = [v.option1, v.option2, v.option3];
          if (opts.includes(this.selectedType) && v.available) {
            // Find the colour option value
            {% if color_opt %}
              {% for cv in color_opt.values %}
                if (opts.includes('{{ cv }}')) colors.add('{{ cv }}');
              {% endfor %}
            {% endif %}
          }
        });
        return Array.from(colors);
      },

      isColorAvailable(color) {
        return this.availableColorsForType.includes(color);
      },

      // Available sizes for the currently selected type
      get availableSizesForType() {
        if (!this.selectedType) return [];
        const sizes = new Set();
        this.variants.forEach(v => {
          const opts = [v.option1, v.option2, v.option3];
          if (!opts.includes(this.selectedType)) return;
          if (!v.available) return;
          {% if size_opt %}
            {% for sv in size_opt.values %}
              if (opts.includes({{ sv | json }})) sizes.add({{ sv | json }});
            {% endfor %}
          {% endif %}
        });
        return Array.from(sizes);
      },

      isSizeAvailable(size) {
        return this.availableSizesForType.includes(size);
      },

      // Current variant price getter
      get currentVariantPrice() {
        const variant = this.variants.find(v => v.id === this.selectedVariantId);
        return variant ? variant.price : {{ default_variant.price }};
      },

      get currentVariantComparePrice() {
        const variant = this.variants.find(v => v.id === this.selectedVariantId);
        return variant ? (variant.compare_at_price || variant.price) : ({{ default_variant.compare_at_price | default: default_variant.price }});
      },

      // Variant Methods
      selectColor(color) {
        if (this.selectedColor === color) return;

        // 1. FREEZE: Capture current visible image
        const currentImg = this.visibleImages[this.currentSlide];
        if (currentImg) {
          this.transitionImage = currentImg.src;
          this.isTransitioning = true;
        }

        // 2. JUMP & DISSOLVE in next frame
        requestAnimationFrame(() => {
          this.selectedColor = color;
          this.updateVariant();

          // Reset to first slide since visibleImages will now show filtered results
          this.currentSlide = 0;

          // 3. FADE OUT overlay
          setTimeout(() => {
            this.isTransitioning = false;
            setTimeout(() => {
              if (!this.isTransitioning) this.transitionImage = '';
            }, 600);
          }, 50);
        });
      },

      selectSize(size) {
        this.selectedSize = size;
        this.updateVariant();
      },

      selectType(type) {
        if (this.selectedType === type) return;

        // 1. FREEZE: Capture current visible image
        const currentImg = this.visibleImages[this.currentSlide];
        if (currentImg) {
          this.transitionImage = currentImg.src;
          this.isTransitioning = true;
        }

        // 2. JUMP & DISSOLVE in next frame
        requestAnimationFrame(() => {
          this.selectedType = type;

          // Auto-select first available colour if current colour isn't available for this type
          if (!this.availableColorsForType.includes(this.selectedColor)) {
            this.selectedColor = this.availableColorsForType[0] || this.selectedColor;
          }

          // Auto-select first available size if current size isn't available for this type
          if (!this.availableSizesForType.includes(this.selectedSize)) {
            this.selectedSize = this.availableSizesForType[0] || this.selectedSize;
          }

          this.updateVariant();

          // Reset to first slide since visibleImages will now show filtered results
          this.currentSlide = 0;

          // 3. FADE OUT overlay
          setTimeout(() => {
            this.isTransitioning = false;
            setTimeout(() => {
              if (!this.isTransitioning) this.transitionImage = '';
            }, 600);
          }, 50);
        });
      },

      updateVariant() {
        const variant = this.variants.find(v => {
          const options = [v.option1, v.option2, v.option3].filter(Boolean);
          const selected = [this.selectedColor, this.selectedSize, this.selectedType].filter(Boolean);
          return selected.every(sel => options.includes(sel));
        });

        if (variant) {
          this.selectedVariantId = variant.id;
          window.history.replaceState({}, '', `${this.productUrl}?variant=${variant.id}`);
        }
      },

      // Helper: Find the gallery slide index for a variant's featured image
      _findSlideForVariant(variant) {
        if (!variant || !variant.featured_image) return -1;

        const targetId = variant.featured_image.id;
        const idx = this.visibleImages.findIndex(img => img.id === targetId);
        return idx;
      },

      checkPincode() {
        if (this.pincode.length !== 6 || isNaN(this.pincode)) {
          this.pincodeStatus = 'error';
          this.pincodeMessage = 'Please enter a valid 6-digit pincode';
          return;
        }

        // Simulate pincode check - In production, integrate with delivery API
        const serviceable = ['110001', '110002', '110003', '400001', '400002', '560001', '560002', '500001', '600001', '700001'];

        // For demo: Most pincodes are serviceable
        if (this.pincode.startsWith('1') || this.pincode.startsWith('4') || this.pincode.startsWith('5') || this.pincode.startsWith('6') || this.pincode.startsWith('7')) {
          this.pincodeStatus = 'available';
          this.pincodeMessage = '✓ Delivery available to ' + this.pincode;
        } else {
          this.pincodeStatus = 'unavailable';
          this.pincodeMessage = '✗ Sorry, delivery is not available to this pincode';
        }
      },

      async addToCart() {
        this.isAddingToCart = true;

        try {
          const items = this.buildCartItems();
          const response = await fetch(window.routes.cart_add_url + '.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (response.ok) {
            this.showToast('Added to FIT-KART!');
            this.updateCartCount();
          } else {
            const error = await response.json();
            this.showToast(error.description || 'Failed to add to cart');
          }
        } catch (error) {
          this.showToast('Failed to add to cart');
        }

        this.isAddingToCart = false;
      },

      async buyNow() {
        this.isAddingToCart = true;

        try {
          const items = this.buildCartItems();
          const response = await fetch(window.routes.cart_add_url + '.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (response.ok) {
            window.location.href = '/checkout';
          } else {
            const error = await response.json();
            this.showToast(error.description || 'Failed to proceed');
          }
        } catch (error) {
          this.showToast('Failed to proceed');
        }

        this.isAddingToCart = false;
      },

      shareProduct() {
        if (navigator.share) {
          navigator.share({
            title: this.productTitle,
            url: window.location.href
          });
        } else {
          // Fallback: Copy to clipboard
          navigator.clipboard.writeText(window.location.href);
          this.showToast('Link copied to clipboard!');
        }
      },

      addToWishlist() {
        // In production, integrate with wishlist functionality
        this.showToast('Added to wishlist!');
      },

      showToast(message) {
        this.toastMessage = message;
        this.toastVisible = true;
        setTimeout(() => {
          this.toastVisible = false;
        }, 3000);
      },

      async updateCartCount() {
        try {
          const response = await fetch('/cart.js');
          const cart = await response.json();
          const cartCount = document.querySelector('.cart-count');
          if (cartCount) {
            cartCount.textContent = cart.item_count;
          }
        } catch (e) {
          console.error('Failed to update cart count');
        }
      }
    }
  }
</script>
