    {%- if p.id != product.id -%}{%- assign related_count = related_count | plus: 1 -%}{%- endif -%}
  {%- endfor -%}

  {%- if related_count > 0 -%}
    <section class="pdp-strip">
      <div class="pdp-strip__inner">
