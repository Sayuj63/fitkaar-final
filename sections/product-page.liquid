      // Pincode
      pincode: '',
      pincodeStatus: '',
      pincodeMessage: '',
      pincodeLoading: false,

      // Toast
      toastVisible: false,
      toastMessage: '',

      // Carousel Methods
      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
      },

      prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
      },

      goToSlide(index) {
        this.currentSlide = index;
      },

      initSwipe() {
        const carousel = document.querySelector('.carousel-main');
        if (!carousel) return;

        carousel.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        carousel.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
        }, { passive: true });
      },

      handleSwipe() {
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }
      },

      /**
       * Availability uses real Shopify option positions (option1/2/3), not a fixed [color,size,type] order.
       * Also supports products with no Type option (selectedType empty).
       */
      get availableColorsForType() {
        {% if color_opt %}
        const colors = new Set();
        this.variants.forEach(v => {
          if (!v.available) return;
          {% if type_opt %}
          if (this.normOpt(v.option{{ type_opt.position }}) !== this.normOpt(this.selectedType)) return;
          {% endif %}
          {% if size_opt %}
          if (this.normOpt(v.option{{ size_opt.position }}) !== this.normOpt(this.selectedSize)) return;
          {% endif %}
          const c = v.option{{ color_opt.position }};
          if (c) colors.add(c);
        });
        return Array.from(colors);
        {% else %}
        return [];
        {% endif %}
      },

      isColorAvailable(color) {
        const n = this.normOpt(color);
        return this.availableColorsForType.some(c => this.normOpt(c) === n);
      },

      get availableSizesForType() {
        {% if size_opt %}
        const sizes = new Set();
        this.variants.forEach(v => {
          if (!v.available) return;
          {% if type_opt %}
          if (this.normOpt(v.option{{ type_opt.position }}) !== this.normOpt(this.selectedType)) return;
          {% endif %}
          {% if color_opt %}
          if (this.normOpt(v.option{{ color_opt.position }}) !== this.normOpt(this.selectedColor)) return;
          {% endif %}
          const sz = v.option{{ size_opt.position }};
          if (sz) sizes.add(sz);
        });
        return Array.from(sizes);
        {% else %}
        return [];
        {% endif %}
      },

      isSizeAvailable(size) {
        const n = this.normOpt(size);
        return this.availableSizesForType.some(s => this.normOpt(s) === n);
      },

      get availableSizesForType2() {
        {% if size_opt_2 %}
        const sizes = new Set();
        this.variants.forEach(v => {
          if (!v.available) return;
          {% if type_opt %}
          if (this.normOpt(v.option{{ type_opt.position }}) !== this.normOpt(this.selectedType)) return;
          {% endif %}
          {% if color_opt %}
          if (this.normOpt(v.option{{ color_opt.position }}) !== this.normOpt(this.selectedColor)) return;
          {% endif %}
          const sz = v.option{{ size_opt_2.position }};
          if (sz) sizes.add(sz);
        });
        return Array.from(sizes);
        {% else %}
        return [];
        {% endif %}
      },

      isSizeAvailable2(size) {
        const n = this.normOpt(size);
        return this.availableSizesForType2.some(s => this.normOpt(s) === n);
      },

      /** Trim / normalize option strings so "XL " === "XL" and clicks match Shopify JSON */
      normOpt(val) {
        if (val === undefined || val === null) return '';
        return String(val).trim();
      },

      /**
       * Gift-card denominations: Liquid buttons and Shopify variant JSON often differ slightly
       * (₹ vs Rs, thousand separators, unicode spaces). Compare by parsed amount when possible.
       */
      normDenomKey(val) {
        if (val === undefined || val === null) return '';
        const raw = String(val).trim();
        const digitsOnly = raw.replace(/[^\d.-]/g, '');
        if (digitsOnly.length > 0) {
          const n = parseFloat(digitsOnly);
          if (Number.isFinite(n)) return 'n:' + n;
        }
        return raw.toLowerCase().replace(/\s+/g, ' ').trim();
      },

      sizeMatchesSelected(val) {
        return this.normOpt(this.selectedSize) === this.normOpt(val);
      },

      sizeMatchesSelected2(val) {
        return this.normOpt(this.selectedSize2) === this.normOpt(val);
      },

      variantMatchesSelections(v) {
        {% if color_opt %}
        if (this.normOpt(v.option{{ color_opt.position }}) !== this.normOpt(this.selectedColor)) return false;
        {% endif %}
        {% if size_opt %}
        if (this.normOpt(v.option{{ size_opt.position }}) !== this.normOpt(this.selectedSize)) return false;
        {% endif %}
        {% if size_opt_2 %}
        if (this.normOpt(v.option{{ size_opt_2.position }}) !== this.normOpt(this.selectedSize2)) return false;
        {% endif %}
        {% if type_opt %}
        if (this.normOpt(v.option{{ type_opt.position }}) !== this.normOpt(this.selectedType)) return false;
        {% endif %}
        {% if generic_opt %}
        if (this.normDenomKey(v.option{{ generic_opt.position }}) !== this.normDenomKey(this.selectedGeneric)) return false;
        {% endif %}
        {% comment %} JS fallback if Liquid missed generic_opt: match any option by denomination key {% endcomment %}
        if (!this.hasGenericOpt && this.selectedGeneric) {
          const want = this.normDenomKey(this.selectedGeneric);
          const opts = [v.option1, v.option2, v.option3].map(o => this.normDenomKey(o));
          if (!opts.some(o => o === want)) return false;
        }
        return true;
      },

      // Current variant price getter
      get currentVariantPrice() {
        const variant = this.variants.find(v => v.id === this.selectedVariantId);
        return variant ? variant.price : {{ default_variant.price }};
      },

      get currentVariantComparePrice() {
        const variant = this.variants.find(v => v.id === this.selectedVariantId);
        return variant ? (variant.compare_at_price || variant.price) : ({{ default_variant.compare_at_price | default: default_variant.price }});
      },

      // Variant Methods
      selectColor(color) {
        if (this.selectedColor === color) return;

        // 1. FREEZE: Capture current visible image
        const currentImg = this.visibleImages[this.currentSlide];
        if (currentImg) {
          this.transitionImage = currentImg.src;
          this.isTransitioning = true;
        }

        // 2. JUMP & DISSOLVE in next frame
        requestAnimationFrame(() => {
          this.selectedColor = color;
          if (!this.availableSizesForType.some(s => this.normOpt(s) === this.normOpt(this.selectedSize))) {
            this.selectedSize = this.normOpt(this.availableSizesForType[0]) || this.selectedSize;
          }
          {% if size_opt_2 %}
          if (!this.availableSizesForType2.some(s => this.normOpt(s) === this.normOpt(this.selectedSize2))) {
            this.selectedSize2 = this.normOpt(this.availableSizesForType2[0]) || this.selectedSize2;
          }
          {% endif %}
          this.updateVariant();

          // Reset to first slide since visibleImages will now show filtered results
          this.currentSlide = 0;

          // 3. FADE OUT overlay
          setTimeout(() => {
            this.isTransitioning = false;
            setTimeout(() => {
              if (!this.isTransitioning) this.transitionImage = '';
            }, 600);
          }, 50);

          // #65: On mobile, scroll to top so user sees the new gallery image
          if (window.innerWidth <= 768) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      },

      selectSize(size) {
        this.selectedSize = this.normOpt(size);
        this.updateVariant();
      },

      selectSize2(size) {
        this.selectedSize2 = this.normOpt(size);
        this.updateVariant();
      },

      genericMatches(val) {
        return this.normDenomKey(this.selectedGeneric) === this.normDenomKey(val);
      },

      selectGeneric(val) {
        this.selectedGeneric = this.normOpt(val);
        this.updateVariant();
      },

      selectType(type) {
        if (this.selectedType === type) return;

        // 1. FREEZE: Capture current visible image
        const currentImg = this.visibleImages[this.currentSlide];
        if (currentImg) {
          this.transitionImage = currentImg.src;
          this.isTransitioning = true;
        }

        // 2. JUMP & DISSOLVE in next frame
        requestAnimationFrame(() => {
          this.selectedType = type;

          // Auto-select first available colour if current colour isn't available for this type
          if (!this.availableColorsForType.some(c => this.normOpt(c) === this.normOpt(this.selectedColor))) {
            this.selectedColor = this.normOpt(this.availableColorsForType[0]) || this.selectedColor;
          }

          // Auto-select first available size if current size isn't available for this type
          if (!this.availableSizesForType.some(s => this.normOpt(s) === this.normOpt(this.selectedSize))) {
            this.selectedSize = this.normOpt(this.availableSizesForType[0]) || this.selectedSize;
          }
          {% if size_opt_2 %}
          if (!this.availableSizesForType2.some(s => this.normOpt(s) === this.normOpt(this.selectedSize2))) {
            this.selectedSize2 = this.normOpt(this.availableSizesForType2[0]) || this.selectedSize2;
          }
          {% endif %}

          this.updateVariant();

          // Reset to first slide since visibleImages will now show filtered results
          this.currentSlide = 0;

          // 3. FADE OUT overlay
          setTimeout(() => {
            this.isTransitioning = false;
            setTimeout(() => {
              if (!this.isTransitioning) this.transitionImage = '';
            }, 600);
          }, 50);

          // #65: On mobile, scroll to top so user sees the new gallery image
          if (window.innerWidth <= 768) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      },

      updateVariant() {
        let variant = this.variants.find(v => this.variantMatchesSelections(v) && v.available)
          || this.variants.find(v => this.variantMatchesSelections(v));
        if (!variant && this.selectedGeneric) {
          const want = this.normDenomKey(this.selectedGeneric);
          variant = this.variants.find(v =>
            [v.option1, v.option2, v.option3].some(o => this.normDenomKey(o) === want)
          );
        }
        if (!variant) {
          variant = this.variants.find(v => v.available);
        }
        if (variant) {
          this.selectedVariantId = variant.id;
          {% if color_opt %}
          this.selectedColor = this.normOpt(variant.option{{ color_opt.position }});
          {% endif %}
          {% if size_opt %}
          this.selectedSize = this.normOpt(variant.option{{ size_opt.position }});
          {% endif %}
          {% if size_opt_2 %}
          this.selectedSize2 = this.normOpt(variant.option{{ size_opt_2.position }});
          {% endif %}
          {% if type_opt %}
          this.selectedType = this.normOpt(variant.option{{ type_opt.position }});
          {% endif %}
          {% if generic_opt %}
          this.selectedGeneric = this.normOpt(variant.option{{ generic_opt.position }});
          {% endif %}
          window.history.replaceState({}, '', `${this.productUrl}?variant=${variant.id}`);
        }
      },

      // Helper: Find the gallery slide index for a variant's featured image
      _findSlideForVariant(variant) {
        if (!variant || !variant.featured_image) return -1;

        const targetId = variant.featured_image.id;
        const idx = this.visibleImages.findIndex(img => img.id === targetId);
        return idx;
      },

      async checkPincode() {
        const pin = String(this.pincode).trim();
        if (!/^\d{6}$/.test(pin)) {
          this.pincodeStatus = 'error';
          this.pincodeMessage = 'Please enter a valid 6-digit pincode';
          return;
        }

        /* Load pincode data on first use */
        if (!window.FK_PC) {
          this.pincodeLoading = true;
          this.pincodeStatus = '';
          this.pincodeMessage = '';
          try {
            await new Promise(function(resolve, reject) {
              var s = document.createElement('script');
              s.src = {{ 'fk-pincodes.js' | asset_url | json }};
              s.onload  = resolve;
              s.onerror = reject;
              document.head.appendChild(s);
            });
          } catch(e) {
            this.pincodeLoading = false;
            this.pincodeStatus = 'error';
            this.pincodeMessage = 'Unable to check right now. Please try again.';
            return;
          }
          this.pincodeLoading = false;
        }

        if (window.FK_PC && window.FK_PC.hasOwnProperty(pin)) {
          const city = window.FK_PC[pin];
          const loc  = city ? ' to ' + city.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ') : '';
          this.pincodeStatus  = 'available';
          this.pincodeMessage = '✓ Delivery available' + loc;
        } else {
          this.pincodeStatus  = 'unavailable';
          this.pincodeMessage = '✗ Sorry, delivery is not available to this pincode yet';
        }
      },

      async addToCart() {
        this.isAddingToCart = true;

        try {
          const items = this.buildCartItems();
          const response = await fetch(window.routes.cart_add_url + '.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (response.ok) {
            this.showToast('Added to FIT-KART!');
            this.updateCartCount();
          } else {
            const error = await response.json();
            this.showToast(error.description || 'Failed to add to cart');
          }
        } catch (error) {
          this.showToast('Failed to add to cart');
        }

        this.isAddingToCart = false;
      },

      async buyNow() {
        this.isAddingToCart = true;

        try {
          const items = this.buildCartItems();
          const response = await fetch(window.routes.cart_add_url + '.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (response.ok) {
            window.location.href = '/checkout';
          } else {
            const error = await response.json();
            this.showToast(error.description || 'Failed to proceed');
          }
        } catch (error) {
          this.showToast('Failed to proceed');
        }

        this.isAddingToCart = false;
      },

      shareProduct() {
        if (navigator.share) {
          navigator.share({
            title: this.productTitle,
            url: window.location.href
          });
        } else {
          // Fallback: Copy to clipboard
          navigator.clipboard.writeText(window.location.href);
          this.showToast('Link copied to clipboard!');
        }
      },

      addToWishlist() {
        // Now handled by data-wishlist-heart in assets/wishlist.js — kept for back-compat.
      },

      showToast(message) {
        this.toastMessage = message;
        this.toastVisible = true;
        setTimeout(() => {
          this.toastVisible = false;
        }, 3000);
      },

      async updateCartCount() {
        try {
          const response = await fetch('/cart.js');
          const cart = await response.json();
          document.querySelectorAll('.cart-count').forEach(el => {
            el.textContent = cart.item_count;
            el.style.display = cart.item_count > 0 ? 'flex' : 'none';
          });
          if (window.fitkaarCart) {
            window.fitkaarCart.cart = cart;
          }
        } catch (e) {
          console.error('Failed to update cart count');
        }
      }
    }
  }
</script>
