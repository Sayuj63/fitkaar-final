<div class="rakhi-tie-wrap">
  <p class="rakhi-tie-label">this rakhi</p>
  <h2 class="rakhi-tie-heading">tie one for them</h2>

  <div class="rakhi-scene">
    <img src="{{ 'rakhi-wrist.png' | asset_url }}" alt="Wrist" class="rakhi-wrist-img">
    <img id="rakhiThreadImg" src="{{ 'rakhi-thread.png' | asset_url }}" alt="Rakhi" class="rakhi-thread-img">
  </div>

  <button id="rakhiTieBtn" class="rakhi-tie-btn">Tie the rakhi</button>
  <p id="rakhiMsg" class="rakhi-tie-msg">This Rakhi, gift something they'll actually wear.</p>
  <a id="rakhiCta" href="/collections/rakhi-gifting-special" class="rakhi-tie-cta">Shop the Rakhi edit</a>
</div>

<link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@500;600&family=Raleway:wght@400;500&display=swap" rel="stylesheet">

<style>
.rakhi-tie-wrap {
  text-align: center;
  padding: 1.5rem 1rem;
  background: #FAF6EE;
  max-width: 420px;
  margin: 0 auto;
}
.rakhi-tie-label {
  font-family: 'Raleway', sans-serif;
  font-size: 13px;
  letter-spacing: 0.5px;
  color: #5F5E5A;
  margin: 0 0 2px;
}
.rakhi-tie-heading {
  font-family: 'League Spartan', sans-serif;
  font-size: 22px;
  font-weight: 600;
  color: #0A1F44;
  margin: 0 0 1rem;
}
.rakhi-scene {
  position: relative;
  width: 100%;
  max-width: 320px;
  margin: 0 auto;
}
.rakhi-wrist-img {
  width: 100%;
  display: block;
}
.rakhi-thread-img {
  position: absolute;
  width: 34%;
  top: 42%;
  left: 40%;
  opacity: 0;
  transform: translate(50px, -60px) rotate(30deg) scale(0.5);
}
@keyframes rakhiTieMotion {
  0% { opacity: 0; transform: translate(50px, -60px) rotate(30deg) scale(0.5); }
  55% { opacity: 1; transform: translate(-8px, 6px) rotate(-55deg) scale(1.15); }
  100% { opacity: 1; transform: translate(0, 0) rotate(-32deg) scale(1); }
}
.rakhi-thread-img.tied {
  animation: rakhiTieMotion 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
.rakhi-tie-btn {
  margin-top: 1rem;
  padding: 8px 20px;
  background: #0A1F44;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-family: 'Raleway', sans-serif;
  font-size: 13px;
  cursor: pointer;
}
.rakhi-tie-msg {
  font-family: 'Raleway', sans-serif;
  opacity: 0;
  transition: opacity 0.5s ease 0.9s;
  font-size: 14px;
  color: #5F5E5A;
  margin-top: 0.75rem;
}
.rakhi-tie-msg.show { opacity: 1; }
.rakhi-tie-cta {
  display: inline-block;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.5s ease 1.1s, transform 0.5s ease 1.1s;
  margin-top: 0.75rem;
  font-family: 'Raleway', sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: #B8202E;
  text-decoration: underline;
}
.rakhi-tie-cta.show {
  opacity: 1;
  transform: translateY(0);
}
</style>

<script>
document.getElementById('rakhiTieBtn').addEventListener('click', function() {
  document.getElementById('rakhiThreadImg').classList.add('tied');
  document.getElementById('rakhiMsg').classList.add('show');
  document.getElementById('rakhiCta').classList.add('show');
  this.disabled = true;
});
</script>

{% schema %}
{
  "name": "Rakhi Tie Animation",
  "settings": [],
  "presets": [{ "name": "Rakhi Tie Animation" }]
}
{% endschema %}