<div class="rakhi-tie-wrap">
  <p class="rakhi-tie-label">this rakhi</p>
  <h2 class="rakhi-tie-heading">tie one for them</h2>

  <svg width="240" height="260" viewBox="0 0 240 260" class="rakhi-tie-svg">
    <path d="M90 40 C85 20 95 10 110 10 C125 10 130 25 128 45 L128 90 L92 90 Z" fill="none" stroke="#0A1F44" stroke-width="2"/>
    <ellipse cx="110" cy="150" rx="50" ry="65" fill="none" stroke="#0A1F44" stroke-width="2"/>
    <circle id="rakhiThread" cx="110" cy="140" r="46" fill="none" stroke="#B8202E" stroke-width="10" stroke-linecap="round" stroke-dasharray="289" stroke-dashoffset="289"/>
    <g id="rakhiBow" style="opacity:0;">
      <circle cx="90" cy="134" r="14" fill="#E7B10A"/>
      <circle cx="130" cy="134" r="14" fill="#E7B10A"/>
      <circle cx="110" cy="134" r="8" fill="#8A1C1C"/>
    </g>
  </svg>

  <button id="rakhiTieBtn" class="rakhi-tie-btn">Tie the rakhi</button>
  <p id="rakhiMsg" class="rakhi-tie-msg">This Rakhi, gift something they'll actually wear.</p>
</div>

<style>
.rakhi-tie-wrap {
  text-align: center;
  padding: 3rem 1rem;
  background: #FAF6EE;
}
.rakhi-tie-label {
  font-size: 13px;
  letter-spacing: 0.5px;
  color: #5F5E5A;
  margin: 0 0 4px;
}
.rakhi-tie-heading {
  font-size: 26px;
  font-weight: 500;
  color: #0A1F44;
  margin: 0 0 1.5rem;
}
.rakhi-tie-svg { margin: 0 auto; display: block; }
#rakhiThread { transition: stroke-dashoffset 1.6s ease; }
#rakhiBow { transition: opacity 0.4s ease 1.3s; }
.rakhi-tie-btn {
  margin-top: 1.5rem;
  padding: 10px 24px;
  background: #0A1F44;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 14px;
  cursor: pointer;
}
.rakhi-tie-msg {
  opacity: 0;
  transition: opacity 0.5s ease 1.6s;
  font-size: 15px;
  color: #5F5E5A;
  margin-top: 1rem;
}
</style>

<script>
document.getElementById('rakhiTieBtn').addEventListener('click', function() {
  document.getElementById('rakhiThread').style.strokeDashoffset = '0';
  document.getElementById('rakhiBow').style.opacity = '1';
  document.getElementById('rakhiMsg').style.opacity = '1';
  this.disabled = true;
});
</script>

{% schema %}
{
  "name": "Rakhi Tie Animation",
  "settings": [],
  "presets": [
    {
      "name": "Rakhi Tie Animation"
    }
  ]
}
{% endschema %}