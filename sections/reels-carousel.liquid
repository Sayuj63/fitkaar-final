{% schema %}
{
  "name": "Reels Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "AS SEEN ON REELS"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Upload reel video",
          "info": "Upload an mp4/mov directly from Shopify admin. Plays muted and loops on hover/tap."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail / poster image",
          "info": "Shown before the video plays. Used as the still thumbnail if no video is uploaded."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Reel link (optional)",
          "info": "If set, clicking opens this link (e.g. Instagram reel). Otherwise clicking plays the video inline."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reels Carousel",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}

<style>
.marquee-container {
  overflow: hidden;
  position: relative;
}

.marquee-content {
  display: flex;
  animation: marquee 30s linear infinite;
  width: max-content;
}

.marquee-content.is-paused {
  animation-play-state: paused;
}

@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Mobile: switch from marquee to swipeable strip */
@media (max-width: 768px) {
  .marquee-container {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .marquee-container::-webkit-scrollbar { display: none; }
  .marquee-content {
    /* Mobile: animation OFF so swipe works (#8). User can still re-enable in section CSS. */
    animation: none;
    gap: 12px;
    padding: 0 16px;
    width: max-content;
    display: flex;
  }
  .reel-item {
    flex: 0 0 75%;
    width: 75% !important;
    height: auto !important;
    aspect-ratio: 9 / 16;
    scroll-snap-align: center;
  }
}

.reel-item {
  position: relative;
}

.reel-item video,
.reel-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.reel-item video::-webkit-media-controls,
.reel-item video::-webkit-media-controls-panel,
.reel-item video::-webkit-media-controls-play-button,
.reel-item video::-webkit-media-controls-start-playback-button {
  display: none !important;
  -webkit-appearance: none !important;
  opacity: 0 !important;
}

.reel-item .reel-media {
  position: absolute;
  inset: 0;
}

.reels-section {
  padding: 20px 0 24px;
  background: #fff;
  overflow: hidden;
}
.reels-section .reels-heading {
  margin-bottom: 18px;
  text-align: center;
  font-family: var(--font-heading, 'League Spartan', sans-serif);
  color: var(--color-primary, #000c5b);
  font-weight: 900;
  letter-spacing: 2px;
  word-spacing: 5px;
  text-transform: uppercase;
  font-size: 42px;
  padding: 0 20px;
}
@media (max-width: 768px) {
  .reels-section { padding: 14px 0 18px; }
  .reels-section .reels-heading {
    margin-bottom: 14px;
    font-size: 32px;
    letter-spacing: 1px;
  }
}
@media (max-width: 480px) {
  .reels-section .reels-heading {
    font-size: 24px;
  }
}
</style>

<section class="reels-section">
  {% if section.settings.title != blank %}
    <h2 class="reels-heading">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="marquee-container w-full">
    <div class="marquee-content gap-4">
      <!-- We duplicate blocks 4 times to ensure seamless loop with 3 visible items -->
      {% for i in (1..4) %}
        {% for block in section.blocks %}
          {%- assign has_video = false -%}
          {%- if block.settings.video != blank -%}{%- assign has_video = true -%}{%- endif -%}
          {%- assign poster_url = '' -%}
          {%- if block.settings.image != blank -%}
            {%- assign poster_url = block.settings.image | image_url: width: 800 -%}
          {%- endif -%}

          {%- capture reel_inner -%}
            <div class="reel-media" {{ block.shopify_attributes }}>
              {%- if has_video -%}
                <video
                  muted
                  loop
                  playsinline
                  autoplay
                  preload="auto"
                  disablepictureinpicture
                  controlslist="nodownload nofullscreen noremoteplayback"
                  {% if poster_url != '' %}poster="{{ poster_url }}"{% endif %}
                  data-reel-video>
                  {%- for source in block.settings.video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif poster_url != '' -%}
                <img src="{{ poster_url }}" alt="Reel" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-full h-full object-cover opacity-50' }}
              {%- endif -%}
            </div>
          {%- endcapture -%}

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}"
               class="reel-item block relative overflow-hidden rounded-xl border border-gray-200 hover:shadow-lg transition-shadow"
               style="width: 280px; height: 498px; flex-shrink: 0;"
               data-reel>
              {{ reel_inner }}
            </a>
          {%- else -%}
            <div class="reel-item block relative overflow-hidden rounded-xl border border-gray-200 hover:shadow-lg transition-shadow"
                 style="width: 280px; height: 498px; flex-shrink: 0;"
                 data-reel>
              {{ reel_inner }}
            </div>
          {%- endif -%}
        {% endfor %}
      {% endfor %}

      <!-- Placeholder if empty -->
      {% if section.blocks.size == 0 %}
         {% for i in (1..6) %}
            <div class="reel-item block bg-gray-100 rounded-xl" style="width: 280px; height: 498px; flex-shrink: 0;"></div>
         {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<script>
(function() {
  var supportsIO = 'IntersectionObserver' in window;
  var observer = supportsIO ? new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      var v = entry.target.querySelector('[data-reel-video]');
      if (!v) return;
      if (entry.isIntersecting) {
        v.play().catch(function(){});
      } else {
        v.pause();
      }
    });
  }, { threshold: 0.25 }) : null;

  document.querySelectorAll('[data-reel]').forEach(function(card) {
    var v = card.querySelector('[data-reel-video]');
    if (!v) return;
    // Force-attempt autoplay on load (muted+playsinline allow it on iOS/Android)
    var tryPlay = function() { v.play().catch(function(){}); };
    if (v.readyState >= 2) tryPlay(); else v.addEventListener('loadeddata', tryPlay, { once: true });
    if (observer) observer.observe(card);
  });
})();
</script>
