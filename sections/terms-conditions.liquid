    max-width: 880px;
    margin: 0 auto;
    padding: 60px 24px 80px;
    color: #1f2937;
    font-family: var(--font-body, 'Helvetica Neue', sans-serif);
    line-height: 1.7;
  }
  .legal-page__hero { text-align: center; margin-bottom: 40px; }
  .legal-page h1 {
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--color-primary, #000c5b);
    text-transform: uppercase;
    margin: 0 0 10px;
    letter-spacing: 0.04em;
  }
  .legal-page__sub { color: #6b7280; font-size: 0.95rem; margin: 0; }
  .legal-page__body p { margin: 0 0 14px; font-size: 0.95rem; }
  .legal-page__body h2 {
    font-family: var(--font-heading, 'League Spartan', sans-serif);
    font-size: 1.2rem;
