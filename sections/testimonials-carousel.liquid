{% schema %}
{
  "name": "Testimonials Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "WHAT THEY'RE SAYING"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (seconds)",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Testimonial 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Testimonial 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Testimonial 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Testimonial 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Testimonial 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Testimonial 6"
    },
    {
      "type": "image_picker",
      "id": "image_7",
      "label": "Testimonial 7"
    },
    {
      "type": "image_picker",
      "id": "image_8",
      "label": "Testimonial 8"
    },
    {
      "type": "image_picker",
      "id": "image_9",
      "label": "Testimonial 9"
    },
    {
      "type": "image_picker",
      "id": "image_10",
      "label": "Testimonial 10"
    }
  ],
  "presets": [
    {
      "name": "Testimonials Carousel"
    }
  ]
}
{% endschema %}

<style>
.testimonials-carousel-section {
  background-color: transparent;
  padding: 16px 0 40px;
  overflow: hidden;
  position: relative;
  z-index: 10;
}

.testimonials-carousel-title {
  text-align: center;
  font-size: 42px;
  font-weight: 900;
  letter-spacing: 2px;
  word-spacing: 5px;
  margin-bottom: 10px;
  font-family: var(--font-heading, var(--font-primary));
  color: var(--color-primary, #000c5b);
  text-transform: uppercase;
  padding: 0 20px;
}

.testimonials-track-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 10px 0;
  will-change: transform;
}

.testimonials-track {
  display: flex;
  gap: 0;
  animation: scrollTestimonials {{ section.settings.speed }}s linear infinite;
  width: max-content;
  will-change: transform;
}

.testimonials-track:hover {
  animation-play-state: paused;
}

@keyframes scrollTestimonials {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

.testimonial-card {
  flex-shrink: 0;
  display: block;
  margin: 0;
  padding: 0;
  margin-right: -145px;
}

.testimonial-card img {
  height: 300px;
  width: auto;
  object-fit: contain;
  display: block;
  margin: 0;
  padding: 0;
  transition: transform 0.3s ease;
}

.testimonial-card:hover img {
  transform: scale(1.02);
  z-index: 10;
}

/* Responsive */
@media (max-width: 768px) {
  .testimonials-carousel-section {
    padding: 10px 0 28px;
  }

  .testimonials-carousel-title {
    font-size: 32px;
    margin-bottom: 18px;
    letter-spacing: 1px;
    font-weight: 900;
  }

  .testimonial-card {
    margin-right: -100px;
  }

  .testimonial-card img {
    height: 250px;
  }
}

@media (max-width: 480px) {
  .testimonial-card {
    margin-right: -80px;
  }

  .testimonials-carousel-title {
    font-size: 24px;
    font-weight: 900;
  }

  .testimonial-card img {
    height: 200px;
  }
}
</style>

<section class="testimonials-carousel-section">
